#!/usr/bin/env bash
# agent-hook-pre-edit — PreToolUse guard for Edit|Write.

set -u
_HOOK_SELF="${AGENTGUARD_HOOK_SELF:-$0}" # captured before sourcing so _hook_source_extensions finds agent/local variants
# shellcheck shell=bash
# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-hook-bootstrap; edit the template, not launcher copies.
# shellcheck shell=bash
_agentguard_script_parent() {
  case "$1" in
    */*) printf '%s\n' "${1%/*}" ;;
    *) printf '.\n' ;;
  esac
}

_agentguard_script_dir() {
  local path="$1" dir target
  while [[ -L "$path" ]]; do
    dir=$(cd -P -- "$(_agentguard_script_parent "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  cd -P -- "$(_agentguard_script_parent "$path")" && pwd
}
_HOOK_BIN_DIR=$(_agentguard_script_dir "${BASH_SOURCE[0]}") || {
  echo "${0##*/}: cannot resolve executable path" >&2
  exit 2
}
# shellcheck disable=SC1091 # Resolved relative to this symlink-aware launcher.
source "$_HOOK_BIN_DIR/../lib/agentguard/hook-helpers.sh"
# END GENERATED LAUNCHER BOOTSTRAP

_hook_parse_edit_files
[ -z "$AGENTGUARD_EDIT_FILES" ] && exit 0

_pre_edit_code_file() {
  local fp="$1" base
  base="$(basename "$fp")"
  case "$base" in
    AGENTS.md | CLAUDE.md | GEMINI.md | \
      Makefile | Dockerfile | Containerfile | Rakefile | Gemfile | Brewfile | justfile | Justfile)
      return 0
      ;;
  esac
  case "$fp" in
    */.config/agent-rules/*.md)
      return 0
      ;;
  esac
  # Keep this list as a cheap hook-side reminder trigger. Agent rule loading
  # owns the exact fragment set; the pre-edit hook only decides whether an edit
  # is likely to need the global/code/language policy reminder.
  case "$fp" in
    *.c | *.cc | *.cpp | *.cxx | *.h | *.hh | *.hpp | *.hxx | \
      *.m | *.mm | *.rs | *.go | *.zig | *.java | *.kt | *.kts | *.scala | \
      *.js | *.jsx | *.ts | *.tsx | *.mjs | *.cjs | *.vue | *.svelte | \
      *.py | *.rb | *.php | *.lua | *.vim | *.el | *.ex | *.exs | *.erl | *.hrl | \
      *.sh | *.bash | *.zsh | *.fish | *.ps1 | *.awk | *.pl | *.pm | \
      *.sql | *.tf | *.nix | *.yaml | *.yml | *.toml | *.jsonnet)
      return 0
      ;;
  esac
  return 1
}

_pre_edit_comment_reminder() {
  local fp reminder
  reminder="Code edit: apply AGENTS.md > Design Principles, Engineering Workflow, Code Style, and any loaded language-specific rule fragments before editing. Keep ownership clear, scope tight, and use small code/test/review/fix cycles. Add comments for why: invariants, tradeoffs, edge cases, and cross-system assumptions; avoid comments that restate obvious code."
  while IFS= read -r fp; do
    [ -n "$fp" ] || continue
    _pre_edit_code_file "$fp" || continue
    # This is deliberately a reminder, not a lint. The durable rule text lives
    # in the agent-agnostic AGENTS.md. Emit it once per window so it stays near
    # the first code edit without becoming repetitive hook noise during a
    # multi-file refactor, while still re-surfacing in a long turn.
    _hook_once_per_window "code-edit-reminder" \
      "${AGENTGUARD_PLAYBOOK_REMINDER_WINDOW:-25}" || return 0
    # _hook_remind handles both human-visible stderr and model-visible hook
    # context, so callers do not need to duplicate those channels.
    _hook_remind "$reminder"
    return 0
  done <<<"$AGENTGUARD_EDIT_FILES"
}

# ---------------------------------------------------------------------------
# On-demand playbook reminders
#
# Playbooks are owned by whatever tool manages the user's agent rules; this hook
# only consumes the machine index that tool generates. AgentGuard therefore
# holds NO list of languages, extensions, or project paths: a new playbook shows
# up here the moment its owner regenerates the index, and AgentGuard needs no
# release to learn about it. That split is deliberate — a guard shared across
# every repo on the machine must not carry one project's trigger table.
#
# Index grammar (tab-separated, `#` comment lines ignored). The first line must
# declare the version this hook speaks:
#   # agent-playbook-index-v1
#   <rule-id> <TAB> <path> <TAB> <trigger> <TAB> <severity> <TAB> <alternative>...
# Alternatives are OR-ed. Whitespace-separated terms inside one alternative are
# AND-ed. Unknown term types never match and an unrecognized version is skipped
# outright, so a newer index degrades to silence rather than to false reminders.
# ---------------------------------------------------------------------------

_playbook_index_path() {
  if [ -n "${AGENTGUARD_PLAYBOOK_INDEX:-}" ]; then
    printf '%s\n' "$AGENTGUARD_PLAYBOOK_INDEX"
    return 0
  fi
  printf '%s/dot/agent-playbook-index\n' "${XDG_DATA_HOME:-$HOME/.local/share}"
}

# Print the interpreter name from a file's shebang, with any version suffix
# stripped so `shebang:python` covers python3 and python3.12 alike.
#
# This is what makes extensionless scripts visible. Most hook, CLI, and
# git-hook files carry no extension at all, so an extension-only matcher would
# silently skip exactly the files most likely to need a style playbook.
_playbook_shebang_interpreter() {
  local fp="$1" first interp
  [ -f "$fp" ] || return 1
  [ -r "$fp" ] || return 1
  IFS= read -r first <"$fp" 2>/dev/null || return 1
  case "$first" in
    '#!'*) ;;
    *) return 1 ;;
  esac

  first="${first#\#!}"
  # `env` forwards to the real interpreter, optionally after its own switches.
  # shellcheck disable=SC2086 # splitting the shebang into words is the point.
  set -- $first
  while [ "$#" -gt 0 ]; do
    interp="${1##*/}"
    case "$interp" in
      env | -*) shift ;;
      *=*) shift ;;
      *) break ;;
    esac
  done
  [ -n "${interp:-}" ] || return 1

  # Trailing version digits and dots only; `sh` and `bash` keep their names.
  while :; do
    case "$interp" in
      *[0-9] | *.) interp="${interp%?}" ;;
      *) break ;;
    esac
  done
  [ -n "$interp" ] || return 1
  printf '%s\n' "$interp"
}

# True when the file belongs to the given repo, addressed as <git-dir>|<work-tree>.
#
# Repo membership, not path shape, is what identifies a managed file: a bare
# dotfiles repo checked out over $HOME tracks ~/.zshrc, whose path says nothing
# about dotfiles. An untracked file still matches when its directory already
# holds tracked files, so creating a new file in a managed tree is covered too.
_playbook_git_tracked() {
  local spec="$1" fp="$2" git_dir work_tree dir
  git_dir="${spec%%|*}"
  work_tree="${spec#*|}"
  [ -n "$git_dir" ] && [ -n "$work_tree" ] || return 1
  [ "$git_dir" != "$spec" ] || return 1
  # The index may carry `~/`-relative repo paths; expand them here rather than
  # requiring the generator to bake in one machine's absolute home.
  case "$git_dir" in
    \~/*) git_dir="$HOME/${git_dir#\~/}" ;;
  esac
  case "$work_tree" in
    \~/*) work_tree="$HOME/${work_tree#\~/}" ;;
  esac
  [ -d "$git_dir" ] || return 1

  git --git-dir="$git_dir" --work-tree="$work_tree" \
    ls-files --error-unmatch -- "$fp" >/dev/null 2>&1 && return 0

  dir="${fp%/*}"
  [ "$dir" != "$fp" ] || return 1
  [ -n "$(git --git-dir="$git_dir" --work-tree="$work_tree" \
    ls-files -- "$dir" 2>/dev/null | head -n 1)" ]
}

# Resolve one git rev-parse directory answer to a canonical absolute path.
#
# rev-parse mixes relative and absolute answers depending on where it runs:
# from a repo's top level both --git-dir and --git-common-dir print `.git`, but
# from a subdirectory --git-dir prints an absolute path while --git-common-dir
# prints `../.git`. Comparing the raw strings therefore reports "linked
# worktree" for every file below the repo root. Canonicalize before comparing.
_playbook_git_abs_dir() {
  local dir="$1" query="$2" answer
  answer=$(git -C "$dir" rev-parse "$query" 2>/dev/null) || return 1
  [ -n "$answer" ] || return 1
  (cd "$dir" && cd "$answer" && pwd -P) 2>/dev/null
}

# True when the file sits in a repo's primary checkout rather than a linked
# worktree. git-dir and git-common-dir diverge inside a linked worktree, which
# is the same comparison the worktree playbook itself teaches.
_playbook_repo_primary_checkout() {
  local fp="$1" dir git_dir common_dir
  dir="${fp%/*}"
  [ "$dir" != "$fp" ] || return 1
  # Only probe an existing parent directory. Falling back to $PWD would make the
  # answer depend on the caller's cwd instead of the file being edited.
  [ -d "$dir" ] || return 1
  git_dir=$(_playbook_git_abs_dir "$dir" --git-dir) || return 1
  common_dir=$(_playbook_git_abs_dir "$dir" --git-common-dir) || return 1
  [ -n "$git_dir" ] && [ "$git_dir" = "$common_dir" ]
}

_playbook_term_matches() {
  local term="$1" fp="$2" interp
  case "$term" in
    glob:*)
      # shellcheck disable=SC2254 # the index supplies the pattern deliberately.
      case "$fp" in
        ${term#glob:}) return 0 ;;
        *) return 1 ;;
      esac
      ;;
    shebang:*)
      interp=$(_playbook_shebang_interpreter "$fp") || return 1
      [ "$interp" = "${term#shebang:}" ]
      ;;
    git-tracked:*) _playbook_git_tracked "${term#git-tracked:}" "$fp" ;;
    repo-primary-checkout) _playbook_repo_primary_checkout "$fp" ;;
    *) return 1 ;;
  esac
}

_playbook_alternative_matches() {
  local alternative="$1" fp="$2" term rc=0 glob_state
  [ -n "$alternative" ] || return 1

  # Splitting the alternative into terms must not also glob them: a term like
  # `glob:*.py` would otherwise be pathname-expanded against the cwd.
  case "$-" in
    *f*) glob_state=off ;;
    *) glob_state=on ;;
  esac
  set -f
  # shellcheck disable=SC2086 # splitting into terms is the point; globbing is off.
  set -- $alternative
  [ "$glob_state" = "on" ] && set +f

  # Cheapest terms first. glob and shebang are a string test and one file read;
  # the repo terms fork git. Ordering by cost lets a non-matching alternative
  # bail before paying for a subprocess, which matters because this runs on
  # every edit.
  for term in "$@"; do
    case "$term" in
      glob:*) _playbook_term_matches "$term" "$fp" || return 1 ;;
    esac
  done
  for term in "$@"; do
    case "$term" in
      shebang:*) _playbook_term_matches "$term" "$fp" || return 1 ;;
    esac
  done
  for term in "$@"; do
    case "$term" in
      glob:* | shebang:*) ;;
      *) _playbook_term_matches "$term" "$fp" || rc=1 ;;
    esac
    [ "$rc" -eq 0 ] || return 1
  done
  return 0
}

# Emit one reminder per matching playbook, at the severity the index declares.
#
# The message is built entirely from index data — trigger, rule id, path — so
# the reminder text stays owned by the playbook rather than duplicated here.
# Including the resolved path matters: hooks name playbooks by rule id, and an
# agent that has to search for the file is an agent that skips reading it.
_pre_edit_playbook_reminder() {
  local index fp rule_id path trigger severity alternatives matched line header

  index="$(_playbook_index_path)"
  [ -f "$index" ] || return 0

  # Unknown terms already degrade to silence, but a future grammar could also
  # reorder columns, and misreading those as rule ids and paths would produce
  # confident nonsense. Refuse an index whose declared version we do not speak.
  IFS= read -r header <"$index" 2>/dev/null || return 0
  case "$header" in
    '# agent-playbook-index-v1') ;;
    *) return 0 ;;
  esac

  while IFS= read -r fp; do
    [ -n "$fp" ] || continue
    while IFS=$'\t' read -r rule_id path trigger severity alternatives; do
      case "$rule_id" in
        '' | '#'*) continue ;;
      esac
      [ -n "$alternatives" ] || continue

      matched=1
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        if _playbook_alternative_matches "$line" "$fp"; then
          matched=0
          break
        fi
      done <<<"$(printf '%s' "$alternatives" | tr '\t' '\n')"
      [ "$matched" -eq 0 ] || continue

      # Keyed per rule-id so distinct playbooks each get their own reminder even
      # when one multi-file apply_patch touches several at once, and re-armed on
      # a window so a long turn does not lose the reminder after a single fire.
      _hook_once_per_window "playbook-reminder-$rule_id" \
        "${AGENTGUARD_PLAYBOOK_REMINDER_WINDOW:-25}" || continue

      if [ "$severity" = "warn" ]; then
        _hook_warn "$trigger: apply agent-rule-id: $rule_id before continuing — $path"
      else
        _hook_remind "$trigger: apply agent-rule-id: $rule_id before this edit — $path"
      fi
    done <"$index"
  done <<<"$AGENTGUARD_EDIT_FILES"
}

# Edit churn guard
if ! _hook_flag_enabled "${AGENTGUARD_EDIT_CHURN_BYPASS:-}"; then
  while IFS= read -r _fp; do
    [ -n "$_fp" ] || continue
    _churn_file=$(_hook_edit_churn_file "$_fp")
    if [ -f "$_churn_file" ]; then
      _count=$(_hook_counter_read "$_churn_file")
      if [ "${_count:-0}" -ge "${AGENTGUARD_EDIT_CHURN_BLOCK:-10}" ]; then
        _hook_block "'$(basename "$_fp")' has been edited $_count times this session. Step back and rethink the approach, or set AGENTGUARD_EDIT_CHURN_BYPASS=1 for a deliberate edit pass."
      elif [ "${_count:-0}" -ge "${AGENTGUARD_EDIT_CHURN_WARN:-5}" ]; then
        _hook_warn "'$(basename "$_fp")' has been edited $_count times this session. Consider whether you're making progress; set AGENTGUARD_EDIT_CHURN_BYPASS=1 for a deliberate edit pass."
      fi
    fi
  done <<<"$AGENTGUARD_EDIT_FILES"
fi

# Block edits to secrets files — credentials, keys, and env files must not be
# modified by an agent without explicit human review.
_secrets_file_pattern() {
  local fp="$1" base
  base="$(basename "$fp")"
  # Match on filename alone
  case "$base" in
    .env | .env.* | *.env | \
      id_rsa | id_dsa | id_ecdsa | id_ed25519 | \
      id_rsa.pub | id_dsa.pub | id_ecdsa.pub | id_ed25519.pub | \
      *.pem | *.p12 | *.pfx | *.p8 | *.key | *.keystore | *.jks | \
      credentials | credentials.json | credentials.yaml | credentials.yml | \
      secrets | secrets.json | secrets.yaml | secrets.yml | secrets.toml | \
      .netrc | .pgpass | .npmrc | .pypirc)
      return 0
      ;;
  esac
  # Match on path suffix for directory-qualified names
  case "$fp" in
    */.aws/credentials | */.ssh/config | */.ssh/id_* | */.ssh/authorized_keys | */.ssh/known_hosts)
      return 0
      ;;
  esac
  return 1
}

while IFS= read -r _fp; do
  [ -n "$_fp" ] || continue
  if _secrets_file_pattern "$_fp"; then
    _hook_block "Editing '$_fp' is not allowed — secrets and credential files must be modified manually."
  fi
done <<<"$AGENTGUARD_EDIT_FILES"

_hook_source_extensions
# Broad guidance should reinforce allowed code edits, not consume the
# once-per-prompt marker on an edit that another guard already blocked.
if [ -z "$_HOOK_BLOCKED" ]; then
  # Ticked once per allowed edit, before any windowed check, so every reminder
  # ages against the same clock and a blocked edit does not advance it.
  _hook_activity_tick
  _pre_edit_comment_reminder
  _pre_edit_playbook_reminder
fi
_hook_finish

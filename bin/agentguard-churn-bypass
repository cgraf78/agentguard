#!/usr/bin/env bash
# agentguard-churn-bypass — opt the current agent session out of (or back
# into) the edit-churn guard for a deliberate multi-edit pass.
#
# The churn guard counts per-file edits in the session state dir. Hook
# processes inherit their environment from the agent process, so an `export
# AGENTGUARD_EDIT_CHURN_BYPASS=1` in a tool shell never reaches them. This
# command writes (or removes) a bypass marker file in the session state dir
# instead — a channel the agent can actually use mid-session. The marker is
# session-scoped and opt-in; the guard's default behavior is unchanged.
#
# Usage: agentguard-churn-bypass on [reason...] | off | status
#
# This launcher is not a hook, but it sources the hook runtime for session
# resolution, so it carries the generated `hook` bootstrap (resolver plus
# hook-helpers source) via support/sync-hook-bootstrap.

set -u

# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-hook-bootstrap; edit the template, not launcher copies.
# shellcheck shell=bash
_agentguard_script_parent() {
  case "$1" in
    */*) printf '%s\n' "${1%/*}" ;;
    *) printf '.\n' ;;
  esac
}

_agentguard_script_dir() {
  local path="$1" dir target
  while [[ -L "$path" ]]; do
    dir=$(cd -P -- "$(_agentguard_script_parent "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  cd -P -- "$(_agentguard_script_parent "$path")" && pwd
}
_HOOK_BIN_DIR=$(_agentguard_script_dir "${BASH_SOURCE[0]}") || {
  echo "${0##*/}: cannot resolve executable path" >&2
  exit 2
}
# shellcheck disable=SC1091 # Resolved relative to this symlink-aware launcher.
source "$_HOOK_BIN_DIR/../lib/agentguard/hook-helpers.sh"
# END GENERATED LAUNCHER BOOTSTRAP

_churn_bypass_usage() {
  cat <<'EOF'
Usage: agentguard-churn-bypass <on [reason...] | off | status>

Manage the edit-churn guard bypass for the current agent session.

  on [reason...]   Bypass the churn warn/block for this session. Writes a
                   marker file to each state-root tier holding this session
                   (hooks read one root tier, and a tool shell cannot know
                   which). Only this session is affected, even when other
                   sessions have state on this host. When no session state
                   exists yet, plants the marker under every plausible state
                   root so the first hook to run finds it.
  off              Remove this session's bypass marker (all roots).
  status           Show whether the bypass is active and current churn totals.
                   Exits 0 when bypassed, 1 when not.

The bypass is session-scoped and deliberate: it only exists after an
explicit `on`, and a new session starts un-bypassed (every SessionStart
removes any marker left from a reused session key). Session ids
containing `/` or `..` are rejected.
EOF
}

# Highest per-file edit count and tracked-file total for a session dir.
# Counters are keyed by path checksum, so only magnitudes are reported.
_churn_bypass_summary() {
  local dir="$1" file count max=0 tracked=0
  if [ -d "$dir/edit-churn" ]; then
    for file in "$dir/edit-churn"/*; do
      [ -f "$file" ] || continue
      tracked=$((tracked + 1))
      count=$(_hook_counter_read "$file")
      if [ "$count" -gt "$max" ]; then
        max="$count"
      fi
    done
  fi
  printf '%s tracked files, highest per-file count %s\n' "$tracked" "$max"
}

# <root>/<primary-key>/edit-churn-bypass paths across tiers. Single-key: only
# the primary session is ever managed. The key is re-checked here even though
# the resolver already filters, so a future resolver change cannot turn this
# rm/write path into a traversal.
_churn_bypass_marker_paths() {
  local key root
  key=$(_hook_agent_shell_primary_key 2>/dev/null) || return 0
  _hook_session_key_safe "$key" || return 0
  while IFS= read -r root; do
    [ -n "$root" ] || continue
    printf '%s/%s/edit-churn-bypass\n' "$root" "$key"
  done < <(_hook_state_roots)
}

# True when identity env carries a value the key filter rejected, so the
# caller can tell "no identity" apart from "identity refused".
_churn_bypass_has_unsafe_identity() {
  local id
  for id in \
    "${AGENTGUARD_SESSION_ID:-}" \
    "${MUSE_SESSION_ID:-}" \
    "${CODEX_THREAD_ID:-}" \
    "${GROK_SESSION_ID:-}" \
    "${CLAUDE_CODE_CURRENT_SESSION_ID:-}" \
    "${CLAUDE_CODE_SESSION_ID:-}"; do
    [ -n "$id" ] || continue
    _hook_session_key_safe "$id" || return 0
  done
  return 1
}

_churn_bypass_on() {
  local reason="$*" dir='' key='' root target targets='' written=0 stamp primary=''
  targets=$(_hook_agent_shell_state_dirs 2>/dev/null) || targets=''
  if [ -z "$targets" ]; then
    key=$(_hook_agent_shell_primary_key 2>/dev/null) || key=''
    _hook_session_key_safe "$key" || key=''
    if [ -z "$key" ]; then
      if _churn_bypass_has_unsafe_identity; then
        echo "agentguard-churn-bypass: ignoring unsafe session identity (a session id must not contain / or ..); cannot place the bypass marker." >&2
      else
        echo "agentguard-churn-bypass: no agent session identity found (no runtime id in env, no agent parent process); cannot place the bypass marker." >&2
      fi
      return 1
    fi
    while IFS= read -r root; do
      [ -n "$root" ] || continue
      if [ -n "$targets" ]; then
        targets="$targets
$root/$key"
      else
        targets="$root/$key"
      fi
    done < <(_hook_state_roots)
  fi
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown-time)"
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    # Final layer: never mkdir outside the state tree, no matter what a
    # resolver returned.
    _hook_session_key_safe "${target##*/}" || continue
    _hook_mkstate "$target" || continue
    printf 'bypassed-at=%s pid=%s reason=%s\n' \
      "$stamp" "$$" "$reason" >"$target/edit-churn-bypass" 2>/dev/null || continue
    written=$((written + 1))
    dir="$target"
  done <<<"$targets"
  if [ "$written" -eq 0 ]; then
    echo "agentguard-churn-bypass: could not write the bypass marker." >&2
    return 1
  fi
  if [ -n "$key" ]; then
    printf 'no session state yet; bypass armed for session key %s (marker in %s state %s).\n' \
      "$key" "$written" "$([ "$written" -eq 1 ] && echo root || echo roots)"
    return 0
  fi
  # The marker lands in every live tier of this one session: hooks read
  # exactly one root tier, and a tool shell cannot know which (hook env often
  # has XDG_* scrubbed while the shell does not). Report the primary view.
  primary=$(_hook_agent_shell_state_dir 2>/dev/null) || primary="$dir"
  if [ "$written" -gt 1 ]; then
    printf 'churn bypass on for this session (%s; marker in %s state dirs).\n' \
      "$(_churn_bypass_summary "$primary")" "$written"
  else
    printf 'churn bypass on for this session (%s).\n' \
      "$(_churn_bypass_summary "$primary")"
  fi
  return 0
}

_churn_bypass_off() {
  local marker removed=0
  while IFS= read -r marker; do
    [ -n "$marker" ] || continue
    if [ -f "$marker" ]; then
      rm -f "$marker" 2>/dev/null || continue
      removed=$((removed + 1))
    fi
  done < <(_churn_bypass_marker_paths)
  if [ "$removed" -gt 0 ]; then
    printf 'churn bypass off (removed %s marker file(s)).\n' "$removed"
  else
    printf 'churn bypass already off for this session.\n'
  fi
  return 0
}

_churn_bypass_status() {
  local active=0 marker found='' dir
  if _hook_flag_enabled "${AGENTGUARD_EDIT_CHURN_BYPASS:-}"; then
    printf 'env: AGENTGUARD_EDIT_CHURN_BYPASS=%s (effective only in hook/launcher env, not tool shells)\n' \
      "$AGENTGUARD_EDIT_CHURN_BYPASS"
  fi
  while IFS= read -r marker; do
    [ -n "$marker" ] || continue
    if [ -f "$marker" ]; then
      active=1
      found="$found
  $marker"
    fi
  done < <(_churn_bypass_marker_paths)
  if [ "$active" -eq 1 ]; then
    printf 'marker: bypass on for this session%s\n' "$found"
  else
    printf 'marker: no bypass for this session\n'
  fi
  if dir=$(_hook_agent_shell_state_dir 2>/dev/null); then
    printf 'churn: %s in %s\n' "$(_churn_bypass_summary "$dir")" "$dir"
  else
    printf 'churn: no session state yet\n'
  fi
  [ "$active" -eq 1 ]
}

_churn_bypass_main() {
  local cmd="${1:-}"
  case "$cmd" in
    on)
      shift
      _churn_bypass_on "$@"
      ;;
    off)
      _churn_bypass_off
      ;;
    status)
      _churn_bypass_status
      ;;
    -h | --help | help)
      _churn_bypass_usage
      ;;
    '')
      _churn_bypass_usage >&2
      return 2
      ;;
    *)
      printf 'agentguard-churn-bypass: unknown subcommand %s\n' "$cmd" >&2
      _churn_bypass_usage >&2
      return 2
      ;;
  esac
}

_churn_bypass_main "$@"

#!/usr/bin/env bash
# agent-hook-stop — Stop hook.
# Runs after every response: surface any pending Hive Memory reminder, run
# extensions, then, once the foreground turn really ends, ring for the first
# such Stop after a valid prompt (not repeated or re-entrant callbacks) and
# clear the agent's busy pane mark.

set -u
_HOOK_SELF="${AGENTGUARD_HOOK_SELF:-$0}" # captured before sourcing so _hook_source_extensions finds agent/local variants
# shellcheck shell=bash
# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-hook-bootstrap; edit the template, not launcher copies.
# shellcheck shell=bash
# Store the directory part of path $1 in the variable named by $2, as the
# `$(...)` capture this replaced held it (trailing newlines stripped). Every
# hook resolves its own path at startup, so the capture's fork was paid on
# every call.
_agentguard_script_parent() {
  case "$1" in
    */*) printf -v "$2" '%s' "${1%/*}" ;;
    *) printf -v "$2" '.' ;;
  esac
  while [[ "${!2}" == *$'\n' ]]; do
    printf -v "$2" '%s' "${!2%$'\n'}"
  done
}

_agentguard_script_dir() {
  local path="$1" dir target parent
  while [[ -L "$path" ]]; do
    _agentguard_script_parent "$path" parent
    dir=$(cd -P -- "$parent" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  _agentguard_script_parent "$path" parent
  cd -P -- "$parent" && pwd
}
_HOOK_BIN_DIR=$(_agentguard_script_dir "${BASH_SOURCE[0]}") || {
  echo "${0##*/}: cannot resolve executable path" >&2
  exit 2
}
# shellcheck disable=SC1091 # Resolved relative to this symlink-aware launcher.
source "$_HOOK_BIN_DIR/../lib/agentguard/hook-helpers.sh" || {
  echo "${0##*/}: cannot load AgentGuard hook helpers" >&2
  exit 2
}
# END GENERATED LAUNCHER BOOTSTRAP

# Extensions read the payload and the state dir it selects.
_hook_hm_read_input
# From here on, any exit settles the turn (see _hook_stop_arm).
_hook_stop_arm
_hook_hm_stop
_hook_source_extensions
# Ring and clear only after extensions, which can still block the Stop and keep
# the turn going. A Stop that continues stays silent and leaves a mark, so the
# Stop that really ends the turn rings although the host flags it as a
# continuation.
if _hook_stop_continues; then
  _hook_stop_settle 1
else
  _hook_stop_settle 0
fi
_hook_finish

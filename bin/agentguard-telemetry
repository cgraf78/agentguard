#!/usr/bin/env bash
# agentguard-telemetry — find, read, and prune AgentGuard audit records.
#
# Hooks write one JSON record per invocation under
# <root>/sessions/<agent>/<session-key>/ (see lib/agentguard/telemetry.sh and
# docs/telemetry.md). This command is the read side: it lists sessions,
# renders a session timeline, prints raw JSONL for jq, and applies retention.
#
# It is not a hook and needs no session resolution, so it uses the resolver-only
# `classifier` bootstrap and sources just the telemetry library.

set -u

# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-hook-bootstrap; edit the template, not launcher copies.
# shellcheck shell=bash
_agentguard_script_parent() {
  case "$1" in
    */*) printf '%s\n' "${1%/*}" ;;
    *) printf '.\n' ;;
  esac
}

_agentguard_script_dir() {
  local path="$1" dir target
  while [[ -L "$path" ]]; do
    dir=$(cd -P -- "$(_agentguard_script_parent "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  cd -P -- "$(_agentguard_script_parent "$path")" && pwd
}
# END GENERATED LAUNCHER BOOTSTRAP
_TELEMETRY_BIN_DIR=$(_agentguard_script_dir "${BASH_SOURCE[0]}") || {
  echo "${0##*/}: cannot resolve executable path" >&2
  exit 2
}
# shellcheck source=../lib/agentguard/telemetry.sh
# shellcheck disable=SC1091 # Resolved relative to this symlink-aware launcher.
source "$_TELEMETRY_BIN_DIR/../lib/agentguard/telemetry.sh"

_telemetry_usage() {
  cat <<'EOF'
Usage: agentguard-telemetry <command> [options]

Find and read AgentGuard's per-session audit records.

Commands:
  dir                     Print the telemetry root hooks write to.
  sessions [options]      List sessions, most recent activity first.
      --agent NAME        Only sessions from this agent (claude, codex, ...).
      -n, --limit N       Show at most N sessions (default 20, 0 = all).
      --json              One JSON object per session instead of a table.
  show [SESSION] [--json] Show a session's timeline. With --json, print the
                          raw records as JSONL (one record per line) for jq.
  path [SESSION]          Print a session's record directory.
  prune [--days N]        Delete sessions idle for more than N days
                          (default: AGENTGUARD_TELEMETRY_RETENTION_DAYS or 90).

SESSION may be:
  (omitted) | latest      the most recently active session
  current                 the session of the agent running this command
  AGENT/KEY | KEY         an exact session key (e.g. a Claude session UUID)
  PREFIX                  a unique prefix of a session key
  /path/to/session/dir    a session directory

Records are plain files, so `rg PATTERN "$(agentguard-telemetry dir)"`
searches every session.
EOF
}

_telemetry_die() {
  printf 'agentguard-telemetry: %s\n' "$1" >&2
  exit "${2:-1}"
}

# Session directories across every root, one per line, as
# "<last-activity-us>\t<agent>\t<key>\t<dir>", newest first. Last activity is
# taken from the newest record's filename, so listing reads no file contents.
_telemetry_session_rows() {
  local root dir agent key last
  local -a records
  while IFS= read -r root; do
    [ -d "$root/sessions" ] || continue
    for dir in "$root"/sessions/*/*/; do
      [ -d "$dir" ] || continue
      dir="${dir%/}"
      key="${dir##*/}"
      agent="${dir%/*}"
      agent="${agent##*/}"
      records=("$dir"/*.json)
      [ -e "${records[0]}" ] || continue
      last="${records[${#records[@]} - 1]##*/}"
      printf '%s\t%s\t%s\t%s\n' "${last%%-*}" "$agent" "$key" "$dir"
    done
  done < <(_agentguard_telemetry_roots)
}

# Fixed-width microsecond stamps sort correctly as text.
_telemetry_sorted_rows() {
  _telemetry_session_rows | sort -r
}

# Session keys the calling agent shell can see, in the same precedence the
# hooks use. Only identifiers are needed here, not process probing: a tool
# shell launched by an agent inherits the runtime's session variables.
_telemetry_current_keys() {
  local id
  for id in \
    "${AGENTGUARD_SESSION_ID:-}" \
    "${CODEX_THREAD_ID:-}" \
    "${GROK_SESSION_ID:-}" \
    "${MUSE_SESSION_ID:-}" \
    "${CLAUDE_CODE_CURRENT_SESSION_ID:-}" \
    "${CLAUDE_CODE_SESSION_ID:-}"; do
    [ -n "$id" ] && printf '%s\n' "$id"
  done
}

# Resolve a SESSION argument to exactly one record directory.
_telemetry_resolve() {
  local want="${1:-latest}" rows matches count key
  if [ -d "$want" ] && [[ "$want" == */* ]]; then
    printf '%s\n' "${want%/}"
    return 0
  fi
  rows=$(_telemetry_sorted_rows)
  [ -n "$rows" ] || _telemetry_die "no telemetry sessions found under: $(_agentguard_telemetry_roots | paste -sd ' ' -)"
  case "$want" in
    latest)
      printf '%s\n' "$rows" | head -n 1 | cut -f4
      return 0
      ;;
    current)
      while IFS= read -r key; do
        matches=$(printf '%s\n' "$rows" | awk -F '\t' -v k="$key" '$3 == k { print $4 }' | head -n 1)
        if [ -n "$matches" ]; then
          printf '%s\n' "$matches"
          return 0
        fi
      done < <(_telemetry_current_keys)
      _telemetry_die "no telemetry for the current agent session (no runtime session id in the environment, or no records yet)"
      ;;
  esac
  # Exact AGENT/KEY, then exact KEY, then unique KEY prefix.
  matches=$(printf '%s\n' "$rows" | awk -F '\t' -v w="$want" '
    ($2 "/" $3) == w || $3 == w { print $4 }')
  if [ -z "$matches" ]; then
    matches=$(printf '%s\n' "$rows" | awk -F '\t' -v w="$want" '
      index($3, w) == 1 { print $4 }')
  fi
  count=$(printf '%s' "$matches" | grep -c '^' || true)
  case "$count" in
    0) _telemetry_die "no session matches '$want' (try: agentguard-telemetry sessions)" ;;
    1) printf '%s\n' "$matches" ;;
    *) _telemetry_die "'$want' matches $count sessions; use a longer prefix or AGENT/KEY" ;;
  esac
}

_telemetry_cmd_dir() {
  [ $# -eq 0 ] || _telemetry_die "dir takes no arguments" 2
  _agentguard_telemetry_root || _telemetry_die "cannot resolve a telemetry root (HOME is unset)"
}

_telemetry_cmd_sessions() {
  local agent_filter='' limit=20 json=false rows
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent)
        [ $# -ge 2 ] || _telemetry_die "--agent needs a value" 2
        agent_filter="$2"
        shift 2
        ;;
      -n | --limit)
        [ $# -ge 2 ] || _telemetry_die "$1 needs a value" 2
        case "$2" in '' | *[!0-9]*) _telemetry_die "--limit must be a number" 2 ;; esac
        limit="$2"
        shift 2
        ;;
      --json)
        json=true
        shift
        ;;
      *) _telemetry_die "unknown sessions option: $1" 2 ;;
    esac
  done
  rows=$(_telemetry_sorted_rows)
  if [ -n "$agent_filter" ]; then
    rows=$(printf '%s\n' "$rows" | awk -F '\t' -v a="$agent_filter" '$2 == a')
  fi
  [ -n "$rows" ] || return 0
  [ "$limit" -eq 0 ] || rows=$(printf '%s\n' "$rows" | head -n "$limit")

  # One jq per session reads only its first record (start time and cwd) and
  # the first prompt-bearing record, so listing stays cheap even for sessions
  # with thousands of large tool records.
  local last agent key dir first prompt_file summary
  local -a records
  $json || printf '%-26s %-7s %-38s %6s  %-24s %s\n' LAST_ACTIVITY AGENT SESSION RECORDS CWD FIRST_PROMPT
  while IFS=$'\t' read -r last agent key dir; do
    records=("$dir"/*.json)
    first="${records[0]}"
    # Match the prompt event by its top-level field rather than any nested
    # "prompt" key. Paths stream through xargs: a long session can exceed the
    # platform's argument-length limit.
    prompt_file=$(printf '%s\0' "${records[@]}" |
      xargs -0 grep -l -E '"event":"(UserPromptSubmit|BeforeAgent)"' 2>/dev/null | head -n 1)
    summary=$(jq -nc \
      --arg agent "$agent" --arg key "$key" --arg dir "$dir" \
      --arg last "$last" --argjson count "${#records[@]}" \
      --slurpfile first "$first" \
      --slurpfile prompt "${prompt_file:-/dev/null}" '
        def iso_us($us): ($us[0:-6] | tonumber | todate | sub("Z$"; ".\($us[-6:-3])Z"));
        {
          agent: $agent,
          session_key: $key,
          dir: $dir,
          records: $count,
          started: ($first[0].ts // null),
          last_activity: iso_us($last),
          cwd: ($first[0].cwd // null),
          first_prompt: ($prompt[0].payload | if type == "object" then (.prompt // .userPrompt) else null end)
        }' 2>/dev/null) || continue
    if $json; then
      printf '%s\n' "$summary"
    else
      printf '%s\n' "$summary" | jq -r '
        [ (.last_activity | sub("\\.[0-9]+Z$"; "Z")),
          .agent,
          .session_key,
          (.records | tostring),
          ((.cwd // "-") | if length > 24 then "…" + .[-23:] else . end),
          ((.first_prompt // "-") | gsub("[\u0000-\u001f\u007f-\u009f]+"; " ") | if length > 60 then .[:59] + "…" else . end)
        ] | map(gsub("[\u0000-\u001f\u007f-\u009f]+"; " ")) | "\(.[0] | . + " " * (26 - length)) \(.[1] | . + " " * ([7 - length, 0] | max)) \(.[2] | . + " " * ([38 - length, 0] | max)) \(.[3] | " " * ([6 - length, 0] | max) + .)  \(.[4] | . + " " * ([24 - length, 0] | max)) \(.[5])"'
    fi
  done <<<"$rows"
}

# Human timeline: one line per record. Summaries prefer the field an auditor
# scans for (the prompt, command, file, or guard message) over raw JSON.
# shellcheck disable=SC2016 # jq program, not shell expansions.
_TELEMETRY_TIMELINE_JQ='
  # Records hold agent-controlled text (prompts, commands, tool output).
  # Replace every C0/C1 control character, not only newlines, so an embedded
  # ANSI escape sequence cannot rewrite the auditor'\''s terminal.
  def clean: gsub("[\u0000-\u001f\u007f-\u009f]+"; " ");
  def clip($n): if length > $n then .[:$n - 1] + "…" else . end;
  def pad($n): . + " " * ([$n - length, 0] | max);
  def input_summary:
    if type != "object" then (tostring)
    else (.command // .cmd // .file_path // .filePath // .path // .pattern
          // .url // .query // .description // .prompt
          // (if . == {} then "" else tojson end)) | tostring
    end;
  def summary:
    (.payload | if type == "object" then . else {} end) as $p
    | if .kind == "hook" then
        ([(.blocked // [])[] | "BLOCKED: " + .]
         + [(.warnings // [])[] | "WARN: " + .]
         + [(.reminders // [])[] | "REMIND: " + .]) as $m
        | if ($m | length) > 0 then $m | join(" | ")
          elif .command then "$ " + .command
          elif .edit_files then "files: " + (.edit_files | join(", "))
          else "" end
      else
        ($p.prompt // $p.userPrompt // $p.message // $p.reason
         // (($p.tool_input // $p.toolInput // $p.args // null) | if . == null then null else input_summary end)
         // "") | tostring
      end;
  [ (.ts | .[11:23]),
    (.kind | pad(5)),
    ((.event // "-") | pad(18)),
    ((if .kind == "hook" then .hook | sub("^agent-hook-"; "") else (.tool_name // "") end) | clip(22) | pad(22)),
    ((.outcome // "-") | pad(7)),
    (summary | clean | clip(160))
  ] | join(" ") | clean
'

# Concatenate a session's records in chronological order. Paths stream through
# xargs because a long session's record list can exceed the platform's
# argument-length limit (256 KiB on macOS).
_telemetry_cat() {
  printf '%s\0' "$1"/*.json | xargs -0 cat
}

_telemetry_cmd_show() {
  local want='' json=false dir
  local -a records
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)
        json=true
        shift
        ;;
      -*) _telemetry_die "unknown show option: $1" 2 ;;
      *)
        [ -z "$want" ] || _telemetry_die "show takes one SESSION" 2
        want="$1"
        shift
        ;;
    esac
  done
  dir=$(_telemetry_resolve "${want:-latest}") || exit 1
  records=("$dir"/*.json)
  [ -e "${records[0]}" ] || _telemetry_die "no records in $dir"
  if $json; then
    # Each record file is one line, so concatenation is valid JSONL; `jq -c`
    # also normalizes any record written by a future schema with whitespace.
    _telemetry_cat "$dir" | jq -c .
  else
    # The directory name embeds an untrusted session id.
    printf '# %s\n' "${dir//[[:cntrl:]]/?}"
    _telemetry_cat "$dir" | jq -r "$_TELEMETRY_TIMELINE_JQ"
  fi
}

_telemetry_cmd_path() {
  [ $# -le 1 ] || _telemetry_die "path takes at most one SESSION" 2
  _telemetry_resolve "${1:-latest}"
}

_telemetry_cmd_prune() {
  local days root
  days=$(_agentguard_telemetry_retention_days)
  while [ $# -gt 0 ]; do
    case "$1" in
      --days)
        [ $# -ge 2 ] || _telemetry_die "--days needs a value" 2
        case "$2" in '' | *[!0-9]*) _telemetry_die "--days must be a number" 2 ;; esac
        days="$2"
        shift 2
        ;;
      *) _telemetry_die "unknown prune option: $1" 2 ;;
    esac
  done
  if [ "$days" -eq 0 ]; then
    echo "retention is 0 (keep forever); nothing pruned"
    return 0
  fi
  while IFS= read -r root; do
    _agentguard_telemetry_prune "$root" "$days"
  done < <(_agentguard_telemetry_roots)
  printf 'pruned sessions idle for more than %s days\n' "$days"
}

_telemetry_main() {
  local cmd="${1:-}"
  [ $# -eq 0 ] || shift
  case "$cmd" in
    dir) _telemetry_cmd_dir "$@" ;;
    sessions | ls) _telemetry_cmd_sessions "$@" ;;
    show) _telemetry_cmd_show "$@" ;;
    path) _telemetry_cmd_path "$@" ;;
    prune) _telemetry_cmd_prune "$@" ;;
    -h | --help | help) _telemetry_usage ;;
    '')
      _telemetry_usage >&2
      return 2
      ;;
    *)
      printf 'agentguard-telemetry: unknown command %s\n' "$cmd" >&2
      _telemetry_usage >&2
      return 2
      ;;
  esac
}

_telemetry_main "$@"

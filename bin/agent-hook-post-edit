#!/usr/bin/env bash
# agent-hook-post-edit — PostToolUse handler for Edit|Write.
# Auto-formats edited files.

set -u
_HOOK_SELF="${AGENTGUARD_HOOK_SELF:-$0}" # captured before sourcing so _hook_source_extensions finds agent/local variants
# shellcheck shell=bash
# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-hook-bootstrap; edit the template, not launcher copies.
# shellcheck shell=bash
_agentguard_script_parent() {
  case "$1" in
    */*) printf '%s\n' "${1%/*}" ;;
    *) printf '.\n' ;;
  esac
}

_agentguard_script_dir() {
  local path="$1" dir target
  while [[ -L "$path" ]]; do
    dir=$(cd -P -- "$(_agentguard_script_parent "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  cd -P -- "$(_agentguard_script_parent "$path")" && pwd
}
_HOOK_BIN_DIR=$(_agentguard_script_dir "${BASH_SOURCE[0]}") || {
  echo "${0##*/}: cannot resolve executable path" >&2
  exit 2
}
# shellcheck disable=SC1091 # Resolved relative to this symlink-aware launcher.
source "$_HOOK_BIN_DIR/../lib/agentguard/hook-helpers.sh"
# END GENERATED LAUNCHER BOOTSTRAP

_hook_parse_edit_files

# Format one directory's files with a single `sley hook format --stdin`
# batch. Sley detects the repo from the caller's cwd, so each directory gets
# its own batch from that directory — exactly the repo context the old
# per-file loop produced via its per-file `cd`. A sley too old for the batch
# entry fails the batch call, and only then do the files fall back to
# one-by-one `format-file` (current sley always exits the batch 0, formatter
# failures included, so the fallback costs nothing on supported installs).
# Assumption: no install overrides `sley_hook_format_file` alone. Sley's own
# `ready.sh`/`sley.sh` batch paths refuse to batch in that case because the
# batch entry bypasses a format-file-only override; this hook cannot see
# those flags, so a format-file-only override would be silently skipped
# here. All known extensions override both entry points consistently, but
# a future lone override needs a matching carve-out here.
# Telemetry note: on `arc` hosts the batch attempt reports
# `hook=${caller}_pre_commit` where the old per-file loop reported
# `hook=${caller}_auto_format` (the label lives in sley's extension, not
# here). File bytes are unaffected.
_post_edit_format_dir() {
  local dir="$1" files="$2" caller="$3" fp
  (
    # Detect the repo from the edited files' directory, not from the agent's
    # process cwd. Agents often edit absolute paths while sitting elsewhere.
    cd "$dir" || exit 0
    export SLEY_CALLER="$caller"
    if ! sley hook format --stdin <<<"$files" >/dev/null 2>&1; then
      while IFS= read -r fp; do
        [ -n "$fp" ] || continue
        sley hook format-file "$fp" >/dev/null 2>&1 || true
      done <<<"$files"
    fi
  )
}

_post_edit_format_all() {
  local fp abs_fp dir idx i
  local -a _dirs=() _lists=()

  # Group existing files by directory (plain indexed arrays: this hook still
  # runs under Bash 3.2 on stock macOS, which has no associative arrays).
  while IFS= read -r fp; do
    [ -n "$fp" ] || continue
    [ -f "$fp" ] || continue
    # Resolve to an absolute path BEFORE any `cd` below. Without this, a
    # relative path like `src/main.js` would re-resolve against the new cwd
    # and the formatter would look for `src/src/main.js`, silently no-op'ing
    # on every relative-path edit.
    case "$fp" in
      /*) abs_fp="$fp" ;;
      *) abs_fp="$PWD/$fp" ;;
    esac
    dir="${abs_fp%/*}"
    [ -n "$dir" ] || dir=/
    idx=-1
    i=0
    while [ "$i" -lt "${#_dirs[@]}" ]; do
      if [ "${_dirs[i]}" = "$dir" ]; then
        idx=$i
        break
      fi
      i=$((i + 1))
    done
    if [ "$idx" -lt 0 ]; then
      _dirs+=("$dir")
      _lists+=("$abs_fp")
    else
      _lists[idx]="${_lists[idx]}
$abs_fp"
    fi
  done <<<"$AGENTGUARD_EDIT_FILES"

  [ "${#_dirs[@]}" -gt 0 ] || return 0

  # Post-edit policy has one owner: Sley. If the command is missing, the
  # install is incomplete and the hook should fail loudly instead of silently
  # skipping save-time formatting.
  _hook_require_sley || return $?

  local caller
  caller=$(_hook_agent_name)
  i=0
  while [ "$i" -lt "${#_dirs[@]}" ]; do
    _post_edit_format_dir "${_dirs[i]}" "${_lists[i]}" "$caller"
    i=$((i + 1))
  done
}

_post_edit_format_all || exit $?

# Track edit churn per file
if [ -n "$AGENTGUARD_EDIT_FILES" ]; then
  while IFS= read -r _fp; do
    [ -n "$_fp" ] || continue
    _churn_file=$(_hook_edit_churn_file "$_fp")
    _hook_counter_increment "$_churn_file"
  done <<<"$AGENTGUARD_EDIT_FILES"
fi

# Keep memory refresh policy in `hm`; this hook only supplies the edit event.
_hook_hm_tool_complete
_hook_source_extensions
_hook_finish

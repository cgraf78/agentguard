#!/usr/bin/env bash
# agent-hook-telemetry — passive audit recorder for every hook event.
# Reads the host payload and exits successfully with an empty response; the
# shared EXIT trap in hook-helpers.sh writes the payload as an `event` record.
# Register it for every event and tool the runtime exposes. It never blocks,
# warns, or injects context, so it is safe beside any guard hook.

set -u
_HOOK_SELF="${AGENTGUARD_HOOK_SELF:-$0}" # captured before sourcing so _hook_source_extensions finds agent/local variants
# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-hook-bootstrap; edit the template, not launcher copies.
# shellcheck shell=bash
# Store the directory part of path $1 in the variable named by $2, as the
# `$(...)` capture this replaced held it (trailing newlines stripped). Every
# hook resolves its own path at startup, so the capture's fork was paid on
# every call.
_agentguard_script_parent() {
  case "$1" in
    */*) printf -v "$2" '%s' "${1%/*}" ;;
    *) printf -v "$2" '.' ;;
  esac
  while [[ "${!2}" == *$'\n' ]]; do
    printf -v "$2" '%s' "${!2%$'\n'}"
  done
}

_agentguard_script_dir() {
  local path="$1" dir target parent
  while [[ -L "$path" ]]; do
    _agentguard_script_parent "$path" parent
    dir=$(cd -P -- "$parent" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  _agentguard_script_parent "$path" parent
  cd -P -- "$parent" && pwd
}
_HOOK_BIN_DIR=$(_agentguard_script_dir "${BASH_SOURCE[0]}") || {
  echo "${0##*/}: cannot resolve executable path" >&2
  exit 2
}
# shellcheck disable=SC1091 # Resolved relative to this symlink-aware launcher.
source "$_HOOK_BIN_DIR/../lib/agentguard/hook-helpers.sh" || {
  echo "${0##*/}: cannot load AgentGuard hook helpers" >&2
  exit 2
}
# END GENERATED LAUNCHER BOOTSTRAP

if ! _agentguard_telemetry_enabled && ! command -v term-pane-mark >/dev/null 2>&1; then
  printf '{}\n'
  exit 0
fi

# Without a payload there is nothing to audit beyond the invocation itself;
# the trap still records that, so fall through rather than exiting early.
_hook_read_input || true

# A message from a teammate can start a foreground turn without a prompt
# submit. PreToolUse is the first universal hook that can observe that work;
# the pane helper caches the turn identity to avoid touching tmux per tool.
if command -v term-pane-mark >/dev/null 2>&1; then
  case "${_HOOK_INPUT:-}" in
    *PreToolUse* | *SubagentStart* | *SubagentStop* | *StopFailure* | *idle_prompt*)
      _busy_event=$(printf '%s' "$_HOOK_INPUT" | jq -r '.hook_event_name // .hookEventName // empty' 2>/dev/null)
      case "$_busy_event" in
        PreToolUse)
          _busy_child=$(printf '%s' "$_HOOK_INPUT" | jq -r '.agent_id // .agentId // empty' 2>/dev/null)
          if [ -z "$_busy_child" ] && [ "${AGENTGUARD_NAME:-}" = muse ] &&
            [ -e "$_HOOK_STATE_DIR/muse-child-session" ]; then
            _busy_sid=$(printf '%s' "$_HOOK_INPUT" | jq -r '(.session_id | strings) // empty' 2>/dev/null)
            # A shared-dir tool carrying the root session id is foreground
            # work even while a child is active; only a visiting child id,
            # or a dir owned by a child (sticky owner entry), routes as
            # child work. Anything else stays untracked and veto-held. The
            # owner branch is pinned by the muse-busy-team.py follow-up
            # rearm, which routes without a fresh SubagentStart.
            if [ -n "$_busy_sid" ] && [ "$_busy_sid" != "$_HOOK_SESSION_KEY" ]; then
              _busy_child="$_busy_sid"
            elif [ -n "$_busy_sid" ] &&
              [ -e "$_HOOK_STATE_DIR/muse-child/child.$_HOOK_SESSION_KEY" ]; then
              _busy_child="$_busy_sid"
            fi
          fi
          if [ -n "$_busy_child" ] && { [ "${AGENTGUARD_NAME:-}" = codex ] ||
            [ "${AGENTGUARD_NAME:-}" = muse ]; }; then
            _busy_turn=$(printf '%s' "$_HOOK_INPUT" | jq -r '.turn_id // .turnId // empty' 2>/dev/null)
            _busy_cached=''
            _busy_cache_file="$_HOOK_STATE_DIR/busy-team/child.$_busy_child"
            if [ "${AGENTGUARD_NAME:-}" = muse ]; then
              _busy_cache_file="$_HOOK_STATE_DIR/muse-child-turn"
            fi
            case "$_busy_child" in
              *[!A-Za-z0-9._-]* | '') ;;
              *)
                if [ -f "$_busy_cache_file" ]; then
                  IFS= read -r _busy_cached <"$_busy_cache_file" || true
                fi
                ;;
            esac
            if [ -z "$_busy_turn" ] || [ "$_busy_cached" != "$_busy_turn" ]; then
              if _hook_team_busy child set && [ "${AGENTGUARD_NAME:-}" = muse ]; then
                _hook_busy_cache_publish "$_busy_cache_file" "$_busy_turn" || true
              fi
            fi
          elif [ -z "$_busy_child" ]; then
            _hook_pane_busy set
          fi
          ;;
        SubagentStart)
          if [ "${AGENTGUARD_NAME:-}" = muse ] && _hook_mkstate "$_HOOK_STATE_DIR"; then
            _hook_muse_child_begin || true
            rm -f -- "$_HOOK_STATE_DIR/muse-child-turn" 2>/dev/null || true
          fi
          case "${AGENTGUARD_NAME:-}" in codex | claude | muse) _hook_team_busy child set || true ;; esac
          ;;
        SubagentStop)
          if [ "${AGENTGUARD_NAME:-}" = muse ]; then
            rm -f -- "$_HOOK_STATE_DIR/muse-child-turn" 2>/dev/null || true
            _hook_muse_child_end || true
          fi
          case "${AGENTGUARD_NAME:-}" in codex | claude | muse) _hook_team_busy child clear || true ;; esac
          ;;
        StopFailure)
          # A failed Claude child turn ends without its SubagentStop. The
          # root's StopFailure is settled below with the other aborted turns.
          if [ "${AGENTGUARD_NAME:-}" = claude ] && printf '%s' "$_HOOK_INPUT" |
            jq -e '(.agent_id // "") != ""' >/dev/null 2>&1; then
            _hook_team_busy child clear || true
          fi
          ;;
        Notification)
          # Claude sends its idle prompt only once the parent is idle and no
          # subagent or teammate is working, which backstops a missed child
          # Stop. The pane helper ignores a child's notification.
          if [ "${AGENTGUARD_NAME:-}" = claude ] && printf '%s' "$_HOOK_INPUT" |
            jq -e '.notification_type == "idle_prompt"' >/dev/null 2>&1; then
            _hook_pane_busy idle
          fi
          ;;
      esac
      ;;
  esac
fi

# StopFailure and Interrupt end a turn without a Stop callback, and this is the
# only hook wired to them, so it also ends the agent's busy pane mark. That is
# a terminal display effect, not a guard, so the observe-only contract holds.
if _hook_turn_aborted; then
  if [ "${AGENTGUARD_NAME:-}" = muse ]; then
    # The killed turn's children deliver no SubagentStop; retire their
    # tracking first, or the stale veto blocks this very clear.
    _hook_muse_child_reap_turn || true
  fi
  _hook_pane_busy clear
fi

_agentguard_telemetry_enabled || {
  printf '{}\n'
  exit 0
}

# Retention runs around session start and in the background: a full-tree
# scan must never delay the host's first turn, and once per session is
# frequent enough for a window measured in days. The substring prefilter
# avoids a jq parse on every tool call; a false positive (a command that
# merely mentions SessionStart) only costs one idempotent prune.
#
# The redirections apply to the whole background job, not just an inner
# subshell: hosts read hook stdout until EOF, so any background process still
# holding the hook's stdout or stderr would stall the session start for the
# length of the scan.
case "${_HOOK_INPUT:-}" in
  *SessionStart* | *sessionStart* | *session_start*)
    if _telemetry_root=$(_agentguard_telemetry_root 2>/dev/null); then
      _telemetry_days=$(_agentguard_telemetry_retention_days)
      _agentguard_telemetry_prune "$_telemetry_root" "$_telemetry_days" \
        </dev/null >/dev/null 2>&1 &
    fi
    ;;
esac

_hook_source_extensions
# Deliberately discard anything an extension accumulated: this hook's
# contract is "observe only", so a misplaced extension cannot turn it into a
# guard. Its record still captures what the extension tried to emit.
_HOOK_BLOCKED=''
_HOOK_CTX=''
_hook_finish

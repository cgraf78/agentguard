#!/usr/bin/env bash
# agent-hook-pre-mcp — PreToolUse guard for MCP tools.
# Circuit breaker for failing servers, warns on expensive operations.

set -u
_HOOK_SELF="${AGENTGUARD_HOOK_SELF:-$0}" # captured before sourcing so _hook_source_extensions finds agent/local variants
# shellcheck shell=bash
# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-hook-bootstrap; edit the template, not launcher copies.
# shellcheck shell=bash
# Store the directory part of path $1 in the variable named by $2, as the
# `$(...)` capture this replaced held it (trailing newlines stripped). Every
# hook resolves its own path at startup, so the capture's fork was paid on
# every call.
_agentguard_script_parent() {
  case "$1" in
    */*) printf -v "$2" '%s' "${1%/*}" ;;
    *) printf -v "$2" '.' ;;
  esac
  while [[ "${!2}" == *$'\n' ]]; do
    printf -v "$2" '%s' "${!2%$'\n'}"
  done
}

_agentguard_script_dir() {
  local path="$1" dir target parent
  while [[ -L "$path" ]]; do
    _agentguard_script_parent "$path" parent
    dir=$(cd -P -- "$parent" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  _agentguard_script_parent "$path" parent
  cd -P -- "$parent" && pwd
}
_HOOK_BIN_DIR=$(_agentguard_script_dir "${BASH_SOURCE[0]}") || {
  echo "${0##*/}: cannot resolve executable path" >&2
  exit 2
}
# shellcheck disable=SC1091 # Resolved relative to this symlink-aware launcher.
source "$_HOOK_BIN_DIR/../lib/agentguard/hook-helpers.sh" || {
  echo "${0##*/}: cannot load AgentGuard hook helpers" >&2
  exit 2
}
# END GENERATED LAUNCHER BOOTSTRAP

_hook_parse_mcp

# --- Consecutive failure circuit breaker ---
# Three consecutive failures open the breaker. Blocked calls never reach
# post-mcp, so only time can close it again: once 60 s have passed since the
# last failure or probe, the next call re-stamps the record and goes through
# as a half-open probe; post-mcp's verdict on it resets (success) or re-arms
# (failure) the breaker. Calls racing the probe may probe too, which is
# harmless; the re-stamp makes the call after a probe whose post hook never
# ran (an interrupt, a denial by another hook) wait out another cooldown. A
# record without a usable epoch (written by an older AgentGuard, corrupt, or
# stamped by a clock that has since gone backwards) starts its cooldown now.
# Without a clock no cooldown can be timed, so the breaker stays closed.
if [ -f "$_HOOK_MCP_FAIL_FILE" ]; then
  _hook_mcp_failures_read
  if [ "$_HOOK_MCP_FAILS" -ge 3 ]; then
    _mcp_cooldown=60
    _mcp_now=''
    _hook_now _mcp_now || _mcp_now=''
    _mcp_wait=0
    _mcp_stamp=0
    if [ -z "$_mcp_now" ]; then
      :
    elif [ -n "$_HOOK_MCP_FAIL_EPOCH" ] && [ "$_mcp_now" -ge "$_HOOK_MCP_FAIL_EPOCH" ]; then
      _mcp_wait=$((_mcp_cooldown - (_mcp_now - _HOOK_MCP_FAIL_EPOCH)))
      [ "$_mcp_wait" -gt 0 ] || _mcp_stamp=1
    else
      _mcp_wait="$_mcp_cooldown"
      _mcp_stamp=1
    fi
    [ "$_mcp_stamp" = 0 ] ||
      _hook_mcp_failures_write "$_HOOK_MCP_FAILS" "$_HOOK_MCP_FAIL_TOOL" "$_HOOK_MCP_FAIL_ERROR"
    if [ "$_mcp_wait" -gt 0 ]; then
      _mcp_last=''
      [ -z "$_HOOK_MCP_FAIL_TOOL" ] ||
        _mcp_last=" The last failure was tool '$_HOOK_MCP_FAIL_TOOL'${_HOOK_MCP_FAIL_ERROR:+: $_HOOK_MCP_FAIL_ERROR}."
      # The third failure opens the breaker, so from five on at least two
      # probes have failed too.
      if [ "$_HOOK_MCP_FAILS" -ge 5 ]; then
        _mcp_advice='Retries after earlier pauses failed too, so the server is probably down: try a different approach or ask the user to check it.'
      else
        _mcp_advice="Repeated failures are often bad arguments rather than a down server (a path outside the server's root, a target that does not exist): read the error text and fix the arguments before retrying."
      fi
      _hook_block "MCP server '$_HOOK_MCP_SERVER' has failed $_HOOK_MCP_FAILS consecutive times this session, so its calls are paused; one retry is allowed in ${_mcp_wait}s.$_mcp_last $_mcp_advice"
    fi
  fi
fi

# --- Expensive operation guards ---

if [ "$_HOOK_MCP_TOOL_NAME" = "search_files" ]; then
  has_path=$(printf '%s' "$_HOOK_INPUT" | jq -r '
    .tool_input
    | (.target_directories // .path // .directory // .paths // empty)
    | if type == "array" then if length > 0 then "ok" else empty end
      else . end
  ' 2>/dev/null)
  if [ -z "$has_path" ]; then
    _hook_warn 'search_files called without a path filter. In large monorepos this can be very slow. Consider scoping to a subdirectory.'
  fi
fi

if [ "$_HOOK_MCP_TOOL_NAME" = "knowledge_load" ]; then
  if _hook_once_per_session "knowledge-load-warned"; then
    _hook_warn 'knowledge_load can consume significant context window on large documents. Prefer knowledge_filtered_search for targeted lookups.'
  fi
fi

_hook_source_extensions
_hook_finish

#!/usr/bin/env bash
# agent-hook-post-mcp — PostToolUse tracker for MCP tools.
# Tracks consecutive failures per MCP server. Resets on success.

set -u
_HOOK_SELF="${AGENTGUARD_HOOK_SELF:-$0}" # captured before sourcing so _hook_source_extensions finds agent/local variants
# shellcheck shell=bash
# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-hook-bootstrap; edit the template, not launcher copies.
# shellcheck shell=bash
# Store the directory part of path $1 in the variable named by $2, as the
# `$(...)` capture this replaced held it (trailing newlines stripped). Every
# hook resolves its own path at startup, so the capture's fork was paid on
# every call.
_agentguard_script_parent() {
  case "$1" in
    */*) printf -v "$2" '%s' "${1%/*}" ;;
    *) printf -v "$2" '.' ;;
  esac
  while [[ "${!2}" == *$'\n' ]]; do
    printf -v "$2" '%s' "${!2%$'\n'}"
  done
}

_agentguard_script_dir() {
  local path="$1" dir target parent
  while [[ -L "$path" ]]; do
    _agentguard_script_parent "$path" parent
    dir=$(cd -P -- "$parent" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  _agentguard_script_parent "$path" parent
  cd -P -- "$parent" && pwd
}
_HOOK_BIN_DIR=$(_agentguard_script_dir "${BASH_SOURCE[0]}") || {
  echo "${0##*/}: cannot resolve executable path" >&2
  exit 2
}
# shellcheck disable=SC1091 # Resolved relative to this symlink-aware launcher.
source "$_HOOK_BIN_DIR/../lib/agentguard/hook-helpers.sh" || {
  echo "${0##*/}: cannot load AgentGuard hook helpers" >&2
  exit 2
}
# END GENERATED LAUNCHER BOOTSTRAP

_hook_parse_mcp

# Track consecutive failures per server so the pre-mcp circuit breaker
# can pause calls to a failing server; each failure also restarts its
# cooldown. Reset on any success, which closes a half-open breaker. Runtimes
# report a failed MCP call differently:
#   - a failure event (Claude/Muse PostToolUseFailure, Grok
#     post_tool_use_failure) is itself the signal;
#   - a top-level flag (OpenCode adapter, Grok `isError`);
#   - the MCP CallToolResult's own `isError` in tool_response (Codex);
#   - Gemini's ToolResult `error` object in tool_response. Only Gemini's
#     response shape is AgentGuard-owned there; elsewhere tool_response is the
#     server's arbitrary JSON, so an `error` key in it is not a signal.
# A user interrupt (Claude `is_interrupt`) says nothing about the server, so
# it neither counts nor resets. Output is `interrupt`, `true`, or `false`; a
# jq failure leaves the counter untouched rather than resetting it.
agent="${AGENTGUARD_NAME:-}"
[ -n "$agent" ] || _hook_agent_name agent
if verdict=$(printf '%s' "$_HOOK_INPUT" | jq -r --arg agent "$agent" '
  def flag: . == true or . == "true";
  (.tool_response // .toolResponse) as $r
  | if (.is_interrupt // .isInterrupt) == true then "interrupt"
    elif ((.hook_event_name // .hookEventName // "") | tostring | test("^(PostToolUseFailure|post_tool_use_failure)$"))
      or ((.tool_result_is_error // .isError) | flag)
      or (($r | type) == "object" and (($r.isError | flag)
        or ($agent == "gemini" and (($r.error | type) == "object" or (($r.error | type) == "string" and $r.error != "")))))
    then "true" else "false" end
' 2>/dev/null); then
  case "$verdict" in
    true)
      # Keep the start of the error for pre-mcp's block message: it usually
      # says whether the arguments or the server are at fault. Only
      # failures pay for this second jq.
      failure_text=$(printf '%s' "$_HOOK_INPUT" | jq -r '
        def text:
          if type == "string" then .
          elif type == "array" then map(text) | join(" ")
          elif type == "object" then
            (.error // .message // .content // .text // .output // .stderr // empty) | text
          else empty end;
        [.error, .tool_response, .toolResponse, .tool_result, .toolResult]
        | map(select(. != null) | text | select(. != ""))
        | (first // "") | gsub("[[:cntrl:]]+"; " ") | .[0:200]
      ' 2>/dev/null) || failure_text=''
      _hook_mcp_failures_read
      _hook_mcp_failures_write "$((_HOOK_MCP_FAILS + 1))" "$_HOOK_MCP_TOOL_NAME" "$failure_text"
      ;;
    false) _hook_counter_reset "$_HOOK_MCP_FAIL_FILE" ;;
  esac
else
  verdict=''
fi

# MCP success/failure is another tool boundary; `hm` owns any memory refresh.
# Hand `hm` the failure verdict computed above; its generic status reader
# does not know the runtime-specific failure shapes.
# An interrupted call did not succeed either, so it must not refresh state
# the way a success does.
case "$verdict" in
  true | interrupt) _hook_hm_tool_complete 1 ;;
  false) _hook_hm_tool_complete 0 ;;
  *) _hook_hm_tool_complete ;;
esac
_hook_source_extensions
_hook_finish

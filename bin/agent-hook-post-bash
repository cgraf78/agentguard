#!/usr/bin/env bash
# agent-hook-post-bash — PostToolUse handler for Bash commands.

set -u
_HOOK_SELF="${AGENTGUARD_HOOK_SELF:-$0}" # captured before sourcing so _hook_source_extensions finds agent/local variants
# shellcheck shell=bash
# BEGIN GENERATED LAUNCHER BOOTSTRAP
# Generated by support/sync-hook-bootstrap; edit the template, not launcher copies.
# shellcheck shell=bash
# Store the directory part of path $1 in the variable named by $2, as the
# `$(...)` capture this replaced held it (trailing newlines stripped). Every
# hook resolves its own path at startup, so the capture's fork was paid on
# every call.
_agentguard_script_parent() {
  case "$1" in
    */*) printf -v "$2" '%s' "${1%/*}" ;;
    *) printf -v "$2" '.' ;;
  esac
  while [[ "${!2}" == *$'\n' ]]; do
    printf -v "$2" '%s' "${!2%$'\n'}"
  done
}

_agentguard_script_dir() {
  local path="$1" dir target parent
  while [[ -L "$path" ]]; do
    _agentguard_script_parent "$path" parent
    dir=$(cd -P -- "$parent" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  _agentguard_script_parent "$path" parent
  cd -P -- "$parent" && pwd
}
_HOOK_BIN_DIR=$(_agentguard_script_dir "${BASH_SOURCE[0]}") || {
  echo "${0##*/}: cannot resolve executable path" >&2
  exit 2
}
# shellcheck disable=SC1091 # Resolved relative to this symlink-aware launcher.
source "$_HOOK_BIN_DIR/../lib/agentguard/hook-helpers.sh" || {
  echo "${0##*/}: cannot load AgentGuard hook helpers" >&2
  exit 2
}
# END GENERATED LAUNCHER BOOTSTRAP

_hook_parse_command # reads stdin → $_HOOK_INPUT, sets $AGENTGUARD_CMD_TRIMMED

# Scan stdout for credential-like patterns. Detection is advisory only —
# the command has already run. Low-false-positive patterns only; omit
# generic high-entropy heuristics to avoid noise. The adapter reads the
# runtime; resolving it in this shell first lets the `$(...)` reuse the cached
# answer, and _hook_source_extensions needs it here anyway.
_hook_agent_name _post_bash_agent
_stdout=$(_hook_tool_stdout)

if [ -n "$_stdout" ]; then
  _cred_types=''

  _add_cred_type() {
    if [ -n "$_cred_types" ]; then
      _cred_types="$_cred_types, $1"
    else
      _cred_types="$1"
    fi
  }

  _pem_credential_pattern='-----BEGIN [A-Z ]*(PRIVATE KEY|CERTIFICATE)[[:space:]]*-----'
  _aws_credential_pattern='(^|[^A-Z0-9])AKIA[0-9A-Z]{16}([^A-Z0-9]|$)'
  _github_credential_pattern='(ghp|ghs|ghr|gho|ghu)_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{82}'
  _anthropic_credential_pattern='sk-ant-[A-Za-z0-9_-]{20,}'
  _sk_credential_pattern='(^|[^A-Za-z0-9_-])sk-[A-Za-z0-9]{32,}'
  _credential_union_pattern="($_pem_credential_pattern)|($_aws_credential_pattern)|($_github_credential_pattern)|($_anthropic_credential_pattern)|($_sk_credential_pattern)"

  # Every credential class above contains one of these literals, so a builtin
  # match on them is a superset of the union scan: the common credential-free
  # output costs no fork. `sk-` alone also hits ordinary words ("task-list"),
  # so a hit still runs one exact union scan, and only a real match runs
  # every classifier below, keeping warning types and multi-credential
  # behavior unchanged.
  # `BEGIN ` rather than the PEM header's leading dashes: a `-` run (common in
  # tables and separators) would start a match attempt at every dash.
  _credential_literal_pattern='BEGIN |AKIA|gh[psrou]_|github_pat_|sk-'
  # Byte matching in the C locale: the literals are ASCII, and some libc
  # regex engines refuse to match at all (REG_ILLSEQ) when a multibyte locale
  # meets invalid UTF-8 in the output.
  _output_has_credential_literal() {
    local LC_ALL=C
    [[ "$_stdout" =~ $_credential_literal_pattern ]]
  }
  # stderr: restoring an uninstalled caller LC_ALL after the helper's local
  # C locale makes bash print a setlocale warning.
  if _output_has_credential_literal 2>/dev/null &&
    printf '%s' "$_stdout" | grep -qE -e "$_credential_union_pattern"; then
    # PEM private key or certificate block headers — unambiguous format.
    # Use -e to avoid grep treating the leading dashes as option flags.
    if printf '%s' "$_stdout" | grep -qE -e "$_pem_credential_pattern"; then
      _add_cred_type 'PEM private key/certificate'
    fi

    # AWS Access Key ID — AKIA + exactly 16 uppercase alphanumeric chars
    if printf '%s' "$_stdout" | grep -qE "$_aws_credential_pattern"; then
      _add_cred_type 'AWS access key ID'
    fi

    # GitHub tokens — modern prefixed formats
    if printf '%s' "$_stdout" | grep -qE "$_github_credential_pattern"; then
      _add_cred_type 'GitHub token'
    fi

    # Anthropic API key
    if printf '%s' "$_stdout" | grep -qE "$_anthropic_credential_pattern"; then
      _add_cred_type 'Anthropic API key'
    fi

    # OpenAI / generic sk- API key (broad but high-signal prefix)
    if printf '%s' "$_stdout" | grep -qE "$_sk_credential_pattern"; then
      _add_cred_type 'API key (sk- prefix)'
    fi
  fi

  if [ -n "$_cred_types" ]; then
    _hook_warn "Command output may contain credentials (${_cred_types}). Avoid using this output in logs, commits, or prompts."
  fi
fi

# A push or pull-request creation starts fresh checks on the pushed head
# commit, and the command returns long before they finish, so an agent that
# stops here reports work as done while CI is still running or red. Network
# commands often run indirectly (a script, or a terminal multiplexer that has
# network access the agent sandbox lacks), so a printed push summary or the
# bare URL `gh pr create` prints counts as well as the command itself.
#
# When `git pr-watch` (git-tools) is installed, recognized commands also feed
# the session's watch obligations (lib/agentguard/watch.sh): creating a pull
# request records it, a push or `gh pr ready|reopen|update-branch` re-arms
# recorded ones, and a `gh pr merge|close` that ended one forgets it, so the
# Stop hook can tell when nobody watches them.
# docs/watch-protocol.md describes the rules.

# Prints the push evidence in `$1`: a bare pull-request URL line (any host),
# or the ref-update lines of a push summary (`To <remote>` followed by `*
# [new branch] HEAD -> x`, `abc..def main -> main`, or a forced `+` update).
# Rejected, up-to-date, and deleted refs carry no `->` update and print nothing.
_pr_checks_output_evidence() {
  printf '%s\n' "$1" |
    grep -E "^$_HOOK_GH_PR_URL_RE"
  printf '%s\n' "$1" | grep -qE '^To [^[:space:]]+[[:space:]]*$' &&
    printf '%s\n' "$1" |
    grep -E '^[[:space:]]+([*+]|[0-9a-f]{7,}\.\.\.?[0-9a-f]{7,})[[:space:]].* -> [^[:space:]]+'
}

# The agent's own command first, through the watch pass hook extensions
# share (_hook_gh_watch_pass in watch-github.sh). The builtin prefilter keeps
# every other command from loading the library or the classifier.
_pr_checks_output_pending=''
if _hook_gh_watch_prefilter "$AGENTGUARD_CMD_TRIMMED" && _hook_load_gh_helpers &&
  _hook_gh_watch_pass "$AGENTGUARD_CMD_TRIMMED" "$_stdout" - -; then
  :
# Output evidence covers pushes run indirectly. Commands that are themselves
# gh calls are skipped: their bare URLs come from reading or editing a pull
# request, and a real `gh pr create` was already judged above.
elif ! [[ "$AGENTGUARD_CMD_TRIMMED" =~ (^|[[:space:];\&\|\(])gh[[:space:]] ]]; then
  _pr_checks_output_pending=1
fi

# Let `hm` decide whether this completed tool event changes memory context.
# The bash hook only passes the observed status/path facts.
_hook_hm_tool_complete
_hook_source_extensions

# The output-evidence reminder comes after extensions: an extension that
# unwraps a wrapper's push runs the watch pass itself, and its reminder (the
# labelled one after a record or re-arm, or the general one) covers the push
# summary the wrapper printed. One that already reminded sets
# _HOOK_GH_WATCH_REMINDED, and the general reminder is not repeated.
if [ -n "$_pr_checks_output_pending" ] && [ -z "${_HOOK_GH_WATCH_REMINDED:-}" ]; then
  _pr_checks_text="$_stdout"
  # git push writes its summary to stderr; read it only when the raw payload
  # could hold one. A combined Codex or Muse string already carries it, so
  # skip the read and its subshell outright.
  case "${_HOOK_INPUT:-}" in
    *"To "*" -> "*)
      # stderr: same setlocale warning as the credential prefilter above.
      _hook_tool_response_is_string 2>/dev/null ||
        _pr_checks_text="$_pr_checks_text"$'\n'"$(_hook_tool_stderr)"
      ;;
  esac
  case "$_pr_checks_text" in
    */pull/* | *" -> "*)
      _pr_checks_evidence=$(_pr_checks_output_evidence "$_pr_checks_text")
      # Remind once per prompt for the same push: re-reading a captured pane
      # or log while monitoring must not repeat the reminder.
      if [ -n "$_pr_checks_evidence" ] && [ "$(_hook_hm_tool_status)" = "0" ] &&
        _hook_once_per_prompt "pr-checks-$(printf '%s' "output:$_pr_checks_evidence" | cksum | tr -d ' ')" &&
        _hook_load_gh_helpers; then
        _hook_gh_checks_reminder
      fi
      ;;
  esac
fi
_hook_finish

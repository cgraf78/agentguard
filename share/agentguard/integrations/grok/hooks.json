{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "env -u BASH_ENV -u ENV AGENTGUARD_NAME=grok AGENTGUARD_SESSION_ID=\"${GROK_SESSION_ID:-}\" agent-hook-notification",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "env -u BASH_ENV -u ENV AGENTGUARD_NAME=grok AGENTGUARD_SESSION_ID=\"${GROK_SESSION_ID:-}\" agent-hook-post-mcp",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "mcp__|.+__"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "env -u BASH_ENV -u ENV AGENTGUARD_NAME=grok AGENTGUARD_SESSION_ID=\"${GROK_SESSION_ID:-}\" agent-hook-post-edit",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|search_replace"
      },
      {
        "hooks": [
          {
            "command": "env -u BASH_ENV -u ENV AGENTGUARD_NAME=grok AGENTGUARD_SESSION_ID=\"${GROK_SESSION_ID:-}\" agent-hook-post-bash",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Bash|run_terminal_command"
      },
      {
        "hooks": [
          {
            "command": "env -u BASH_ENV -u ENV AGENTGUARD_NAME=grok AGENTGUARD_SESSION_ID=\"${GROK_SESSION_ID:-}\" agent-hook-post-mcp",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "mcp__|.+__"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "env -u BASH_ENV -u ENV AGENTGUARD_NAME=grok AGENTGUARD_SESSION_ID=\"${GROK_SESSION_ID:-}\" agent-hook-pre-bash",
            "timeout": 600,
            "type": "command"
          }
        ],
        "matcher": "Bash|run_terminal_command"
      },
      {
        "hooks": [
          {
            "command": "env -u BASH_ENV -u ENV AGENTGUARD_NAME=grok AGENTGUARD_SESSION_ID=\"${GROK_SESSION_ID:-}\" agent-hook-pre-edit",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|search_replace"
      },
      {
        "hooks": [
          {
            "command": "env -u BASH_ENV -u ENV AGENTGUARD_NAME=grok AGENTGUARD_SESSION_ID=\"${GROK_SESSION_ID:-}\" agent-hook-pre-mcp",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "mcp__|.+__"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "env -u BASH_ENV -u ENV AGENTGUARD_NAME=grok AGENTGUARD_SESSION_ID=\"${GROK_SESSION_ID:-}\" agent-hook-session-end",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "env -u BASH_ENV -u ENV AGENTGUARD_NAME=grok AGENTGUARD_SESSION_ID=\"${GROK_SESSION_ID:-}\" agent-hook-session-start",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "env -u BASH_ENV -u ENV AGENTGUARD_NAME=grok AGENTGUARD_SESSION_ID=\"${GROK_SESSION_ID:-}\" agent-hook-stop",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "env -u BASH_ENV -u ENV AGENTGUARD_NAME=grok AGENTGUARD_SESSION_ID=\"${GROK_SESSION_ID:-}\" agent-hook-prompt-submit",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}

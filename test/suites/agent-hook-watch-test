# Trace with the shell pid in PS4: a subshell or external command would show
# up as another pid or an unknown command word. Exactly one pid and no
# external command proves the snippet ran in the caller's shell.
_forks_for() {
  AGENTGUARD_SESSION_ID="$SID" AGENTGUARD_NAME=claude TMPDIR="$TEST_TMPDIR" \
    PATH="$WITH_WATCH_PATH" bash -c '
      source "$1" >/dev/null 2>&1 </dev/null
      _hook_refresh_state_dir 2>/dev/null
      source "$2"
      source "$3"
      trace=$(mktemp)
      exec 9>"$trace"
      BASH_XTRACEFD=9
      PS4="+\$BASHPID "
      set -x
      eval "$4"
      set +x
      exec 9>&-
      pids=$(sed -n "s/^+* *\([0-9][0-9]*\) .*/\1/p" "$trace" | sort -u | wc -l | tr -d " ")
      externals=0
      while read -r word _; do
        case "$(type -t "$word" 2>/dev/null)" in file) externals=$((externals + 1)) ;; esac
      done < <(sed -n "s/^+* *[0-9][0-9]* //p" "$trace")
      rm -f "$trace"
      echo "$pids $externals"
    ' _ "$HELPERS" "$WATCH_LIB" "$WATCH_GH_LIB" "$1"
}


      BASH_XTRACEFD=9
      PS4="+\$BASHPID "
      set -x
      eval "$4"
      set +x
      exec 9>&-
      pids=$(sed -n "s/^+* *\([0-9][0-9]*\) .*/\1/p" "$trace" | sort -u | wc -l | tr -d " ")
      externals=0
      while read -r word _; do
        case "$(type -t "$word" 2>/dev/null)" in file) externals=$((externals + 1)) ;; esac
      done < <(sed -n "s/^+* *[0-9][0-9]* //p" "$trace")
      rm -f "$trace"
      echo "$pids $externals"
    ' _ "$HELPERS" "$WATCH_LIB" "$WATCH_GH_LIB" "$1"
}


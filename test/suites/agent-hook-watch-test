# The whole hooks, not copies of their gates: a no-obligation Stop, and a
# post-bash and a pre-bash call that match nothing, must not fork more than
# they did before watch obligations. The numbers are those paths' exact
# counts; when unrelated work on them changes, update the numbers, never to
# hide a fork added for watch obligations.
#
# Stop and post-bash: xtrace with the shell pid in PS4 (inherited through
# SHELLOPTS) counts the distinct shells that ran traced commands, so every
# subshell counts once. Bash running as root ignores an inherited PS4, and
# Bash 3.2 has no BASHPID, so those hosts skip.
_hook_shells() {
  local hook="$1" agent="$2" payload="$3"
  _new_sid
  printf '%s' "$payload" |
    env PS4='+$BASHPID ' SHELLOPTS=xtrace AGENTGUARD_NAME="$agent" CODEX_THREAD_ID= \
      AGENTGUARD_SESSION_ID="$SID" TMPDIR="$TEST_TMPDIR" PATH="$WITH_WATCH_PATH" \
      "$hook" 2>&1 >/dev/null | sed -n 's/^+* *\([0-9][0-9]*\) .*/\1/p' | sort -u | wc -l | tr -d ' '
}
if [ "$(id -u)" != 0 ] && [ "$(bash -c 'echo ${BASH_VERSINFO[0]}')" -ge 4 ]; then
  _assert_eq "Stop without watch state: exact shell count" 10 "$(_hook_shells "$STOP" claude '{}')"
  _assert_eq "post-bash, non-matching: exact shell count" 9 \
    "$(_hook_shells "$POST_BASH" claude "$(_payload ls "a b")")"
else
  echo "  SKIP: hook shell counts (root ignores PS4, or no BASHPID)"
fi
# pre-bash runs privileged, which ignores SHELLOPTS, so count its process
# creations with strace where it is installed and allowed. Only the hook
# body's process tree counts: the secure launcher's bootstrap runs fixed
# platform tools that differ between distributions. The body is the last
# process that exec'd a bash (the launcher re-execs a validated candidate);
# its creations are those made by it or its descendants.
_body_forks_awk='
{
  pid = $1
  if (($2 ~ /^execve\(/ || $0 ~ /execve resumed/) && $0 ~ /= 0$/) {
    if ($2 ~ /^execve\(/) { p = $2; sub(/^execve\("/, "", p); sub(/".*/, "", p); exe[pid] = p }
    n = split(exe[pid], parts, "/")
    if (parts[n] == "bash") body = pid
  }
  if ($0 ~ /(clone3?|v?fork)\(/) made[NR] = pid
  if ($0 !~ /unfinished/ && $NF ~ /^[0-9]+$/ && ($0 ~ /(clone3?|v?fork)\(/ || $0 ~ /<\.\.\. (clone3?|v?fork) resumed>/))
    parent[$NF] = pid
}
END {
  count = 0
  for (r in made) {
    q = made[r]
    while (q != "" && q != body) q = parent[q]
    if (q == body) count++
  }
  print count
}'
_hook_body_forks() {
  local cmd="$1" log="$TEST_TMPDIR/pre-bash-strace.log"
  _new_sid
  jq -nc --arg cmd "$cmd" '{tool_input:{command:$cmd}}' |
    env AGENTGUARD_NAME=claude CODEX_THREAD_ID= AGENTGUARD_SESSION_ID="$SID" \
      TMPDIR="$TEST_TMPDIR" PATH="$WITH_WATCH_PATH" \
      strace -f -qq -e trace=execve,clone,clone3,fork,vfork -o "$log" "$PRE_BASH" >/dev/null 2>&1
  awk "$_body_forks_awk" "$log"
}
if command -v strace >/dev/null 2>&1 &&

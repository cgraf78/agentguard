_busy_hook agent-hook-telemetry muse "$shared_log" \
  "{\"session_id\":\"$shared_child_a\",\"child_session_id\":\"$shared_child_a\",\"subagent_id\":\"skill-reminder\",\"turn_id\":\"child-a\",\"hook_event_name\":\"SubagentStop\"}" "$shared_session" >/dev/null
shared_before=$(wc -l <"$shared_log" | tr -d ' ')
_busy_hook agent-hook-stop muse "$shared_log" \

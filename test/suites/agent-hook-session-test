# Claude children are bracketed by SubagentStart and SubagentStop, teammates
# included. Its task snapshots list an idle teammate as "running" until it
# shuts down, so they may only retire children, never mark one as working.
# Each case gets its own session, pane, and log.
_claude_case() {
  cb_session="$TEST_SID-claude-$1"
  cb_log="$MOCK_BUSY_DIR/claude-$1.log"
  cb_state="$MOCK_BUSY_DIR/claude-$1.state"
  cb_team="$TEST_TMPDIR/agentguard/hook-state/$cb_session/busy-team/state.json"
}
# Run one hook for the current case. $2 is a jq program over $s (the session).
_claude_hook() {
  TERM_PANE_MARK_STATE="$cb_state" _busy_hook "$1" claude "$cb_log" \
    "$(jq -nc --arg s "$cb_session" "$2")" "$cb_session" >/dev/null
}
_claude_prompt() { _claude_hook agent-hook-prompt-submit "{session_id:\$s,prompt_id:\"$1\",hook_event_name:\"UserPromptSubmit\",prompt:\"Work.\"}"; }
# $2 is the background_tasks JSON array.
_claude_stop() { _claude_hook agent-hook-stop "{session_id:\$s,prompt_id:\"$1\",hook_event_name:\"Stop\",background_tasks:$2}"; }
_claude_child() { _claude_hook agent-hook-telemetry "{session_id:\$s,prompt_id:\"$2\",agent_id:\"$3\",agent_type:\"worker\",hook_event_name:\"Subagent$1\"${4:+,background_tasks:$4}}"; }
_claude_end() { _claude_hook agent-hook-session-end "{session_id:\$s,hook_event_name:\"SessionEnd\"}"; }
_claude_idle() { _claude_hook agent-hook-telemetry "{session_id:\$s,prompt_id:\"$1\",hook_event_name:\"Notification\",notification_type:\"idle_prompt\",message:\"Claude is waiting for your input\"$2}"; }
claude_tm='[{"id":"tq1","type":"teammate","status":"running"}]'


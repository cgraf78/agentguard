: >"$SESSION_END_NAME_MARKER"
printf '%s\n' \
  '{"type":"custom-title","customTitle":"user-rename","sessionId":"sess-detect"}' \
  '{"type":"last-prompt","lastPrompt":"x","sessionId":"sess-detect"}' >>"$1"
printf '%s\n' "generated-title"
MOCK
chmod +x "$RENAME_END_DIR/bin/claude-session-name"
SESSION_END_RACE="$RENAME_END_DIR/race.jsonl"
cat >"$SESSION_END_RACE" <<'JSONL'
{"type":"user","message":{"content":"Untitled at SessionEnd."}}
JSONL
SESSION_END_NAME_MARKER="$RENAME_END_DIR/race-named.log"
_run_session_end_naming "$SESSION_END_RACE" "$SESSION_END_NAME_MARKER" \
  "$RENAME_END_DIR"
_assert_file_exists "session-end: re-check case reaches the namer" \
  "$SESSION_END_NAME_MARKER"
_assert_eq "session-end: title written during naming is not overwritten" \
  "user-rename" "$(_session_end_titles "$SESSION_END_RACE")"

echo ""
echo "=== claude-session-name ==="

SESSION_NAME_DIR=$(_tmpdir)
SESSION_NAME_TRANSCRIPT="$SESSION_NAME_DIR/transcript.jsonl"
cat >"$SESSION_NAME_TRANSCRIPT" <<'JSONL'
{"type":"user","message":{"content":"<system-reminder>keep going</system-reminder>"}}
{"type":"user","message":{"content":"/compact"}}
{"type":"user","message":{"content":[{"type":"text","text":"Move Claude session naming into agentguard."},{"type":"tool_use","name":"ignored"}]}}
{"type":"assistant","message":{"content":"ignored"}}
JSONL

cat >"$SESSION_NAME_DIR/claude" <<'MOCK'
#!/usr/bin/env bash
cat >/dev/null
printf '%s\n' '"AgentGuard Session Naming"'
MOCK

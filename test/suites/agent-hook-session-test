#!/usr/bin/env bash
if [[ ${TERM_PANE_MARK_LEGACY:-0} == 1 && "$*" == *'--token '* ]]; then exit 64; fi
if [[ -n ${TERM_PANE_MARK_FAIL_ONCE:-} && ! -e $TERM_PANE_MARK_FAIL_ONCE ]]; then
  : >"$TERM_PANE_MARK_FAIL_ONCE"
  exit 1
fi
if [[ -n ${TERM_PANE_MARK_DELAY_ONCE:-} && ! -e $TERM_PANE_MARK_DELAY_ONCE ]]; then
  : >"$TERM_PANE_MARK_DELAY_ONCE"
  sleep 1.2
fi
printf '%s\n' "$*" >>"$TERM_PANE_MARK_LOG"
if [[ -n ${TERM_PANE_MARK_STATE:-} ]]; then
  action=$1

    printf '%s' "$token" >"$TERM_PANE_MARK_STATE"
  elif [[ -f $TERM_PANE_MARK_STATE && $(cat "$TERM_PANE_MARK_STATE") == "$token" ]]; then
    rm -f "$TERM_PANE_MARK_STATE"
  fi
fi
printf '%s\n' "mark noise"
MOCK

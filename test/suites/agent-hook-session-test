RENAME_END_DIR=$(_tmpdir)
_install_hook_fixture "$RENAME_END_DIR" agent-hook-session-end \
  agent-hook-session-end-claude
cat >"$RENAME_END_DIR/bin/claude-session-name" <<'MOCK'

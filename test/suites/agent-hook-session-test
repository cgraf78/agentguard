printf '%s\n' "$route_session" >"$route_state/muse-parent-session"
_busy_hook agent-hook-telemetry muse "$route_log" \
  "{\"session_id\":\"$route_child\",\"child_session_id\":\"$route_child\",\"subagent_id\":\"skill-reminder\",\"turn_id\":\"child-a\",\"hook_event_name\":\"SubagentStart\"}" "$route_session" >/dev/null
route_before=$(wc -l <"$route_log" | tr -d ' ')
_busy_hook agent-hook-telemetry muse "$route_log" \

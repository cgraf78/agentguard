_busy_hook agent-hook-prompt-submit muse "$shared_log" \
  "{\"session_id\":\"$shared_session\",\"turn_id\":\"root-a\",\"hook_event_name\":\"UserPromptSubmit\",\"prompt\":\"Work.\"}" "$shared_session" >/dev/null
_assert_contains 'busy: shared-key Muse root prompt sets its mark' \
  'set busy' "$(cat "$shared_log")"
_busy_hook agent-hook-telemetry muse "$shared_log" \
  "{\"session_id\":\"$shared_child_a\",\"child_session_id\":\"$shared_child_a\",\"subagent_id\":\"skill-reminder\",\"turn_id\":\"child-a\",\"hook_event_name\":\"SubagentStart\"}" "$shared_session" >/dev/null
_busy_hook agent-hook-telemetry muse "$shared_log" \
  "{\"session_id\":\"$shared_child_b\",\"child_session_id\":\"$shared_child_b\",\"subagent_id\":\"skill-reminder\",\"turn_id\":\"child-b\",\"hook_event_name\":\"SubagentStart\"}" "$shared_session" >/dev/null
_assert_file_exists 'busy: visiting Muse Starts raise the veto' \
  "$shared_state/muse-child-session"
shared_before=$(wc -l <"$shared_log" | tr -d ' ')
_busy_hook agent-hook-telemetry muse "$shared_log" \
  "{\"session_id\":\"$shared_child_a\",\"turn_id\":\"child-a\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"read_file\"}" "$shared_session" >/dev/null

#!/usr/bin/env bash
if [[ ${TERM_PANE_MARK_LEGACY:-0} == 1 && "$*" == *'--token '* ]]; then exit 64; fi
printf '%s\n' "$*" >>"$TERM_PANE_MARK_LOG"

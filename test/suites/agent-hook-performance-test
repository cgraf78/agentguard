#!/usr/bin/env bash
# agent-hook-performance-test - gross latency budgets for cheap hook paths.

# shellcheck disable=SC1090,SC1091 # dynamic helper path resolved at runtime.
AGENTGUARD_TEST_HELPERS="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/agent-hook-helpers.sh"
. "$AGENTGUARD_TEST_HELPERS"

# A single batch median is a noisy estimate on a hosted runner: one
# contention window inflates every sample in the batch, however fast the
# hook is. A median-only breach therefore collects two more batches and
# judges the median of the three batch medians: passing requires at
# least two of the three batch medians under the budget. The original
# batch stays in the vote, so this is a failure-triggered majority
# vote, not a rerun-until-pass: slowness that persists across the
# whole sampling window fails at least two batches and still fails,
# while a one-batch contention window cannot fail the suite alone.
# The trade-off is symmetric: an intermittent regression confined to
# one batch would be outvoted just as one-batch contention is —
# timing alone cannot tell them apart. Where a per-sample cap is set
# (the compound family), it is re-checked over every pooled sample;
# the cheap-path assertions set no cap, so for them the majority vote
# is the only guard. A breach of the per-sample cap is not
# median-only and fails at once, as does a hook error or timeout
# (exit 2 from the harness below).
#
# Confirmation only decorrelates contention that varies within its
# window: the batches run back-to-back, seconds apart, so a host that
# stays slow across all three batches — the common slow-runner draw,
# and what the 2026-10-22 incident's job-wide elevation resembled —
# still fails. That is the conservative direction, but it means this
# mechanism does not by itself rescue a job-long slow runner. Where
# a cap is set, re-checking it over 27 samples instead of 9 is a
# stricter test than the original (more chances to sample a tail
# event); warmup runs are excluded from both the medians and the
# pooled maximum, as they always were.
#
# The 2026-10-30 incident was exactly that gap: a CentOS Stream
# runner measured pre-bash hook medians of 266.4ms against a 250ms
# budget on all 27 samples, while the same run's Ubuntu job measured
# 64.1ms and the same head's push-run CentOS job measured 64.1ms —
# a job-long ~4x host slowdown, not a hook regression. The absolute
# budget therefore also scales by a same-host spawn calibration:
# each assertion first times `bash -c true` (same env, cwd, warmups,
# sample shape; median of three batch medians, like the hook vote)
# and multiplies the budget by max(1, calibration / reference),
# clamped at 10x, where the reference is the typical spawn latency
# on a healthy hosted runner (3.0ms, a single-host local
# measurement; override with AGENTGUARD_PERF_SPAWN_REF_MS, validated
# numeric, finite, and > 0 before any calibration spawn, else
# exit 2). The factor never tightens the budget below its stated
# value, so a fast host judges the hook exactly as before.
#
# Limits of this calibration, stated plainly:
# - The probe is a timing proxy, not the hook interpreter: it runs
#   `bash` resolved via ambient PATH, while hooks run via their
#   shebang and the launcher's fixed interpreter list (Homebrew bash
#   on macOS, `-p` mode not replicated). The probe executes no hook
#   code, only the `true` builtin, and the hook itself is still
#   invoked by absolute path — but the verdict trusts the timing of
#   a PATH-selected binary, bounded by the 10x clamp.
# - No spawn measurement exists from the 2026-10-30 CentOS job, so
#   "this would have rescued that run" is inference from the
#   hook-median ratio, not evidence: the model assumes hook cost
#   scales with spawn cost. A fixed-cost regression is diluted by
#   the factor (a +236ms regression on a 4x host passes a 4x-scaled
#   budget), and slowness arriving after calibration is not rescued
#   at all; load during calibration inflates budgets in the
#   false-pass direction.
# - The 3.0ms reference sits inside the calibration noise band
#   (single-host batches measured 1.8-4.3ms), so a healthy platform
#   with higher spawn (macOS fork/exec, older kernels) sees
#   permanent budget inflation; the factor is printed on every
#   PASS/FAIL line so that inflation is visible, and per-platform
#   baselines are future work.
# - Per-sample caps stay absolute (see below), so a host slower
#   than ~6x may still fail on a tail cap even when its medians
#   pass.
# This is not a retry and not a raised budget: the measurement
# itself is made host-relative, so runner speed cancels out of the
# median verdict. The residual trade-off is unchanged in kind:
# timing alone cannot tell a hook regression that coincides with
# host slowness from host slowness alone, and a regression confined
# to one batch can still be outvoted — both accepted above.
#
# Cost bound: a breached assertion runs calibration (3 batches) plus
# 3 hook batches of (2 warmups + `iterations` samples), each run
# capped by the per-run timeout, so one assertion costs at most
# 6 * (2 + iterations) * timeout (~132s at the defaults of 9
# samples and a 2s timeout, ~22 minutes if all ten timed
# assertions breach).
# A passing assertion costs calibration plus one hook batch. Small
# AGENTGUARD_PERF_ITERATIONS degrades the calibration (median of
# three singletons at 1); the default 9 is assumed. Calibration on
# an extremely slow host times out to exit 2, fail-closed — the
# timeout-shaped hole in the rescue. Never call this from a
# backgrounded or parallel context: a wall-clock median is only
# meaningful when the suite owns the host, which is why
# `test/agentguard-test` runs this suite exclusively, ahead of the
# parallel pool and last among the exclusive suites.
_assert_hook_median_under() {
  local desc="$1" hook="$2" input="$3"
  local max_ms="${4:-${AGENTGUARD_PERF_MAX_MEDIAN_MS:-250}}"
  local max_sample_ms="${5:-0}"
  local output status

  output=$(
    python3 - "$hook" "$input" "$max_ms" "$max_sample_ms" "$TEST_TMPDIR" "$TEST_SID" <<'PY'
import math
import os
import statistics
import subprocess
import sys
import time

hook, hook_input, max_ms_arg, max_sample_ms_arg, tmpdir, sid = sys.argv[1:]
max_ms = float(max_ms_arg)
max_sample_limit_ms = float(max_sample_ms_arg)
iterations = int(os.environ.get("AGENTGUARD_PERF_ITERATIONS", "9"))
timeout = float(os.environ.get("AGENTGUARD_PERF_TIMEOUT_SEC", "2"))
if iterations < 1 or timeout <= 0:
    print(
        "invalid perf overrides: "
        f"AGENTGUARD_PERF_ITERATIONS={iterations}, "
        f"AGENTGUARD_PERF_TIMEOUT_SEC={timeout}"
    )
    sys.exit(2)

env = os.environ.copy()
env.update({
    "AGENTGUARD_SESSION_ID": sid,
    "TMPDIR": tmpdir,
    "AGENTGUARD_NAME": "agent",
    "CODEX_THREAD_ID": "",
    "NO_COLOR": "1",
    "AGENTGUARD_HIVE_MEMORY_HOOKS": "0",
    "AGENTGUARD_PROCESS_DETECT": "0",
})
for key in (
    "CLAUDE_CODE_SESSION_ID",
    "CLAUDE_CODE_CURRENT_SESSION_ID",
    "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
    "GEMINI_PROJECT_DIR",
    "AGENTGUARD_PROTECTED_BARE_GIT_DIR",
    "AGENTGUARD_PROTECTED_BARE_GIT_WORK_TREE",
    "AGENTGUARD_PROTECTED_BARE_GIT_ALIASES",
    "AGENTGUARD_PROTECTED_BARE_GIT_LAUNCHER",
):
    env.pop(key, None)

cwd = os.environ.get("AGENTGUARD_ROOT")
payload = hook_input.encode()

def run_once_for(cmd, data, label):
    started = time.perf_counter()
    try:
        completed = subprocess.run(
            cmd,
            input=data,
            cwd=cwd,
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired:
        print(f"{label} timed out after {timeout:.1f}s")
        sys.exit(2)
    except OSError as error:
        # A missing or unexecutable interpreter is a harness failure,
        # not a slow hook: fail closed instead of a bare traceback.
        print(f"{label} failed to spawn: {error}")
        sys.exit(2)

    elapsed_ms = (time.perf_counter() - started) * 1000
    if completed.returncode != 0:
        print(f"{label} exited {completed.returncode} after {elapsed_ms:.1f}ms")
        sys.exit(2)
    return elapsed_ms

def run_batch_for(cmd, data, label):
    # Two warmup runs per batch, excluded from the samples (as the
    # original single-batch harness did), then `iterations` samples.
    # Every batch — the first and both confirmation batches — reuses
    # the same iteration count.
    for _ in range(2):
        run_once_for(cmd, data, label)
    samples = [run_once_for(cmd, data, label) for _ in range(iterations)]
    return statistics.median(samples), max(samples)

def run_batch():
    return run_batch_for([hook], payload, "hook")

# Host-relative calibration. Spawn latency is itself noisy (a few
# ms of jitter is a large fraction of a ~3ms spawn), so — like the
# hook medians — the calibration is the median of three batch
# medians, not a single batch: one contention window cannot set the
# factor alone. The factor is clamped at 10x: beyond that the host
# is too wedged for timing to judge anything, and an unbounded
# factor would let a bad calibration (a PATH shim, a load spike)
# inflate every budget into vacuity. The clamp is reported in the
# calibration note.
spawn_ref_raw = os.environ.get("AGENTGUARD_PERF_SPAWN_REF_MS", "3.0")
try:
    spawn_ref_ms = float(spawn_ref_raw)
except ValueError:
    spawn_ref_ms = 0.0
if not math.isfinite(spawn_ref_ms) or spawn_ref_ms <= 0:
    print(
        "invalid perf override: "
        f"AGENTGUARD_PERF_SPAWN_REF_MS={spawn_ref_raw}"
    )
    sys.exit(2)
calibration_batches = [
    run_batch_for(["bash", "-c", "true"], b"", "calibration")[0]
    for _ in range(3)
]
calibration_ms = statistics.median(calibration_batches)
raw_factor = calibration_ms / spawn_ref_ms
host_factor = min(10.0, max(1.0, raw_factor))
effective_max_ms = max_ms * host_factor
# Per-sample caps stay absolute: they guard against single
# pathological samples, which are not spawn-proportional the way a
# median is. A median-derived factor is the wrong scaler for a
# maximum, so scaling the cap would let a multi-second spike pass
# on a slow host. The trade-off is that on a host slower than ~6x,
# a typical maximum can exceed the absolute cap and fail the
# assertion even though its medians pass — the median verdict is
# rescued, the tail guard is not.
cap_ms = max_sample_limit_ms
calibration_note = (
    f"spawn calibration {calibration_ms:.1f}ms, host factor {host_factor:.2f}x, "
    f"effective budget {effective_max_ms:.1f}ms"
)
if host_factor < raw_factor:
    calibration_note += " (factor clamped at 10.00x)"

median_ms, max_sample_ms = run_batch()
summary = (
    f"median {median_ms:.1f}ms <= {effective_max_ms:.1f}ms "
    f"({calibration_note}; max sample {max_sample_ms:.1f}ms, n={iterations})"
)
within_tail_limit = cap_ms <= 0 or max_sample_ms <= cap_ms
if median_ms <= effective_max_ms and within_tail_limit:
    print(summary)
    sys.exit(0)
if not within_tail_limit:
    # A per-sample cap breach is a tail failure, not a noisy median:
    # it is never eligible for the confirmation batches below.
    print(summary)
    sys.exit(1)

# Median-only breach: collect two confirmation batches and judge the
# median of the three batch medians. The first batch remains a vote and,
# where a per-sample cap is set, it is re-checked against the pooled
# maximum, so one fast batch cannot outvote two slow ones and no sample
# is discarded.
batch_medians = [median_ms]
pooled_max_ms = max_sample_ms
try:
    for _ in range(2):
        batch_median_ms, batch_max_ms = run_batch()
        batch_medians.append(batch_median_ms)
        pooled_max_ms = max(pooled_max_ms, batch_max_ms)
except SystemExit:
    # A hook error or timeout in a confirmation batch: keep the
    # context the bare error line would otherwise destroy, then let
    # the original exit status stand.
    print(
        f"initial median {median_ms:.1f}ms vs {effective_max_ms:.1f}ms budget "
        f"({calibration_note}); "
        f"confirmation aborted, batch medians so far "
        f"[{', '.join(f'{value:.1f}' for value in batch_medians)}]ms "
        f"(hook error or timeout reported above)"
    )
    raise
median_of_medians_ms = statistics.median(batch_medians)
within_tail_limit = (
    cap_ms <= 0 or pooled_max_ms <= cap_ms
)
# Neutral wording on this path: the first batch breached by
# definition, so no statistic is printed with a "<=" it does not
# satisfy; the _pass/_fail prefix carries the verdict.
print(
    f"initial median {median_ms:.1f}ms vs {effective_max_ms:.1f}ms budget "
    f"({calibration_note}; max sample {max_sample_ms:.1f}ms, n={iterations}); "
    f"confirmation batch medians "
    f"[{', '.join(f'{value:.1f}' for value in batch_medians)}]ms, "
    f"median-of-medians {median_of_medians_ms:.1f}ms "
    f"vs {effective_max_ms:.1f}ms budget "
    f"(pooled max sample {pooled_max_ms:.1f}ms, n={iterations * 3})"
)
sys.exit(
    0
    if median_of_medians_ms <= effective_max_ms and within_tail_limit
    else 1
)
PY
  )
  status=$?

  if [[ "$status" -eq 0 ]]; then
    _pass "$desc: $output"
  else
    _fail "$desc: $output"
  fi
}

echo ""
echo "=== hook performance: cheap paths ==="

compound_command=""
for _ in {1..6}; do
  [[ -z "$compound_command" ]] || compound_command+=" && "
  compound_command+="echo x && printf y && pwd"
done
compound_command+=" && PERF_VAR=value true && git status --short"
compound_input=$(jq -cn --arg command "$compound_command" \
  '{tool_input:{command:$command}}')

quoted_compound_command=""
for _ in {1..20}; do
  [[ -z "$quoted_compound_command" ]] || quoted_compound_command+=" && "
  quoted_compound_command+="printf '%s\\n' x"
done
quoted_compound_input=$(jq -cn --arg command "$quoted_compound_command" \
  '{tool_input:{command:$command}}')

quoted_scan_log="$TEST_TMPDIR/quoted-compound-scans"
quoted_scan_counts=$(
  bash -s -- \
    "$AGENTGUARD_ROOT/lib/agentguard/hook-command-classifier.sh" \
    "$quoted_compound_command" \
    "$quoted_scan_log" <<'BASH'
classifier=$1
command_text=$2
scan_log=$3
# shellcheck disable=SC1090 # production classifier path supplied by the test.
source "$classifier"

eval "$(declare -f _structural_shell_payloads | sed '1s/_structural_shell_payloads/_perf_original_structural_shell_payloads/')"
eval "$(declare -f _nested_shell_payloads | sed '1s/_nested_shell_payloads/_perf_original_nested_shell_payloads/')"
eval "$(declare -f _env_split_payloads | sed '1s/_env_split_payloads/_perf_original_env_split_payloads/')"
eval "$(declare -f _fragment_command_word | sed '1s/_fragment_command_word/_perf_original_fragment_command_word/')"

_structural_shell_payloads() {
  printf 'structural\n' >>"$scan_log"
  _perf_original_structural_shell_payloads "$@"
}
_nested_shell_payloads() {
  printf 'nested\n' >>"$scan_log"
  _perf_original_nested_shell_payloads "$@"
}
_env_split_payloads() {
  printf 'env\n' >>"$scan_log"
  _perf_original_env_split_payloads "$@"
}
_fragment_command_word() {
  printf 'command_word\n' >>"$scan_log"
  _perf_original_fragment_command_word "$@"
}

: >"$scan_log"
_hook_cache_executable_fragments "$command_text"
printf 'structural=%s nested=%s env=%s command_word=%s\n' \
  "$(awk '$0 == "structural" { count++ } END { print count + 0 }' "$scan_log")" \
  "$(awk '$0 == "nested" { count++ } END { print count + 0 }' "$scan_log")" \
  "$(awk '$0 == "env" { count++ } END { print count + 0 }' "$scan_log")" \
  "$(awk '$0 == "command_word" { count++ } END { print count + 0 }' "$scan_log")"
BASH
)
rm -f "$quoted_scan_log"
_assert_eq \
  "quoted direct fragments skip recursive payload and command-word subprocesses" \
  "structural=0 nested=0 env=0 command_word=0" \
  "$quoted_scan_counts"

nested_compound_command="$compound_command && bash -lc 'printf nested'"
nested_compound_input=$(jq -cn --arg command "$nested_compound_command" \
  '{tool_input:{command:$command}}')

_assert_hook_median_under \
  "pre-bash true stays fast" \
  "$PRE_BASH" \
  '{"tool_input":{"command":"true"}}'

_assert_hook_median_under \
  "pre-bash git status fast path stays fast" \
  "$PRE_BASH" \
  '{"tool_input":{"command":"git status --short"}}'

_assert_hook_median_under \
  "pre-edit empty payload stays fast" \
  "$PRE_EDIT" \
  '{"tool_input":{}}'

_assert_hook_median_under \
  "pre-mcp benign payload stays fast" \
  "$PRE_MCP" \
  '{"tool_name":"functions.exec_command","tool_input":{"cmd":"true"}}'

# Post-bash classifies only commands that pair `git`/`gh` with `push`/`pr` on
# one line; everything else, including long text mentioning those words, must
# stay off the classifier path.
POST_BASH_HOOK="$BIN_DIR/agent-hook-post-bash"
post_bash_heredoc=$(
  printf 'python3 - <<EOF\n'
  for _i in $(seq 1 80); do printf '# note %s: check git state, then push docs\n' "$_i"; done
  printf 'EOF'
)
post_bash_heredoc_input=$(jq -cn --arg command "$post_bash_heredoc" \
  '{tool_input:{command:$command},tool_response:{stdout:"",exit_code:0}}')

_assert_hook_median_under \
  "post-bash ordinary command stays fast" \
  "$POST_BASH_HOOK" \
  '{"tool_input":{"command":"ls"},"tool_response":{"stdout":"a b","exit_code":0}}'

_assert_hook_median_under \
  "post-bash push-named non-push command stays fast" \
  "$POST_BASH_HOOK" \
  '{"tool_input":{"command":"npm run push-docs"},"tool_response":{"stdout":"","exit_code":0}}'

_assert_hook_median_under \
  "post-bash long text mentioning git and push stays fast" \
  "$POST_BASH_HOOK" \
  "$post_bash_heredoc_input"

# This synthetic 20-fragment path varied from 248ms to 513ms for the same hook
# revision on hosted macOS runners. Keep enough host-load headroom to catch
# gross classification regressions without failing on runner variance.
_assert_hook_median_under \
  "pre-bash safe compound command stays fast" \
  "$PRE_BASH" \
  "$compound_input" \
  "${AGENTGUARD_PERF_COMPOUND_MAX_MEDIAN_MS:-600}" \
  "${AGENTGUARD_PERF_COMPOUND_MAX_SAMPLE_MS:-1500}"

_assert_hook_median_under \
  "pre-bash quoted-argument compound command stays fast" \
  "$PRE_BASH" \
  "$quoted_compound_input" \
  "${AGENTGUARD_PERF_QUOTED_COMPOUND_MAX_MEDIAN_MS:-500}" \
  "${AGENTGUARD_PERF_QUOTED_COMPOUND_MAX_SAMPLE_MS:-1500}"

_assert_hook_median_under \
  "pre-bash compound command keeps nested fallback bounded" \
  "$PRE_BASH" \
  "$nested_compound_input" \
  "${AGENTGUARD_PERF_NESTED_MAX_MEDIAN_MS:-750}" \
  "${AGENTGUARD_PERF_NESTED_MAX_SAMPLE_MS:-1800}"

_test_summary

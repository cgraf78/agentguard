#!/usr/bin/env bash
# agent-hook-performance-test - gross latency budgets for cheap hook paths.

# shellcheck disable=SC1090,SC1091 # dynamic helper path resolved at runtime.
AGENTGUARD_TEST_HELPERS="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/agent-hook-helpers.sh"
. "$AGENTGUARD_TEST_HELPERS"

_assert_hook_median_under() {
  local desc="$1" hook="$2" input="$3"
  local max_ms="${4:-${AGENTGUARD_PERF_MAX_MEDIAN_MS:-250}}"
  local max_sample_ms="${5:-0}"
  local output status

  output=$(
    python3 - "$hook" "$input" "$max_ms" "$max_sample_ms" "$TEST_TMPDIR" "$TEST_SID" <<'PY'
import os
import statistics
import subprocess
import sys
import time

hook, hook_input, max_ms_arg, max_sample_ms_arg, tmpdir, sid = sys.argv[1:]
max_ms = float(max_ms_arg)
max_sample_limit_ms = float(max_sample_ms_arg)
iterations = int(os.environ.get("AGENTGUARD_PERF_ITERATIONS", "9"))
timeout = float(os.environ.get("AGENTGUARD_PERF_TIMEOUT_SEC", "2"))

env = os.environ.copy()
env.update({
    "AGENTGUARD_SESSION_ID": sid,
    "TMPDIR": tmpdir,
    "AGENTGUARD_NAME": "agent",
    "CODEX_THREAD_ID": "",
    "NO_COLOR": "1",
    "AGENTGUARD_HIVE_MEMORY_HOOKS": "0",
    "AGENTGUARD_PROCESS_DETECT": "0",
})
for key in (
    "CLAUDE_CODE_SESSION_ID",
    "CLAUDE_CODE_CURRENT_SESSION_ID",
    "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
    "GEMINI_PROJECT_DIR",
    "AGENTGUARD_PROTECTED_BARE_GIT_DIR",
    "AGENTGUARD_PROTECTED_BARE_GIT_WORK_TREE",
    "AGENTGUARD_PROTECTED_BARE_GIT_ALIASES",
    "AGENTGUARD_PROTECTED_BARE_GIT_LAUNCHER",
):
    env.pop(key, None)

cwd = os.environ.get("AGENTGUARD_ROOT")
samples = []
payload = hook_input.encode()

def run_once():
    started = time.perf_counter()
    try:
        completed = subprocess.run(
            [hook],
            input=payload,
            cwd=cwd,
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired:
        print(f"timed out after {timeout:.1f}s")
        sys.exit(2)

    elapsed_ms = (time.perf_counter() - started) * 1000
    if completed.returncode != 0:
        print(f"hook exited {completed.returncode} after {elapsed_ms:.1f}ms")
        sys.exit(2)
    return elapsed_ms

for _ in range(2):
    run_once()

for _ in range(iterations):
    samples.append(run_once())

median_ms = statistics.median(samples)
max_sample_ms = max(samples)
summary = (
    f"median {median_ms:.1f}ms <= {max_ms:.1f}ms "
    f"(max sample {max_sample_ms:.1f}ms, n={iterations})"
)
print(summary)
within_tail_limit = max_sample_limit_ms <= 0 or max_sample_ms <= max_sample_limit_ms
sys.exit(0 if median_ms <= max_ms and within_tail_limit else 1)
PY
  )
  status=$?

  if [[ "$status" -eq 0 ]]; then
    _pass "$desc: $output"
  else
    _fail "$desc: $output"
  fi
}

echo ""
echo "=== hook performance: cheap paths ==="

compound_command=""
for _ in {1..6}; do
  [[ -z "$compound_command" ]] || compound_command+=" && "
  compound_command+="echo x && printf y && pwd"
done
compound_command+=" && PERF_VAR=value true && git status --short"
compound_input=$(jq -cn --arg command "$compound_command" \
  '{tool_input:{command:$command}}')

quoted_compound_command=""
for _ in {1..20}; do
  [[ -z "$quoted_compound_command" ]] || quoted_compound_command+=" && "
  quoted_compound_command+="printf '%s\\n' x"
done
quoted_compound_input=$(jq -cn --arg command "$quoted_compound_command" \
  '{tool_input:{command:$command}}')

quoted_scan_log="$TEST_TMPDIR/quoted-compound-scans"
quoted_scan_counts=$(
  bash -s -- \
    "$AGENTGUARD_ROOT/lib/agentguard/hook-command-classifier.sh" \
    "$quoted_compound_command" \
    "$quoted_scan_log" <<'BASH'
classifier=$1
command_text=$2
scan_log=$3
# shellcheck disable=SC1090 # production classifier path supplied by the test.
source "$classifier"

eval "$(declare -f _structural_shell_payloads | sed '1s/_structural_shell_payloads/_perf_original_structural_shell_payloads/')"
eval "$(declare -f _nested_shell_payloads | sed '1s/_nested_shell_payloads/_perf_original_nested_shell_payloads/')"
eval "$(declare -f _env_split_payloads | sed '1s/_env_split_payloads/_perf_original_env_split_payloads/')"
eval "$(declare -f _fragment_command_word | sed '1s/_fragment_command_word/_perf_original_fragment_command_word/')"

_structural_shell_payloads() {
  printf 'structural\n' >>"$scan_log"
  _perf_original_structural_shell_payloads "$@"
}
_nested_shell_payloads() {
  printf 'nested\n' >>"$scan_log"
  _perf_original_nested_shell_payloads "$@"
}
_env_split_payloads() {
  printf 'env\n' >>"$scan_log"
  _perf_original_env_split_payloads "$@"
}
_fragment_command_word() {
  printf 'command_word\n' >>"$scan_log"
  _perf_original_fragment_command_word "$@"
}

: >"$scan_log"
_hook_cache_executable_fragments "$command_text"
printf 'structural=%s nested=%s env=%s command_word=%s\n' \
  "$(awk '$0 == "structural" { count++ } END { print count + 0 }' "$scan_log")" \
  "$(awk '$0 == "nested" { count++ } END { print count + 0 }' "$scan_log")" \
  "$(awk '$0 == "env" { count++ } END { print count + 0 }' "$scan_log")" \
  "$(awk '$0 == "command_word" { count++ } END { print count + 0 }' "$scan_log")"
BASH
)
rm -f "$quoted_scan_log"
_assert_eq \
  "quoted direct fragments skip recursive payload and command-word subprocesses" \
  "structural=0 nested=0 env=0 command_word=0" \
  "$quoted_scan_counts"

nested_compound_command="$compound_command && bash -lc 'printf nested'"
nested_compound_input=$(jq -cn --arg command "$nested_compound_command" \
  '{tool_input:{command:$command}}')

_assert_hook_median_under \
  "pre-bash true stays fast" \
  "$PRE_BASH" \
  '{"tool_input":{"command":"true"}}'

_assert_hook_median_under \
  "pre-bash git status fast path stays fast" \
  "$PRE_BASH" \
  '{"tool_input":{"command":"git status --short"}}'

_assert_hook_median_under \
  "pre-edit empty payload stays fast" \
  "$PRE_EDIT" \
  '{"tool_input":{}}'

_assert_hook_median_under \
  "pre-mcp benign payload stays fast" \
  "$PRE_MCP" \
  '{"tool_name":"functions.exec_command","tool_input":{"cmd":"true"}}'

# This synthetic 20-fragment path varied from 248ms to 513ms for the same hook
# revision on hosted macOS runners. Keep enough host-load headroom to catch
# gross classification regressions without failing on runner variance.
_assert_hook_median_under \
  "pre-bash safe compound command stays fast" \
  "$PRE_BASH" \
  "$compound_input" \
  "${AGENTGUARD_PERF_COMPOUND_MAX_MEDIAN_MS:-600}" \
  "${AGENTGUARD_PERF_COMPOUND_MAX_SAMPLE_MS:-1500}"

_assert_hook_median_under \
  "pre-bash quoted-argument compound command stays fast" \
  "$PRE_BASH" \
  "$quoted_compound_input" \
  "${AGENTGUARD_PERF_QUOTED_COMPOUND_MAX_MEDIAN_MS:-500}" \
  "${AGENTGUARD_PERF_QUOTED_COMPOUND_MAX_SAMPLE_MS:-1500}"

_assert_hook_median_under \
  "pre-bash compound command keeps nested fallback bounded" \
  "$PRE_BASH" \
  "$nested_compound_input" \
  "${AGENTGUARD_PERF_NESTED_MAX_MEDIAN_MS:-750}" \
  "${AGENTGUARD_PERF_NESTED_MAX_SAMPLE_MS:-1800}"

_test_summary

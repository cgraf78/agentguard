await check("bounds and briefly caches an unavailable MCP status endpoint", async () => {
  clearLog();
  const savedConsoleError = console.error;
  const errors = [];
  let statusCalls = 0;
  let hooks;
  console.error = (...args) => errors.push(args.join(" "));
  try {
    hooks = await plugin(
      { mcp: { fallback: { type: "local" } } },
      {
        mcp: {
          status: () => {
            statusCalls += 1;
            return new Promise(() => {});
          },
        },
      },
    );
    const started = Date.now();
    await hooks["tool.execute.before"](
      { tool: "fallback_lookup", sessionID: "status-timeout", callID: "status-timeout-1" },
      { args: { query: "one" } },
    );
    assert.equal(Date.now() - started < 2_500, true);
    await hooks["tool.execute.before"](
      { tool: "fallback_other", sessionID: "status-timeout", callID: "status-timeout-2" },
      { args: { query: "two" } },
    );
    assert.equal(statusCalls, 1);
    assert.deepEqual(
      logs()
        .filter((item) => item.hook === "agent-hook-pre-mcp")
        .map((item) => item.payload.tool_name),
      ["mcp__fallback__lookup", "mcp__fallback__other"],
    );
    assert.equal(
      errors.filter((message) => message.includes("MCP status timed out")).length,
      1,
    );
  } finally {
    console.error = savedConsoleError;
    await hooks?.dispose();
  }
});


await check("routes terminal MCP failures through the post hook", async () => {
  clearLog();
  let hooks;
  behavior("agent-hook-pre-mcp", { stdout: JSON.stringify({ context: "pre failure context" }) });
  behavior("agent-hook-post-mcp", {
    stdout: JSON.stringify({ context: "post failure context" }),
  });
  try {
    hooks = await plugin({ mcp: { docs: { type: "local" } } });
    const failures = [
      ["protocol-error-call", "MCP server returned an error result"],
      ["transport-error-call", "MCP transport closed before a response"],
    ];
    for (const [callID, error] of failures) {
      const input = { query: callID };
      await hooks["tool.execute.before"](
        { tool: "docs_lookup", sessionID: "terminal-mcp", callID },
        { args: input },
      );
      void hooks.event({
        event: toolErrorEvent({
          sessionID: "terminal-mcp",
          callID,
          tool: "docs_lookup",
          input,
          error,
          metadata: { source: "mcp" },
        }),
      });
    }

    const output = { message: {}, parts: [{ type: "text", text: "continue" }] };
    await hooks["chat.message"]({ sessionID: "terminal-mcp", agent: "build" }, output);

    const posts = logs().filter((record) => record.hook === "agent-hook-post-mcp");
    assert.equal(posts.length, 2);
    assert.deepEqual(
      posts.map((record) => record.payload.tool_response.output),
      failures.map(([, error]) => error),
    );
    assert.ok(posts.every((record) => record.payload.tool_result_is_error === true));
    assert.ok(posts.every((record) => record.payload.tool_response.metadata.source === "mcp"));
    assert.match(output.message.system, /pre failure context/);
    assert.match(output.message.system, /post failure context/);
  } finally {
    await hooks?.dispose();
    clearBehavior("agent-hook-pre-mcp");
    clearBehavior("agent-hook-post-mcp");
  }
});


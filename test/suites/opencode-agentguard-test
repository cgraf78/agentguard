import fs from "node:fs";
import { AgentGuardPlugin } from "./agentguard.js";

export const CharacterizationPlugin = async (input) => {
  const hooks = await AgentGuardPlugin(input);
  if (
    typeof hooks.config !== "function" ||
    typeof hooks["shell.env"] !== "function" ||
    typeof hooks["tool.execute.before"] !== "function"
  ) {
    throw new Error("AgentGuard adapter returned an incomplete hook surface");
  }
  // `opencode debug config` invokes returned config callbacks. Write the marker
  // there, rather than during module import, so CI proves the pinned public

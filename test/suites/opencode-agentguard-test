async function v2(overrides = {}) {
  const registered = new Map();
  let disposals = 0;
  const registration = () => ({ dispose: async () => { disposals += 1; } });
  const hook = (domain) => async (name, callback) => {
    registered.set(`${domain}.${name}`, callback);
    return registration();
  };
  const signals = [];
  const ctx = {
    location: { directory: sourceDirectory },
    tool: { hook: hook("tool"), transform: async (edit) => { edit({ list: () => [], update() {} }); return registration(); } },
    shell: { hook: hook("shell") },
    session: { hook: hook("session"), get: async () => ({ agent: "build", location: { directory: sourceDirectory } }) },
    permission: { hook: hook("permission") },
    mcp: { list: async () => ({ data: [{ name: "dynamic", status: { status: "connected" } }] }) },
    event: { subscribe: ({ signal }) => ({ async *[Symbol.asyncIterator]() {
      signals.push(signal);
      await new Promise((resolve) => signal.addEventListener("abort", resolve, { once: true }));
    } }) },
    ...overrides,
  };
  const dispose = await AgentGuardV2.setup(ctx);
  return { ctx, registered, signals, dispose, disposals: () => disposals };
}


#!/usr/bin/env bash
# OpenCode AgentGuard adapter integration tests.

set -u

if ! command -v node >/dev/null 2>&1; then
  echo "SKIP: opencode-agentguard-test (node unavailable)"
  exit 0
fi

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
root="${test_dir%/test/suites}"
test_root=$(mktemp -d 2>/dev/null || mktemp -d -t opencode-agentguard-test) || exit 1
trap 'rm -rf "$test_root"' EXIT

fixture_home="$test_root/home"
fixture_bin="$fixture_home/.local/bin"
behavior_dir="$test_root/behaviors"
hook_log="$test_root/hooks.jsonl"
mkdir -p "$fixture_bin" "$behavior_dir"

cp "$root/share/agentguard/integrations/opencode/agentguard.js" "$test_root/agentguard.mjs"

cat >"$test_root/hook-fixture.mjs" <<'HOOK_FIXTURE'
#!/usr/bin/env node

import fs from "node:fs";
import path from "node:path";
import { spawn } from "node:child_process";

const hook = path.basename(process.argv[1]);
const input = await new Promise((resolve) => {
  let data = "";
  process.stdin.setEncoding("utf8");
  process.stdin.on("data", (chunk) => {
    data += chunk;
  });
  process.stdin.on("end", () => resolve(data));
});
const payload = input.trim() ? JSON.parse(input) : {};
const behaviorPath = path.join(process.env.AGENTGUARD_TEST_HOOK_BEHAVIOR_DIR, `${hook}.json`);
const behavior = fs.existsSync(behaviorPath)
  ? JSON.parse(fs.readFileSync(behaviorPath, "utf8"))
  : {};

fs.appendFileSync(
  process.env.AGENTGUARD_TEST_HOOK_LOG,
  `${JSON.stringify({
    hook,
    payload,
    cwd: process.cwd(),
    name: process.env.AGENTGUARD_NAME,
    session: process.env.AGENTGUARD_SESSION_ID,
    bashEnv: process.env.BASH_ENV,
    posixEnv: process.env.ENV,
    bashFunction: process.env["BASH_FUNC_agentguard_test%%"],
    bashOptions: process.env.BASHOPTS,
    shellOptions: process.env.SHELLOPTS,
    bashCompat: process.env.BASH_COMPAT,
    bashXtraceFd: process.env.BASH_XTRACEFD,
    functionDepth: process.env.FUNCNEST,
    posixMode: process.env.POSIXLY_CORRECT,
  })}\n`,
);

if (behavior.descendantPidFile) {
  spawn(
    process.execPath,
    [
      "-e",
      'const fs = require("node:fs"); fs.writeFileSync(process.argv[1], String(process.pid)); setTimeout(() => {}, 30000);',
      behavior.descendantPidFile,
    ],
    { stdio: "ignore" },
  );
  // Do not let the hook leader exit until the regression can prove its
  // descendant really existed. Waiting on the file is deterministic on loaded
  // CI hosts and prevents a cleanup test from passing because the child simply
  // had not been scheduled before the leader exited.
  const descendantDeadline = Date.now() + 5_000;
  while (!fs.existsSync(behavior.descendantPidFile) && Date.now() < descendantDeadline) {
    await new Promise((resolve) => setTimeout(resolve, 10));
  }
  if (!fs.existsSync(behavior.descendantPidFile)) {
    throw new Error("descendant did not publish its PID");
  }
}

if (behavior.delayMs) {
  await new Promise((resolve) => setTimeout(resolve, behavior.delayMs));
}

let stdout = behavior.stdout ?? "{}";
if (behavior.echoCommand) {
  stdout = JSON.stringify({ context: payload.tool_input?.command ?? "" });
}
if (behavior.stderr) process.stderr.write(behavior.stderr);
if (stdout) process.stdout.write(stdout);
process.exit(behavior.exit ?? 0);
HOOK_FIXTURE
chmod +x "$test_root/hook-fixture.mjs"

for hook in \
  agent-hook-session-start \
  agent-hook-prompt-submit \
  agent-hook-pre-bash \
  agent-hook-post-bash \
  agent-hook-pre-edit \
  agent-hook-post-edit \
  agent-hook-pre-mcp \
  agent-hook-post-mcp \
  agent-hook-notification \
  agent-hook-stop \
  agent-hook-session-end; do
  ln -s "$test_root/hook-fixture.mjs" "$fixture_bin/$hook"
done

cat >"$test_root/test.mjs" <<'TEST_SCRIPT'
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import { pathToFileURL } from "node:url";

const root = process.env.AGENTGUARD_TEST_ROOT;
const home = process.env.AGENTGUARD_TEST_HOME;
const logPath = process.env.AGENTGUARD_TEST_HOOK_LOG;
const behaviorDir = process.env.AGENTGUARD_TEST_HOOK_BEHAVIOR_DIR;
const pluginPath = process.env.AGENTGUARD_TEST_PLUGIN;
const sourceDirectory = path.join(root, "workspace");
fs.mkdirSync(sourceDirectory, { recursive: true });
process.env.HOME = home;
const startupMarker = path.join(root, "hook-startup-env-ran");
const startupFile = path.join(root, "hostile-hook-startup-env");
fs.writeFileSync(startupFile, `printf 'ran\\n' >${JSON.stringify(startupMarker)}\n`);
process.env.BASH_ENV = startupFile;
process.env.ENV = startupFile;
process.env["BASH_FUNC_agentguard_test%%"] =
  `() { printf 'function-ran\\n' >${JSON.stringify(startupMarker)}; }`;
process.env.BASHOPTS = "extglob";
process.env.SHELLOPTS = "xtrace";
process.env.BASH_COMPAT = "5.2";
process.env.BASH_XTRACEFD = "9";
process.env.FUNCNEST = "1";
process.env.POSIXLY_CORRECT = "1";
// Give ordinary fixtures five seconds rather than the former one-second budget.
// The full AgentGuard runner executes suites in parallel, and both macOS CI and
// a loaded local run have taken multiple seconds to schedule a healthy Node
// child. Five seconds keeps default-hook failures prompt; the suite ceiling still
// bounds long-hook defects, while the case below tests fail-closed timeout behavior.
process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE = "0.5";

const { AgentGuardPlugin } = await import(`${pathToFileURL(pluginPath).href}?test=${Date.now()}`);

let passed = 0;
let failed = 0;

function behavior(hook, value) {
  fs.writeFileSync(path.join(behaviorDir, `${hook}.json`), JSON.stringify(value));
}

function clearBehavior(hook) {
  fs.rmSync(path.join(behaviorDir, `${hook}.json`), { force: true });
}

function clearLog() {
  fs.writeFileSync(logPath, "");
}

function logs() {
  const raw = fs.readFileSync(logPath, "utf8").trim();
  return raw ? raw.split("\n").map((line) => JSON.parse(line)) : [];
}

async function waitForProcessExit(pid, description) {
  const deadline = Date.now() + 5_000;
  while (Date.now() < deadline) {
    const result = spawnSync("ps", ["-o", "stat=", "-p", String(pid)], {
      encoding: "utf8",
    });
    const state = result.status === 0 ? result.stdout.trim() : "";
    // A zombie can no longer mutate state; its parent or init only needs to reap
    // the already-dead process. BSD and procps ps both place Z first in STAT.
    if (!state || state.startsWith("Z")) return;
    await new Promise((resolve) => setTimeout(resolve, 20));
  }
  assert.fail(`${description} process ${pid} survived cleanup`);
}

async function waitForPidFile(file, description, timeoutMs = 5_000) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    try {
      const contents = fs.readFileSync(file, "utf8").trim();
      if (/^[1-9][0-9]*$/.test(contents)) {
        const pid = Number(contents);
        if (Number.isSafeInteger(pid) && pid > 1) return pid;
      }
    } catch (error) {
      if (error?.code !== "ENOENT") throw error;
    }
    await new Promise((resolve) => setTimeout(resolve, 10));
  }
  assert.fail(`${description} did not publish a valid PID within ${timeoutMs}ms`);
}

async function plugin(config = {}, client) {
  const hooks = await AgentGuardPlugin({ directory: sourceDirectory, client });
  await hooks.config?.(config);
  return hooks;
}

function toolErrorEvent({ sessionID, callID, tool, input, error, metadata }) {
  return {
    type: "message.part.updated",
    properties: {
      sessionID,
      part: {
        id: `prt-${callID}`,
        messageID: `msg-${sessionID}`,
        sessionID,
        type: "tool",
        callID,
        tool,
        state: {
          status: "error",
          input,
          error,
          ...(metadata === undefined ? {} : { metadata }),
          time: { start: 1, end: 2 },
        },
      },
      time: 2,
    },
  };
}

async function check(name, fn) {
  try {
    await fn();
    passed += 1;
    console.log(`PASS: ${name}`);
  } catch (error) {
    failed += 1;
    console.error(`FAIL: ${name}`);
    console.error(error?.stack ?? String(error));
  }
}


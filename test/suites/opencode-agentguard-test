await check("fails closed when a protected hook closes stdin early", async () => {
  clearLog();
  const hookPath = path.join(home, ".local/bin/agent-hook-pre-edit");
  const hookScript = path.join(root, "close-input-hook.sh");
  const hookGroup = path.join(root, "closed-input-hook-group");
  const groupReady = path.join(root, "closed-input-group-ready");
  const separateReady = path.join(root, "closed-input-separate-ready");
  const darwinBin = path.join(root, "darwin-bin");
  const savedPath = process.env.PATH;
  fs.mkdirSync(darwinBin);
  fs.writeFileSync(path.join(darwinBin, "pkill"), "#!/bin/sh\nexit 2\n", {
    mode: 0o755,
  });
  fs.writeFileSync(
    hookScript,
    `#!/bin/sh
printf '%s\n' "$$" >"${hookGroup}"
python3 - "${groupReady}" "${separateReady}" <<'PY' &
import os
import pathlib
import sys
import time

def wait_for_cleanup(ready):
    identity = f"{os.getpid()} {os.getpgrp()}"
    pathlib.Path(ready).write_text(identity, encoding="utf-8")
    time.sleep(30)

# Exercise both cleanup layers. An ordinary descendant must die with the hook's
# process group; a helper that creates another process group must still be found
# by the broader private-session sweep used for macOS background jobs.
if os.fork() == 0:
    wait_for_cleanup(sys.argv[1])
    os._exit(0)
if os.fork() == 0:
    os.setpgrp()
    wait_for_cleanup(sys.argv[2])
    os._exit(0)
PY
while [ ! -s "${groupReady}" ] || [ ! -s "${separateReady}" ]; do
  sleep 0.01
done
exec 0<&-
sleep 5
`,
  );
  fs.chmodSync(hookScript, 0o755);
  fs.rmSync(hookPath);
  fs.symlinkSync(hookScript, hookPath);
  // Apple's pkill omits the session selector supported by procps-ng. Put an
  // equivalent invalid-usage result first on PATH so Linux catches any cleanup
  // implementation that silently relies on the non-portable `pkill -s`.
  process.env.PATH = `${darwinBin}${path.delimiter}${savedPath}`;
  try {
    const hooks = await plugin();
    await assert.rejects(
      hooks["tool.execute.before"](
        { tool: "edit", sessionID: "closed-input", callID: "closed-input-call" },
        {
          args: {
            filePath: "large",
            oldString: "",
            newString: "x".repeat(2 * 1024 * 1024),
          },
        },
      ),
      /input failed/i,
    );
    // The shell closes stdin only after both descendants publish their PIDs, so
    // these checks cannot pass merely because a busy runner had not scheduled
    // their creation. Poll process state instead of guessing at a write delay.
    assert.equal(fs.existsSync(groupReady), true);
    assert.equal(fs.existsSync(separateReady), true);
    const hookPgid = Number.parseInt(fs.readFileSync(hookGroup, "utf8"), 10);
    const [groupPid, groupPgid] = fs.readFileSync(groupReady, "utf8").split(" ").map(Number);
    const [separatePid, separatePgid] = fs
      .readFileSync(separateReady, "utf8")
      .split(" ")
      .map(Number);
    assert.equal(Number.isSafeInteger(hookPgid) && hookPgid > 1, true);
    assert.equal(Number.isSafeInteger(groupPid) && groupPid > 1, true);
    assert.equal(Number.isSafeInteger(groupPgid) && groupPgid > 1, true);
    assert.equal(Number.isSafeInteger(separatePid) && separatePid > 1, true);
    assert.equal(Number.isSafeInteger(separatePgid) && separatePgid > 1, true);
    assert.equal(groupPgid, hookPgid);
    assert.notEqual(separatePgid, hookPgid);
    await waitForProcessExit(groupPid, "ordinary descendant");
    await waitForProcessExit(separatePid, "separate-process-group descendant");
    await hooks.dispose();
  } finally {
    process.env.PATH = savedPath;
    fs.rmSync(hookPath);
    fs.symlinkSync(path.join(root, "hook-fixture.mjs"), hookPath);
  }
});


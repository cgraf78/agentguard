await check("V2 lifecycle envelopes drain Stop and SessionEnd once", async () => {
  clearLog();
  let publish;
  const messages = [];
  const host = await v2({ event: { subscribe: ({ signal }) => ({ async *[Symbol.asyncIterator]() {
    while (!signal.aborted) {
      if (!messages.length) await new Promise((resolve) => { publish = resolve; signal.addEventListener("abort", resolve, { once: true }); });
      if (messages.length) yield messages.shift();
    }
  } }) } });
  await host.registered.get("session.prompt")({ sessionID: "life-v2", prompt: { text: "task" } });
  for (const type of ["session.idle", "session.idle", "session.deleted"]) messages.push({ type, data: { sessionID: "life-v2" } });
  publish();
  const deadline = Date.now() + 3000;
  while (!logs().some((item) => item.hook === "agent-hook-session-end") && Date.now() < deadline) await new Promise((resolve) => setTimeout(resolve, 10));
  await host.dispose();
  assert.equal(logs().filter((item) => item.hook === "agent-hook-stop").length, 1);
  assert.equal(logs().filter((item) => item.hook === "agent-hook-session-end").length, 1);
});


await check("a V2 superseded turn does not suppress the next turn's Stop", async () => {
  clearLog();
  installRecorder();
  let publish;
  const messages = [];
  // SessionEnd lands during the stream's own session dispose; scale its drain
  // so a loaded runner cannot outlast it.
  const normalTimeoutScale = process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE;
  process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE = "3";
  let host;
  try {
    host = await v2({ event: { subscribe: ({ signal }) => ({ async *[Symbol.asyncIterator]() {
      while (!signal.aborted) {
        if (!messages.length) await new Promise((resolve) => { publish = resolve; signal.addEventListener("abort", resolve, { once: true }); });
        if (messages.length) yield messages.shift();
      }
    } }) } });
    const sessionID = "audit-v2-superseded";
    await host.registered.get("session.prompt")({ sessionID, prompt: { text: "first" } });
    // The replacing prompt is handled before the old turn's interruption
    // arrives on the stream, the order that exposed the race.
    await host.registered.get("session.prompt")({ sessionID, prompt: { text: "second" } });
    messages.push(
      { type: "session.execution.interrupted", data: { sessionID, reason: "superseded" } },
      { type: "session.idle", data: { sessionID } },
      { type: "session.deleted", data: { sessionID } },
    );
    publish();
    await waitForAudit(sessionID, "SessionEnd");
    const interrupt = await waitForAudit(sessionID, "Interrupt");
    assert.equal(interrupt.payload.reason, "superseded");
    await waitForAudit(sessionID, "Stop");
    assert.ok(logs().some((record) => record.hook === "agent-hook-stop" && record.session === sessionID));
  } finally {
    await host?.dispose();
    process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE = normalTimeoutScale;
    removeRecorder();
  }
});


await check("a hung recorder does not delay tools or decisions and unload is bounded", async () => {
  clearLog();
  const pidDir = fs.mkdtempSync(path.join(root, "hung-recorder-"));
  installRecorder({ mode: "hang", pidDir });
  // At this scale the recorder watchdog (30s) outlasts the worst case for
  // spawn, the 6s unload drain, and the exit poll together, so only unload's
  // own cleanup can stop the recorders in time, and only a bounded drain can
  // return before the watchdog.
  const normalTimeoutScale = process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE;
  process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE = "3";
  let hooks;
  let pids = [];
  try {
    hooks = await plugin();
    const call = { tool: "bash", sessionID: "audit-hang", callID: "audit-hang-call" };
    const args = { command: "echo fine" };
    const output = { title: "echo", output: "x".repeat(1024 * 1024), metadata: { exit: 0 } };
    await hooks["tool.execute.before"](call, { args });
    await hooks["tool.execute.after"]({ ...call, args }, output);
    assert.equal(output.output, "x".repeat(1024 * 1024));
    assert.equal(logs().filter((record) => record.payload.session_id === "audit-hang").length, 2);

    // Both callbacks have already returned. A recorder still alive now proves
    // they never waited for it, whatever the scheduler did. Only the
    // PreToolUse recorder exists: the PostToolUse one is queued behind it.
    pids = await waitForPids(pidDir, 1);
    for (const pid of pids) process.kill(pid, 0);

    const unloadStarted = Date.now();
    await hooks.dispose();
    hooks = undefined;
    assert.ok(Date.now() - unloadStarted < 15_000, "unload waited for the recorder watchdog");
    for (const pid of pids) await waitForProcessExit(pid, "hung recorder");
    // Unload cancelled the queued recorder rather than releasing it once the
    // hung one died. A spawn would publish its PID within this window.
    const observeUntil = Date.now() + 500;
    while (Date.now() < observeUntil) {
      assert.equal(pidsIn(pidDir).length, 1, "a cancelled recorder spawned after unload");
      await new Promise((resolve) => setTimeout(resolve, 20));
    }
  } finally {
    await hooks?.dispose();
    process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE = normalTimeoutScale;
    for (const pid of pids) {
      try {
        process.kill(pid, "SIGKILL");
      } catch {
        // Unload already stopped it.
      }
    }
    removeRecorder();
    fs.rmSync(pidDir, { recursive: true, force: true });
  }
});

await check("a hung recorder is stopped by its watchdog without unload", async () => {
  clearLog();
  const pidDir = fs.mkdtempSync(path.join(root, "watchdog-recorder-"));
  // A shell recorder publishes its PID within milliseconds, well inside the
  // shortened watchdog even on a loaded runner; `exec` keeps that PID.
  fs.writeFileSync(
    recorderPath,
    `#!/bin/sh\nprintf '%s' "$$" >${JSON.stringify(pidDir)}/"$$"\nexec sleep 60\n`,
    { mode: 0o755 },
  );
  // A small scale makes the 10s watchdog fire after 2s. Only an unguarded tool
  // runs, so no guard hook is subject to the shortened budget.
  const normalTimeoutScale = process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE;
  process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE = "0.2";
  let hooks;
  let pids = [];
  try {
    hooks = await plugin();
    await hooks["tool.execute.before"](
      { tool: "read", sessionID: "audit-watchdog", callID: "audit-watchdog-call" },
      { args: { filePath: "a.txt" } },
    );
    pids = await waitForPids(pidDir, 1);
    for (const pid of pids) await waitForProcessExit(pid, "watchdog recorder");
  } finally {
    process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE = normalTimeoutScale;
    await hooks?.dispose();
    for (const pid of pids) {
      try {
        process.kill(pid, "SIGKILL");
      } catch {
        // The watchdog already stopped it.
      }
    }
    removeRecorder();
    fs.rmSync(pidDir, { recursive: true, force: true });
  }
});

await check("a failing recorder cannot change tool results or decisions", async () => {
  clearLog();
  installRecorder({ mode: "fail" });
  const savedConsoleError = console.error;
  const errors = [];
  console.error = (...args) => errors.push(args.join(" "));
  let hooks;
  try {
    hooks = await plugin();
    const call = { tool: "bash", sessionID: "audit-fail", callID: "audit-fail-call" };
    const args = { command: "echo kept" };
    const decision = { args };
    await hooks["tool.execute.before"](call, decision);
    assert.equal(decision.decision, undefined);
    const output = { title: "echo", output: "original", metadata: { exit: 0 } };
    await hooks["tool.execute.after"]({ ...call, args }, output);
    assert.equal(output.output, "original");

    behavior("agent-hook-pre-bash", { exit: 2, stderr: "guard denial" });
    const denied = { args: { command: "danger" } };
    await assert.rejects(
      hooks["tool.execute.before"](
        { tool: "bash", sessionID: "audit-fail", callID: "audit-fail-denied" },
        denied,
      ),
      /guard denial/,
    );
    assert.equal(denied.reason, "guard denial");

    // The fixture logs before failing, which proves it really ran.
    await waitForAudit("audit-fail", "PostToolUse");
    await waitForAudit("audit-fail", "PreToolUse", (payload) => payload.tool_use_id === "audit-fail-denied");
    await hooks.dispose();
    hooks = undefined;
    assert.deepEqual(errors, []);
  } finally {
    console.error = savedConsoleError;
    clearBehavior("agent-hook-pre-bash");
    await hooks?.dispose();
    removeRecorder();
  }
});

await check("a recorder that exits before reading a large payload is harmless", async () => {
  clearLog();
  const pidDir = fs.mkdtempSync(path.join(root, "early-recorder-"));
  installRecorder({ mode: "early-exit", pidDir });
  let hooks;
  try {
    hooks = await plugin();
    const call = { tool: "read", sessionID: "audit-epipe", callID: "audit-epipe-call" };
    const args = { filePath: "big.txt" };
    const body = "y".repeat(4 * 1024 * 1024);
    const output = { title: "big.txt", output: body, metadata: {} };
    await hooks["tool.execute.before"](call, { args });
    await hooks["tool.execute.after"]({ ...call, args }, output);
    assert.equal(output.output, body);
    // Wait for the recorders to exit so the parent's EPIPE, which would kill
    // this process without a listener, has occurred before the case passes.
    for (const pid of await waitForPids(pidDir, 2)) {
      await waitForProcessExit(pid, "early-exit recorder");
    }
    await hooks.dispose();
    hooks = undefined;
  } finally {
    await hooks?.dispose();
    removeRecorder();
    fs.rmSync(pidDir, { recursive: true, force: true });
  }
});

await check("a missing recorder is silent", async () => {
  clearLog();
  removeRecorder();
  // PATH holds only a node link: the fixture hooks still need `env node`, while
  // no agent-hook-telemetry can resolve from HOME or PATH.
  const nodeOnly = fs.mkdtempSync(path.join(root, "node-only-"));
  fs.symlinkSync(process.execPath, path.join(nodeOnly, "node"));
  const savedConsoleError = console.error;
  const savedPath = process.env.PATH;
  const errors = [];
  console.error = (...args) => errors.push(args.join(" "));
  process.env.PATH = nodeOnly;
  let hooks;
  try {
    hooks = await plugin();
    const sessionID = "audit-missing";
    await hooks["chat.message"](
      { sessionID, agent: "build" },
      { message: {}, parts: [{ type: "text", text: "hello" }] },
    );
    // A guarded call proves the absence never reaches the fail-closed path.
    const call = { tool: "bash", sessionID, callID: "audit-missing-call" };
    const args = { command: "echo body" };
    const decision = { args };
    await hooks["tool.execute.before"](call, decision);
    assert.equal(decision.decision, undefined);
    const output = { title: "echo", output: "body", metadata: { exit: 0 } };
    await hooks["tool.execute.after"]({ ...call, args }, output);
    void hooks.event({ event: { type: "session.idle", properties: { sessionID } } });
    void hooks.event({ event: { type: "session.deleted", properties: { info: { id: sessionID } } } });
    await hooks.dispose();
    hooks = undefined;
    assert.equal(output.output, "body");
    assert.deepEqual(errors, []);
    assert.ok(logs().some((record) => record.hook === "agent-hook-session-end"));
  } finally {
    console.error = savedConsoleError;
    process.env.PATH = savedPath;
    await hooks?.dispose();
    fs.rmSync(nodeOnly, { recursive: true, force: true });
  }
});


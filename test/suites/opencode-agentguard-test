    await host.registered.get("session.prompt")({ sessionID, prompt: { text: "task" } });
    const error = { type: "provider", message: "rate limited" };
    messages.push(
      { type: "session.compaction.started", data: { sessionID, reason: "auto", recent: "m1" } },
      { type: "session.compaction.ended", data: { sessionID, reason: "auto", text: "summary", recent: "m1" } },
      { type: "session.execution.failed", data: { sessionID, error } },
    );
    publish();

    const started = await waitForAudit(sessionID, "PreCompact");
    assert.equal(started.payload.trigger, "auto");
    const ended = await waitForAudit(sessionID, "PostCompact");
    assert.equal(ended.payload.compact_summary, "summary");
    const failure = await waitForAudit(sessionID, "StopFailure");
    assert.deepEqual(failure.payload.error, error);
  } finally {

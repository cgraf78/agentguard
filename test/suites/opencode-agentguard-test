await check("does not claim terminal errors from another session", async () => {
  clearLog();
  const hooks = await plugin({ mcp: { docs: { type: "local" } } });
  const input = { query: "session ownership" };
  const call = { tool: "docs_lookup", sessionID: "owning-session", callID: "owned-call" };
  await hooks["tool.execute.before"](call, { args: input });
  void hooks.event({
    event: toolErrorEvent({
      ...call,
      sessionID: "other-session",
      input,
      error: "unrelated terminal error",
    }),
  });
  await hooks["tool.execute.after"](
    { ...call, args: input },
    { output: "owned result", isError: true, metadata: {} },

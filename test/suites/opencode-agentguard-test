    await hooks["chat.message"]({ sessionID: parent, agent: "build" }, say("delegate"));
    void hooks.event({
      event: { type: "session.created", properties: { info: { id: child, parentID: parent } } },
    });
    await hooks["chat.message"]({ sessionID: child, agent: "general" }, say("do the task"));
    const call = { tool: "bash", sessionID: child, callID: "audit-child-call" };
    const args = { command: "echo sub" };
    await hooks["tool.execute.before"](call, { args });
    await hooks["tool.execute.after"]({ ...call, args }, { title: "echo", output: "sub\n", metadata: { exit: 0 } });
    const shell = { env: {} };
    await hooks["shell.env"]({ sessionID: child }, shell);
    void hooks.event({ event: { type: "session.idle", properties: { sessionID: child } } });
    void hooks.event({ event: { type: "session.deleted", properties: { info: { id: child } } } });

    const start = await waitForAudit(parent, "SubagentStart");
    assert.equal(start.payload.agent_id, child);
    assert.equal(start.payload.agent_type, "general");
    assert.equal(start.payload.prompt, "do the task");

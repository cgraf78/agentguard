// A separate host process that records one tool call and then simply returns:
// nothing awaits the unref'd recorder, so its event loop drains and it exits
// without ever calling dispose. With a hold, it first waits until the recorder
// and its helper exist and the recorder is older than the exit grace (500ms
// at the suite's timeout scale), as a hung recorder would be.
async function runExitingHost(sessionID, { holdMs = 0, pidDir, grandchildDir } = {}) {
  const hostScript = path.join(root, "exiting-host.mjs");
  fs.writeFileSync(
    hostScript,
    `import fs from "node:fs";
import { pathToFileURL } from "node:url";
const [pluginPath, directory, sessionID, holdMs, pidDir, grandchildDir] = process.argv.slice(2);
const started = Date.now();
const { AgentGuardPlugin } = await import(pathToFileURL(pluginPath).href);
const hooks = await AgentGuardPlugin({ directory });
await hooks["tool.execute.before"](
  { tool: "read", sessionID, callID: sessionID + "-call" },
  { args: { filePath: "a.txt" } },
);
if (Number(holdMs) > 0) {
  const deadline = Date.now() + 5_000;
  while (fs.readdirSync(pidDir).length === 0 || fs.readdirSync(grandchildDir).length === 0) {
    if (Date.now() > deadline) throw new Error("recorder never started");
    await new Promise((resolve) => setTimeout(resolve, 10));
  }
  while (Date.now() - started < Number(holdMs)) {
    await new Promise((resolve) => setTimeout(resolve, 10));
  }
}
`,
  );
  try {
    const host = spawn(
      process.execPath,
      [hostScript, pluginPath, sourceDirectory, sessionID, String(holdMs), pidDir ?? "", grandchildDir ?? ""],
      { stdio: ["ignore", "ignore", "pipe"] },
    );
    let stderr = "";
    host.stderr.on("data", (chunk) => {
      stderr += chunk;
    });
    const code = await new Promise((resolve, reject) => {
      const timer = setTimeout(() => {
        host.kill("SIGKILL");
        reject(new Error(`host did not exit; stderr: ${stderr}`));
      }, 10_000);
      host.once("exit", (status) => {
        clearTimeout(timer);
        resolve(status);
      });
    });
    assert.equal(code, 0, stderr);
  } finally {
    fs.rmSync(hostScript, { force: true });
  }
}

await check("a host exiting without unload stops a hung recorder and its helpers", async () => {
  clearLog();
  const pidDir = fs.mkdtempSync(path.join(root, "exit-recorder-"));
  const grandchildDir = fs.mkdtempSync(path.join(root, "exit-helper-"));
  installRecorder({ mode: "hang", pidDir, grandchildDir });
  let pids = [];
  try {
    // The hold puts the recorder past the exit grace with a wide margin.
    await runExitingHost("audit-exit", { holdMs: 1_500, pidDir, grandchildDir });
    pids = [...pidsIn(pidDir), ...pidsIn(grandchildDir)];
    assert.equal(pids.length, 2);
    for (const pid of pids) await waitForProcessExit(pid, "recorder outliving its host");
  } finally {
    for (const pid of pids) {
      try {
        process.kill(pid, "SIGKILL");
      } catch {
        // The host's exit handler already stopped it.
      }
    }
    removeRecorder();
    fs.rmSync(pidDir, { recursive: true, force: true });
    fs.rmSync(grandchildDir, { recursive: true, force: true });
  }
});


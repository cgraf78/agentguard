await check("isolates timeout cleanup from project modules and PATH", async () => {
  clearLog();
  const siteMarker = path.join(root, "cleanup-sitecustomize-ran");
  const subprocessMarker = path.join(root, "cleanup-subprocess-ran");
  const pathPythonMarker = path.join(root, "cleanup-path-python-ran");
  const pathPsMarker = path.join(root, "cleanup-path-ps-ran");
  const sitecustomize = path.join(sourceDirectory, "sitecustomize.py");
  const subprocessModule = path.join(sourceDirectory, "subprocess.py");
  const cleanupBin = path.join(sourceDirectory, "cleanup-bin");
  const descendantPidFile = path.join(root, "cleanup-descendant-pid");
  const realPython = process.env.AGENTGUARD_TEST_REAL_PYTHON;
  const realPs = process.env.AGENTGUARD_TEST_REAL_PS;
  const savedPath = process.env.PATH;
  assert.equal(typeof realPython === "string" && path.isAbsolute(realPython), true);
  assert.equal(typeof realPs === "string" && path.isAbsolute(realPs), true);
  fs.writeFileSync(
    sitecustomize,
    `from pathlib import Path\nPath(${JSON.stringify(siteMarker)}).write_text("ran")\n`,
  );
  fs.writeFileSync(
    subprocessModule,
    `from pathlib import Path\nPath(${JSON.stringify(subprocessMarker)}).write_text("ran")\nraise RuntimeError("project subprocess imported")\n`,
  );
  fs.mkdirSync(cleanupBin);
  fs.writeFileSync(
    path.join(cleanupBin, "python3"),
    `#!/bin/sh\nprintf ran >${JSON.stringify(pathPythonMarker)}\nexec ${JSON.stringify(realPython)} "$@"\n`,
    { mode: 0o755 },
  );
  fs.writeFileSync(
    path.join(cleanupBin, "ps"),
    `#!/bin/sh\nprintf ran >${JSON.stringify(pathPsMarker)}\nexec ${JSON.stringify(realPs)} "$@"\n`,
    { mode: 0o755 },
  );
  behavior("agent-hook-pre-edit", { delayMs: 20_000, descendantPidFile });
  const normalTimeoutScale = process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE;
  // This case must prove cleanup of a descendant that really started. A 500ms
  // timeout made that premise scheduler-dependent: under the full parallel
  // suite, the hook could be killed before a second Node process published its
  // PID. Give readiness the same five-second budget as ordinary fixtures and
  // leave another five seconds before the hook timeout, then poll the PID file
  // contents instead of guessing when the child is ready.
  process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE = "1";
  process.env.PATH = `${cleanupBin}${path.delimiter}${savedPath}`;
  let hooks;
  let descendantPid;
  try {
    hooks = await plugin();
    const timedOut = assert.rejects(
      hooks["tool.execute.before"](
        { tool: "edit", sessionID: "cleanup-python", callID: "cleanup-python-call" },
        { args: { filePath: "a", oldString: "b", newString: "c" } },
      ),
      /timed out/i,
    );
    // Attach the rejection assertion before polling so a very slow runner
    // cannot turn the expected timeout into an unhandled promise rejection.
    descendantPid = await waitForPidFile(descendantPidFile, "timeout-cleanup descendant");
    await timedOut;
    assert.equal(fs.existsSync(siteMarker), false);
    assert.equal(fs.existsSync(subprocessMarker), false);
    assert.equal(fs.existsSync(pathPythonMarker), false);
    assert.equal(fs.existsSync(pathPsMarker), false);
    await waitForProcessExit(descendantPid, "timeout-cleanup descendant");
  } finally {
    if (descendantPid) {
      try {
        process.kill(descendantPid, "SIGKILL");
      } catch {
        // The expected cleanup path already removed it.
      }
    }
    await hooks?.dispose();
    process.env.PATH = savedPath;
    process.env.AGENTGUARD_OPENCODE_TIMEOUT_SCALE = normalTimeoutScale;
    clearBehavior("agent-hook-pre-edit");
    fs.rmSync(sitecustomize, { force: true });
    fs.rmSync(subprocessModule, { force: true });
    fs.rmSync(cleanupBin, { recursive: true, force: true });
    fs.rmSync(descendantPidFile, { force: true });
  }
});


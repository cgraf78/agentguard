      audits(parent)
        .filter((record) => record.payload.agent_id === child)
        .map((record) => record.payload.hook_event_name)
        .filter((name) => !["PreToolUse", "PostToolUse"].includes(name)),
      ["SubagentStart", "SubagentStop"],
    );
    // Tool guards and the shell share the parent's session, as Claude's do.
    const guard = logs().find((record) => record.hook === "agent-hook-pre-bash");
    assert.equal(guard.session, parent);
    assert.equal(guard.payload.session_id, parent);
    assert.equal(guard.payload.agent_id, child);
    assert.equal(shell.env.AGENTGUARD_SESSION_ID, parent);
    // Lifecycle guards keep the child's own session so its start and end can
    // never initialize or clean up the parent's state.
    assert.ok(
      logs().some((record) => record.hook === "agent-hook-session-start" && record.session === child),
    );
  } finally {
    await hooks?.dispose();
    removeRecorder();
  }
});


echo "=== perf-char: process-snapshot determinism ==="

_snapshot_keys_twice() {
  env -u AGENTGUARD_NAME -u AGENTGUARD_SESSION_ID -u AGENT \
    -u CODEX_THREAD_ID -u CODEX_INTERNAL_ORIGINATOR_OVERRIDE \
    -u GEMINI_PROJECT_DIR -u GROK_SESSION_ID \
    -u CLAUDE_CODE_CURRENT_SESSION_ID -u CLAUDE_CODE_SESSION_ID \
    -u MUSE_SESSION_ID AGENTGUARD_PROCESS_DETECT=1 \
    bash -c '
    source "$1"
    first=$(_hook_agent_ancestor_key 2>/dev/null || echo "none")
    second=$(_hook_agent_ancestor_key 2>/dev/null || echo "none")
    printf "%s || %s" "$first" "$second"
  ' _ "$HELPERS"
}
ancestor_pair=$(_snapshot_keys_twice)
case "$ancestor_pair" in
  *" || "*) ;;
  *) _fail "snapshot: ancestor key helper produced no pair" ;;
esac
if [ "${ancestor_pair%% || *}" = "${ancestor_pair##* || }" ]; then
  _pass "snapshot: repeated ancestor resolution is stable"
else
  _fail "snapshot: ancestor key changed between calls ($ancestor_pair)"
fi

_tree_name_twice() {
  env -u AGENTGUARD_NAME -u AGENTGUARD_SESSION_ID -u AGENT \
    -u CODEX_THREAD_ID -u CODEX_INTERNAL_ORIGINATOR_OVERRIDE \
    -u GEMINI_PROJECT_DIR -u GROK_SESSION_ID \
    -u CLAUDE_CODE_CURRENT_SESSION_ID -u CLAUDE_CODE_SESSION_ID \
    -u MUSE_SESSION_ID AGENTGUARD_PROCESS_DETECT=1 \
    bash -c '
    source "$1"
    first=$(_agent_name_from_process_tree 2>/dev/null || echo "none")
    second=$(_agent_name_from_process_tree 2>/dev/null || echo "none")
    printf "%s || %s" "$first" "$second"
  ' _ "$DETECT"
}
tree_pair=$(_tree_name_twice)
if [ "${tree_pair%% || *}" = "${tree_pair##* || }" ]; then
  _pass "snapshot: repeated process-tree detection is stable"
else
  _fail "snapshot: process-tree detection changed between calls ($tree_pair)"
fi


_bash_case() {
  # $1: command, $2: expected exit, $3: expected stderr fragment (or empty).
  local cmd="$1" expected_exit="$2" expected_err="$3" input
  input=$(jq -cn --arg command "$cmd" '{tool_input:{command:$command}}')
  _run_hook "$PRE_BASH" "$input"
  _assert_exit "bash guard: [$cmd] exits $expected_exit" "$expected_exit" "$HOOK_EXIT"
  if [ -n "$expected_err" ]; then
    _assert_contains "bash guard: [$cmd] message" "$expected_err" "$HOOK_STDERR"
  fi
}


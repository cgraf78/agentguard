#!/usr/bin/env bash
# agent-hook-fuzz-test — property test for the guard hooks' exit contract.
#
# Hosts block only on exit 2 and run the tool on any other status, so a guard
# hook must answer every payload with 0 (allow) or 2 (block), promptly. The
# stronger property checked here is that AgentGuard never even reaches its
# internal-error path on these inputs: fail-closed is the safety net, not the
# expected outcome. Inputs mix shell syntax, variable indirection, odd
# quoting, Unicode, control characters, NULs, and oversized commands.
#
# AGENTGUARD_FUZZ_SEED and AGENTGUARD_FUZZ_COUNT reproduce or widen a run.

# shellcheck disable=SC1003,SC1090,SC1091,SC2016 # dynamic helper path; literal shell text.
AGENTGUARD_TEST_HELPERS="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/agent-hook-helpers.sh"
. "$AGENTGUARD_TEST_HELPERS"
_mock_protected_bare_git_home

_fuzz_seed="${AGENTGUARD_FUZZ_SEED:-20261008}"
_fuzz_count="${AGENTGUARD_FUZZ_COUNT:-40}"
# Per-run wall clock. Generous for loaded CI hosts, far below host hook
# timeouts; the hook's own classification budget is set lower so oversized
# inputs exercise the deadline path instead of the harness timeout.
_fuzz_wall=90
_fuzz_failures=0
RANDOM="$_fuzz_seed"

_fuzz_atoms=(
  'git' 'push' '--force' '-f' '+main' 'reset' '--hard' 'status' '-uall' 'add' '-A'
  'clean' '-fd' 'stash' '-u' 'rm' '-rf' '/' '~' '$HOME' 'sudo' 'noglob' 'nocorrect'
  'command' 'builtin' 'exec' 'env' '-i' 'nice' 'nohup' 'timeout' '5' 'xargs'
  'stdbuf' '-oL' 'time' 'cd' 'pushd' 'popd' 'bash' '-c' 'sh' 'eval' 'kill' '-9'
  'chmod' '777' 'find' 'grep' '-r' 'vim' 'tmux' 'gh' 'pr' 'create' 'echo' 'cat'
  'f()' '{' '}' '(' ')' '((' '))' '$(' '`' '${' '${!' '$((' '[[' ']]' '[' ']'
  ';' ';;' '&' '&&' '|' '||' '|&' '>' '>>' '2>&1' '&>' '<' '<<' '<<-' '<<<'
  'EOF' "'" '"' "\$'" '\' '\\' '#' '!' '*' '?' '=' 'a=b' 'g=git' '$g' '${g}'
  '$(touch x)' '${x[$(id)]}' 'a[$(id)]=1' '${!x}' '$@' '$*' '$1' '$?' '$$'
  'case' 'in' 'esac' 'if' 'then' 'fi' 'for' 'do' 'done' 'while' 'function'
  'export' 'unset' 'readonly' 'declare' '-x' 'GIT_DIR=$HOME/.protected-bare-git'
  'GIT_CONFIG_COUNT=99999' '--git-dir' '-C' '..' '.' ':/' '--' '-' '=='
  'é' '中文' '🙂' 'Ω≈ç' $'\t' $'\r' $'\v' $'\f' $'\x01' $'\x1b[0m' $'\xc3' $'\xff'
)
_fuzz_separators=(' ' ' ' ' ' '' $'\n' ';' ' && ' ' | ' '&' $'\t')

_fuzz_command() {
  local length=$((RANDOM % 30 + 1)) out="" n
  for ((n = 0; n < length; n++)); do
    out+="${_fuzz_atoms[RANDOM % ${#_fuzz_atoms[@]}]}"
    out+="${_fuzz_separators[RANDOM % ${#_fuzz_separators[@]}]}"
  done
  printf '%s' "$out"
}

# Run one payload and check the contract. The payload file keeps oversized
# commands out of argv.
# macOS runners lack GNU `timeout`; the wall clock only guards the suite
# against a hung hook, so fall back to `gtimeout` or run unwrapped.
if command -v timeout >/dev/null 2>&1; then
  _fuzz_wall_cmd=(timeout "$_fuzz_wall")
elif command -v gtimeout >/dev/null 2>&1; then
  _fuzz_wall_cmd=(gtimeout "$_fuzz_wall")
else
  _fuzz_wall_cmd=()
fi

_fuzz_check() {
  local desc="$1" hook="$2" payload_file="$3" status out err
  out="$TEST_TMPDIR/fuzz.out"
  err="$TEST_TMPDIR/fuzz.err"
  env AGENTGUARD_SESSION_ID="$TEST_SID" TMPDIR="$TEST_TMPDIR" \
    AGENTGUARD_NAME=claude AGENTGUARD_CLASSIFY_TIMEOUT=5 \
    ${_fuzz_wall_cmd[@]+"${_fuzz_wall_cmd[@]}"} "$hook" <"$payload_file" >"$out" 2>"$err"
  status=$?
  case "$status" in
    0 | 2) ;;
    *)
      _fuzz_failures=$((_fuzz_failures + 1))
      _fail "$desc: exit $status (seed $_fuzz_seed): $(head -c 400 "$err")"
      return
      ;;
  esac
  if grep -q 'AgentGuard internal error' "$err"; then
    _fuzz_failures=$((_fuzz_failures + 1))
    _fail "$desc: internal error path (seed $_fuzz_seed): $(head -c 400 "$err")"
    return
  fi
  if ! jq -e . "$out" >/dev/null 2>&1; then
    _fuzz_failures=$((_fuzz_failures + 1))
    _fail "$desc: response is not JSON (seed $_fuzz_seed)"
  fi
}

_fuzz_payload="$TEST_TMPDIR/fuzz-payload.json"
_fuzz_command_file="$TEST_TMPDIR/fuzz-command.txt"

echo ""
echo "=== fuzz: random shell-ish commands (seed $_fuzz_seed, $_fuzz_count cases) ==="

for ((_fuzz_i = 0; _fuzz_i < _fuzz_count; _fuzz_i++)); do
  _fuzz_command >"$_fuzz_command_file"
  jq -n --rawfile c "$_fuzz_command_file" \
    '{"tool_name":"Bash","tool_input":{"command":$c}}' >"$_fuzz_payload"
  _fuzz_check "random command $_fuzz_i" "$PRE_BASH" "$_fuzz_payload"
done
[ "$_fuzz_failures" -eq 0 ] && _pass "random commands: every exit is allow or block"

echo ""
echo "=== fuzz: NULs and invalid UTF-8 in the payload ==="

printf '%s' '{"tool_name":"Bash","tool_input":{"command":"echo a\u0000b; git push --force"}}' >"$_fuzz_payload"
_fuzz_check "NUL inside command" "$PRE_BASH" "$_fuzz_payload"
printf '{"tool_name":"Bash","tool_input":{"command":"echo \xff\xfe; ls"}}' >"$_fuzz_payload"
_fuzz_check "invalid UTF-8 inside command" "$PRE_BASH" "$_fuzz_payload"
printf '%s' '{"tool_name":"Bash","tool_input":{"command":"\u0000"}}' >"$_fuzz_payload"
_fuzz_check "NUL-only command" "$PRE_BASH" "$_fuzz_payload"
printf '\x00\x01{"tool_input":' >"$_fuzz_payload"
_fuzz_check "binary garbage payload" "$PRE_BASH" "$_fuzz_payload"

echo ""
echo "=== fuzz: oversized commands are bounded ==="

_fuzz_big() {
  local unit="$1" count="$2" n
  {
    for ((n = 0; n < count; n++)); do printf '%s' "$unit"; done
  } >"$_fuzz_command_file"
  jq -n --rawfile c "$_fuzz_command_file" \
    '{"tool_name":"Bash","tool_input":{"command":$c}}' >"$_fuzz_payload"
}

_fuzz_big 'true; ' 20000
_fuzz_check "20000 sequential commands" "$PRE_BASH" "$_fuzz_payload"
_fuzz_big "rm -rf a b c d e f g h ; " 3000
_fuzz_check "long rm lists" "$PRE_BASH" "$_fuzz_payload"
_fuzz_big 'a ' 3000
printf 'rm -rf ' >"$_fuzz_command_file.tmp"
cat "$_fuzz_command_file" >>"$_fuzz_command_file.tmp"
jq -n --rawfile c "$_fuzz_command_file.tmp" \
  '{"tool_name":"Bash","tool_input":{"command":$c}}' >"$_fuzz_payload"
_fuzz_check "one command with 3000 words" "$PRE_BASH" "$_fuzz_payload"
_fuzz_big "\"'\$(\`" 30000
_fuzz_check "unbalanced quote soup" "$PRE_BASH" "$_fuzz_payload"
_fuzz_big $'echo $(echo "x\n' 4000
_fuzz_check "many open substitutions across lines" "$PRE_BASH" "$_fuzz_payload"
_fuzz_big '""' 60000
printf 'echo ' | cat - "$_fuzz_command_file" >"$_fuzz_command_file.tmp"
jq -n --rawfile c "$_fuzz_command_file.tmp" \
  '{"tool_name":"Bash","tool_input":{"command":$c}}' >"$_fuzz_payload"
_fuzz_check "one word of empty quotes" "$PRE_BASH" "$_fuzz_payload"
_fuzz_big 'x' 1100000
_fuzz_check "single huge word" "$PRE_BASH" "$_fuzz_payload"
_fuzz_big 'x;' 200000
_fuzz_check "command over the size limit" "$PRE_BASH" "$_fuzz_payload"
_fuzz_big '(' 50000
_fuzz_check "deep parentheses" "$PRE_BASH" "$_fuzz_payload"
[ "$_fuzz_failures" -eq 0 ] && _pass "oversized commands: every exit is allow or block"

echo ""
echo "=== fuzz: other guard hooks ==="

for ((_fuzz_i = 0; _fuzz_i < 20; _fuzz_i++)); do
  _fuzz_command >"$_fuzz_command_file"
  jq -n --rawfile p "$_fuzz_command_file" \
    '{"tool_name":"Edit","tool_input":{"file_path":$p,"edits":[{"file_path":$p}]}}' >"$_fuzz_payload"
  _fuzz_check "random edit path $_fuzz_i" "$PRE_EDIT" "$_fuzz_payload"
  jq -n --rawfile p "$_fuzz_command_file" \
    '{"tool_name":("mcp__" + $p + "__x"),"tool_input":{"path":$p}}' >"$_fuzz_payload"
  _fuzz_check "random mcp name $_fuzz_i" "$PRE_MCP" "$_fuzz_payload"
  jq -n --rawfile p "$_fuzz_command_file" \
    '{"tool_name":"Grep","tool_input":{"pattern":$p}}' >"$_fuzz_payload"
  _fuzz_check "random search pattern $_fuzz_i" "$PRE_SEARCH" "$_fuzz_payload"
done
[ "$_fuzz_failures" -eq 0 ] && _pass "other guard hooks: every exit is allow or block"

_test_summary

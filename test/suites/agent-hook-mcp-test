#!/usr/bin/env bash
# agent-hook-mcp-test — MCP hook behavior.

# shellcheck disable=SC1090,SC1091 # dynamic helper path resolved at runtime.
AGENTGUARD_TEST_HELPERS="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/agent-hook-helpers.sh"
. "$AGENTGUARD_TEST_HELPERS"

# ---------------------------------------------------------------------------
# Tests: agent-hook-pre-mcp — circuit breaker
# ---------------------------------------------------------------------------

echo ""
echo "=== pre-mcp: circuit breaker ==="

# No fail file → passes
_reset_state
_run_hook "$PRE_MCP" '{"tool_name":"mcp__srv__tool","tool_input":{}}'
_assert_eq "no failures: exit 0" "0" "$HOOK_EXIT"
_assert_eq "no failures: no stderr" "" "$HOOK_STDERR"

# 2 failures → still passes
_reset_state
mkdir -p "$TEST_TMPDIR/agentguard/hook-state/$TEST_SID"
echo 2 >"$TEST_TMPDIR/agentguard/hook-state/$TEST_SID/mcp-failures-srv"
_run_hook "$PRE_MCP" '{"tool_name":"mcp__srv__tool","tool_input":{}}'
_assert_eq "2 failures: exit 0" "0" "$HOOK_EXIT"

# 3 failures → blocks
echo 3 >"$TEST_TMPDIR/agentguard/hook-state/$TEST_SID/mcp-failures-srv"
_run_hook "$PRE_MCP" '{"tool_name":"mcp__srv__tool","tool_input":{}}'
_assert_eq "3 failures: exit 2" "2" "$HOOK_EXIT"
_assert_contains "3 failures: BLOCKED msg" "BLOCKED" "$HOOK_STDERR"

# 5 failures → still blocks
echo 5 >"$TEST_TMPDIR/agentguard/hook-state/$TEST_SID/mcp-failures-srv"
_run_hook "$PRE_MCP" '{"tool_name":"mcp__srv__tool","tool_input":{}}'
_assert_eq "5 failures: exit 2" "2" "$HOOK_EXIT"

# Empty fail file → does not crash (treated as 0)
: >"$TEST_TMPDIR/agentguard/hook-state/$TEST_SID/mcp-failures-srv"
_run_hook "$PRE_MCP" '{"tool_name":"mcp__srv__tool","tool_input":{}}'
_assert_eq "empty file: exit 0" "0" "$HOOK_EXIT"
_assert_not_contains "empty file: no error" "integer expression" "$HOOK_STDERR"

# Non-numeric fail file → does not crash
echo "garbage" >"$TEST_TMPDIR/agentguard/hook-state/$TEST_SID/mcp-failures-srv"
_run_hook "$PRE_MCP" '{"tool_name":"mcp__srv__tool","tool_input":{}}'
_assert_eq "garbage file: exit 0" "0" "$HOOK_EXIT"

# ---------------------------------------------------------------------------
# Tests: agent-hook-pre-mcp — half-open breaker cooldown
# ---------------------------------------------------------------------------

echo ""
echo "=== pre-mcp: half-open breaker ==="

MCP_FAIL_FILE="$TEST_TMPDIR/agentguard/hook-state/$TEST_SID/mcp-failures-srv"
MCP_CALL='{"tool_name":"mcp__srv__tool","tool_input":{}}'

# Write a breaker record: count $1, stamped $2 seconds ago.
_mcp_record() {
  mkdir -p "${MCP_FAIL_FILE%/*}"
  printf '%s\n%s\n' "$1" "$(($(date +%s) - $2))" >"$MCP_FAIL_FILE"
}

_mcp_record_line() {
  sed -n "${1}p" "$MCP_FAIL_FILE" 2>/dev/null
}

# The retry delay the block message reports, in seconds.
_mcp_wait() {
  printf '%s' "$HOOK_STDERR" | sed -n 's/.*one retry is allowed in \([0-9]*\)s.*/\1/p'
}

_assert_wait_between() {
  local name="$1" low="$2" high="$3" wait
  wait=$(_mcp_wait)
  if [ -n "$wait" ] && [ "$wait" -ge "$low" ] && [ "$wait" -le "$high" ]; then
    _pass "$name"
  else
    _fail "$name (wait '$wait' not in [$low, $high]; stderr: $HOOK_STDERR)"
  fi
}

# Within the cooldown: blocked, with the time until the retry and a hint that
# the failures may be the caller's arguments.
_reset_state
_mcp_record 3 20
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "within cooldown: blocked" "2" "$HOOK_EXIT"
_assert_wait_between "within cooldown: reports remaining seconds" 33 41
_assert_contains "within cooldown: names bad arguments" "bad arguments" "$HOOK_STDERR"
_assert_contains "within cooldown: points at the error text" "error text" "$HOOK_STDERR"
_assert_not_contains "within cooldown: does not claim the server is down" "appears to be down" "$HOOK_STDERR"
_assert_eq "within cooldown: count kept" "3" "$(_mcp_record_line 1)"

# Past the cooldown: one probe goes through and re-stamps the record, so a
# second call right after it waits a full cooldown again.
_reset_state
_mcp_record 3 61
before=$(date +%s)
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "after cooldown: probe allowed" "0" "$HOOK_EXIT"
_assert_not_contains "after cooldown: probe not blocked" "BLOCKED" "$HOOK_STDERR"
_assert_eq "after cooldown: probe keeps count" "3" "$(_mcp_record_line 1)"
stamp=$(_mcp_record_line 2)
if [ -n "$stamp" ] && [ "$stamp" -ge "$before" ]; then
  _pass "after cooldown: probe re-stamps record"
else
  _fail "after cooldown: probe re-stamps record (stamp '$stamp' < $before)"
fi
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "after probe: next call blocked" "2" "$HOOK_EXIT"
_assert_wait_between "after probe: full cooldown again" 53 60

# A successful probe closes the breaker.
_reset_state
_mcp_record 3 61
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "probe success: probe allowed" "0" "$HOOK_EXIT"
_run_hook "$POST_MCP" '{"tool_name":"mcp__srv__tool","tool_result_is_error":false}'
_assert_file_missing "probe success: record removed" "$MCP_FAIL_FILE"
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "probe success: later calls pass" "0" "$HOOK_EXIT"

# A failed probe re-opens it for a full cooldown.
_reset_state
_mcp_record 3 61
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "probe failure: probe allowed" "0" "$HOOK_EXIT"
_run_hook "$POST_MCP" '{"tool_name":"mcp__srv__tool","tool_result_is_error":true}'
_assert_eq "probe failure: count incremented" "4" "$(_mcp_record_line 1)"
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "probe failure: blocked again" "2" "$HOOK_EXIT"
_assert_wait_between "probe failure: full cooldown" 53 60

# A count-only record (older AgentGuard) starts its cooldown at first sight
# instead of blocking forever or letting the call through.
_reset_state
mkdir -p "${MCP_FAIL_FILE%/*}"
echo 3 >"$MCP_FAIL_FILE"
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "count-only record: blocked" "2" "$HOOK_EXIT"
_assert_wait_between "count-only record: full cooldown" 54 60
stamp=$(_mcp_record_line 2)
case "$stamp" in
  '' | *[!0-9]*) _fail "count-only record: stamped (line 2 '$stamp')" ;;
  *) _pass "count-only record: stamped" ;;
esac

# A stamp in the future (the clock went backwards) restarts the cooldown now
# rather than holding the breaker open until the clock catches up.
_reset_state
_mcp_record 3 -7200
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "future stamp: blocked" "2" "$HOOK_EXIT"
_assert_wait_between "future stamp: full cooldown, not hours" 54 60
stamp=$(_mcp_record_line 2)
if [ -n "$stamp" ] && [ "$stamp" -le "$(date +%s)" ]; then
  _pass "future stamp: re-stamped now"
else
  _fail "future stamp: re-stamped now (stamp '$stamp')"
fi

# Corrupt records never raise an arithmetic error (which would fail the hook
# closed on every later call), and a bad stamp gets a fresh cooldown.
_reset_state
mkdir -p "${MCP_FAIL_FILE%/*}"
printf '3\n0999\n' >"$MCP_FAIL_FILE"
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "leading-zero epoch: read as decimal, probe allowed" "0" "$HOOK_EXIT"
_assert_not_contains "leading-zero epoch: no internal error" "internal error" "$HOOK_STDERR"

_reset_state
mkdir -p "${MCP_FAIL_FILE%/*}"
printf '3\n99999999999999999999\n' >"$MCP_FAIL_FILE"
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "overlong epoch: blocked" "2" "$HOOK_EXIT"
_assert_wait_between "overlong epoch: cooldown starts now" 54 60
_assert_not_contains "overlong epoch: no internal error" "internal error" "$HOOK_STDERR"

_reset_state
mkdir -p "${MCP_FAIL_FILE%/*}"
printf '3\nsoon\n' >"$MCP_FAIL_FILE"
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "garbage epoch: blocked" "2" "$HOOK_EXIT"
_assert_wait_between "garbage epoch: cooldown starts now" 54 60

_reset_state
mkdir -p "${MCP_FAIL_FILE%/*}"
printf '08\n%s\n' "$(date +%s)" >"$MCP_FAIL_FILE"
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "leading-zero count: read as decimal" "2" "$HOOK_EXIT"
_assert_not_contains "leading-zero count: no internal error" "internal error" "$HOOK_STDERR"
_run_hook "$POST_MCP" '{"tool_name":"mcp__srv__tool","tool_result_is_error":true}'
_assert_eq "leading-zero count: post-mcp increments" "9" "$(_mcp_record_line 1)"

_reset_state
mkdir -p "${MCP_FAIL_FILE%/*}"
printf '99999999999999999999\n%s\n' "$(date +%s)" >"$MCP_FAIL_FILE"
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_not_contains "overlong count: no internal error" "internal error" "$HOOK_STDERR"

# The block names the last failing tool and the start of its error, which
# usually says whether the arguments or the server are at fault.
_reset_state
_run_hook "$POST_MCP" '{"tool_name":"mcp__srv__search","tool_result_is_error":true}'
_run_hook "$POST_MCP" '{"tool_name":"mcp__srv__search","tool_result_is_error":true}'
_mcp_error_payload=$(jq -nc --arg e "tool failed: '/tmp/x' is not in the subpath of '/repo'"$'\n'"second line" \
  '{"tool_name":"mcp__srv__search","hook_event_name":"PostToolUseFailure","error":$e}')
_run_hook "$POST_MCP" "$_mcp_error_payload"
_assert_eq "last failure: tool recorded" "search" "$(_mcp_record_line 3)"
_assert_eq "last failure: error kept on one line" \
  "tool failed: '/tmp/x' is not in the subpath of '/repo' second line" "$(_mcp_record_line 4)"
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "last failure: blocked" "2" "$HOOK_EXIT"
_assert_contains "last failure: names the tool and error" \
  "The last failure was tool 'search': tool failed: '/tmp/x' is not in the subpath" "$HOOK_STDERR"

# Codex reports the error inside the CallToolResult content.
_reset_state
_run_hook "$POST_MCP" '{"tool_name":"mcp__srv__lookup","tool_response":{"isError":true,"content":[{"type":"text","text":"target directory src/x does not exist"}]}}'
_assert_eq "content error: text extracted" "target directory src/x does not exist" "$(_mcp_record_line 4)"

# Long errors are cut to 200 characters.
_reset_state
_mcp_long_error=$(printf 'e%.0s' $(seq 1 500))
_run_hook "$POST_MCP" "$(jq -nc --arg e "$_mcp_long_error" '{"tool_name":"mcp__srv__tool","hook_event_name":"PostToolUseFailure","error":$e}')"
_mcp_kept=$(_mcp_record_line 4)
_assert_eq "long error: cut to 200 characters" "200" "${#_mcp_kept}"

# A probe keeps the last failure in the re-stamped record.
_reset_state
mkdir -p "${MCP_FAIL_FILE%/*}"
printf '3\n%s\nsearch\nbad path\n' "$(($(date +%s) - 61))" >"$MCP_FAIL_FILE"
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "probe re-stamp: allowed" "0" "$HOOK_EXIT"
_assert_eq "probe re-stamp: tool kept" "search" "$(_mcp_record_line 3)"
_assert_eq "probe re-stamp: error kept" "bad path" "$(_mcp_record_line 4)"

# After two failed probes (five failures), the block says the server is
# probably down instead of blaming the arguments.
_reset_state
_mcp_record 4 0
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_not_contains "one failed probe: not called down" "probably down" "$HOOK_STDERR"
_mcp_record 5 0
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "two failed probes: blocked" "2" "$HOOK_EXIT"
_assert_contains "two failed probes: probably down" "probably down" "$HOOK_STDERR"
_assert_not_contains "two failed probes: no bad-arguments hint" "bad arguments" "$HOOK_STDERR"

# Below the threshold the cooldown does not apply.
_reset_state
_mcp_record 2 0
_run_hook "$PRE_MCP" "$MCP_CALL"
_assert_eq "2 recent failures: allowed" "0" "$HOOK_EXIT"


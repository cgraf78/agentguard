#!/usr/bin/env bash
# Verify that human-facing PATH commands have manual pages.

set -o pipefail
export NO_COLOR=1

AGENTGUARD_TEST_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
AGENTGUARD_REPO_ROOT="$(cd -- "$AGENTGUARD_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$AGENTGUARD_TEST_DIR/helpers.sh"

echo "=== agentguard: manpages ==="

_check_manpages() {
  local inventory="$_TEST_TMP_ROOT/manpage-paths" file command page content found=0

  _test_checkout_files "$AGENTGUARD_REPO_ROOT" 'bin/*' >"$inventory" || return
  while IFS= read -r -d '' file; do
    command=${file##*/}
    [[ "$command" != README.md ]] || continue
    found=1
    page="$AGENTGUARD_REPO_ROOT/man/man1/$command.1"
    _assert_file_exists "manpage exists: $command" "$page"
    content=$(cat "$page")
    _assert_contains "manpage NAME section: $command" ".SH NAME" "$content"
    _assert_contains "manpage names command: $command" "$command \\" "$content"
  done <"$inventory"
  [[ "$found" == 1 ]]
}

inventory_status=0
inventory_output=$(
  # shellcheck disable=SC2329 # Called by _test_checkout_files.
  git() {
    printf '%s\0' 'bin/agentguard-telemetry'
    return 17
  }
  _check_manpages
) || inventory_status=$?
_assert_eq "propagates failed manpage inventory status" 17 "$inventory_status"
_assert_eq "does not check a partial manpage inventory" "" "$inventory_output"

inventory_status=0
(
  # shellcheck disable=SC2329 # Called by _test_checkout_files.
  git() {
    printf '%s\0' 'bin/README.md'
  }
  _check_manpages
) || inventory_status=$?
_assert_eq "rejects an inventory with only the README" 1 "$inventory_status"

# Exercise command-scoped checkout trust even when the test uid owns the checkout.
GIT_TEST_ASSUME_DIFFERENT_OWNER=1 _check_manpages ||
  _fail "cannot enumerate tracked commands for manpage checks"

echo ""
echo "=== agentguard: launcher security boundary documentation ==="

for relative_path in \
  README.md \
  lib/agentguard/README.md \
  man/man1/agent-hook-pre-bash.1 \
  man/man1/agentguard-classify-command.1; do
  content=$(cat "$AGENTGUARD_REPO_ROOT/$relative_path")
  normalized=$(printf '%s\n' "$content" | tr '\n' ' ' | tr -s ' ')
  _assert_contains "$relative_path: direct execution is the supported boundary" \
    "supported security boundary" "$normalized"
  _assert_contains "$relative_path: explicit interpreters are outside the boundary" \
    "outside this security boundary" "$normalized"
  _assert_contains "$relative_path: detectable rejection is best-effort" \
    "best-effort only" "$normalized"
  _assert_contains "$relative_path: dynamic loader environment must be trusted" \
    "trusted or sanitized dynamic-loader environment" "$normalized"
  _assert_contains "$relative_path: names Linux LD_PRELOAD control" \
    "LD_PRELOAD" "$normalized"
  _assert_contains "$relative_path: names Linux LD_AUDIT control" \
    "LD_AUDIT" "$normalized"
  _assert_contains "$relative_path: names Linux LD_LIBRARY_PATH control" \
    "LD_LIBRARY_PATH" "$normalized"
  _assert_contains "$relative_path: covers other platform loader controls" \
    "platform equivalents" "$normalized"
  _assert_contains "$relative_path: names macOS injected-library control" \
    "DYLD_INSERT_LIBRARIES" "$normalized"
  _assert_contains "$relative_path: names macOS library-path control" \
    "DYLD_LIBRARY_PATH" "$normalized"
  _assert_contains "$relative_path: privileged mode starts after loader code" \
    "cannot protect before Bash loads" "$normalized"
done

_test_summary

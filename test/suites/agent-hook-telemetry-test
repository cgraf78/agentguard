# The MCP circuit breaker trips on every runtime: three failures reported in
# that runtime's native shape, then the next call to the server is blocked.
POST_MCP_HOOK="$BIN_DIR/agent-hook-post-mcp"
_breaker_case() {
  local label="$1" agent="$2" ids="$3" failure="$4" call="$5" i
  for i in 1 2 3; do
    _run_hook_as "$agent" "$ids" "$POST_MCP_HOOK" "$failure"
  done
  _run_hook_as "$agent" "$ids" "$PRE_MCP" "$call"
  _assert_eq "mcp breaker: $label" "2" "$HOOK_EXIT"
}
_fresh_root
_breaker_case "claude PostToolUseFailure" claude "AGENTGUARD_SESSION_ID=brk-claude" \
  '{"session_id":"brk-claude","hook_event_name":"PostToolUseFailure","tool_name":"mcp__down__q","error":"boom"}' \
  '{"session_id":"brk-claude","hook_event_name":"PreToolUse","tool_name":"mcp__down__q","tool_input":{}}'
_breaker_case "muse PostToolUseFailure" muse "MUSE_SESSION_ID=brk-muse AGENTGUARD_SESSION_ID=brk-muse" \
  '{"session_id":"brk-muse","hook_event_name":"PostToolUseFailure","tool_name":"mcp__down__q","error":"boom"}' \
  '{"session_id":"brk-muse","hook_event_name":"PreToolUse","tool_name":"mcp__down__q","tool_input":{}}'
_breaker_case "grok post_tool_use_failure" grok "GROK_SESSION_ID=brk-grok AGENTGUARD_SESSION_ID=brk-grok" \
  '{"sessionId":"brk-grok","hookEventName":"post_tool_use_failure","toolName":"down__q"}' \
  '{"sessionId":"brk-grok","hookEventName":"pre_tool_use","toolName":"down__q","toolInput":{}}'
_breaker_case "codex tool_response.isError" codex "AGENTGUARD_SESSION_ID=brk-codex" \
  '{"session_id":"brk-codex","hook_event_name":"PostToolUse","tool_name":"mcp__down__q","tool_response":{"content":[],"isError":true}}' \
  '{"session_id":"brk-codex","hook_event_name":"PreToolUse","tool_name":"mcp__down__q","tool_input":{}}'
_breaker_case "gemini tool_response.error" gemini "AGENTGUARD_SESSION_ID=gemini-brk" \
  '{"session_id":"brk-gemini","hook_event_name":"AfterTool","tool_name":"mcp_down_q","mcp_context":{"server_name":"down","tool_name":"q"},"tool_response":{"error":{"message":"boom"}}}' \
  '{"session_id":"brk-gemini","hook_event_name":"BeforeTool","tool_name":"mcp_down_q","mcp_context":{"server_name":"down","tool_name":"q"},"tool_input":{}}'
# A successful response must keep resetting the counter: an `error` key in a
# server's own result is not a failure outside Gemini.
_fresh_root
for i in 1 2 3; do
  _run_hook_as codex "AGENTGUARD_SESSION_ID=ok-codex" "$POST_MCP_HOOK" \
    '{"session_id":"ok-codex","hook_event_name":"PostToolUse","tool_name":"mcp__up__q","tool_response":{"content":[],"error":"field in data"}}'
done
_run_hook_as codex "AGENTGUARD_SESSION_ID=ok-codex" "$PRE_MCP" \
  '{"session_id":"ok-codex","hook_event_name":"PreToolUse","tool_name":"mcp__up__q","tool_input":{}}'
_assert_eq "mcp breaker: data error key is not a failure" "0" "$HOOK_EXIT"
# A post hook answering a failure event names that event in its response.
_fresh_root
_run_hook_as claude "AGENTGUARD_SESSION_ID=evt-claude" "$POST_MCP_HOOK" \
  '{"session_id":"evt-claude","hook_event_name":"PostToolUseFailure","tool_name":"mcp__down__q"}'
_assert_eq "post hook on failure: exits 0" "0" "$HOOK_EXIT"
if [ -n "$HOOK_STDOUT" ] && [ "$HOOK_STDOUT" != "{}" ]; then
  _assert_eq "post hook on failure: response names PostToolUseFailure" "PostToolUseFailure" \
    "$(jq -r '.hookSpecificOutput.hookEventName // "PostToolUseFailure"' <<<"$HOOK_STDOUT")"
else
  _pass "post hook on failure: empty response"
fi

_event_name_for() {
  (
    _HOOK_SELF="agent-hook-$1"
    export AGENTGUARD_TELEMETRY=0
    # shellcheck source=../../lib/agentguard/hook-helpers.sh
    . "$BIN_DIR/../lib/agentguard/hook-helpers.sh" </dev/null >/dev/null 2>&1
    # The real path: a hook reads its payload, then the prefiltered refresh.
    _HOOK_INPUT="$2"
    _HOOK_INPUT_STATE_REFRESHED=''
    _hook_refresh_state_dir_for_input
    _hook_event_name
  )
}
_assert_eq "event name: post hook on a failure event" "PostToolUseFailure" \
  "$(_event_name_for post-mcp '{"hook_event_name": "PostToolUseFailure","tool_name":"mcp__a__b"}')"
_assert_eq "event name: post hook on a success event" "PostToolUse" \
  "$(_event_name_for post-mcp '{"hook_event_name":"PostToolUse","tool_name":"mcp__a__b"}')"
_assert_eq "event name: failure text inside the payload is not the event" "PostToolUse" \
  "$(_event_name_for post-bash '{"hook_event_name":"PostToolUse","tool_input":{"command":"echo PostToolUseFailure"}}')"

# Directory names are locale-independent ASCII and fit NAME_MAX even for

# `current` from each runtime's tool shell. Only the fixture ids are visible.
_run_cli_as() {
  local ids="$1"
  shift
  local -a extra=()
  read -ra extra <<<"$ids"
  CLI_EXIT=0
  CLI_OUT=$(env -u XDG_STATE_HOME \
    -u AGENTGUARD_SESSION_ID -u CODEX_THREAD_ID -u GROK_SESSION_ID \
    -u MUSE_SESSION_ID -u GEMINI_SESSION_ID \
    -u CLAUDE_CODE_CURRENT_SESSION_ID -u CLAUDE_CODE_SESSION_ID \
    AGENTGUARD_PROCESS_DETECT=0 HOME="$CLI_HOME" "${extra[@]}" \
    "$TELEMETRY_CLI" "$@" 2>"$TEST_TMPDIR/cli.err") || CLI_EXIT=$?
  CLI_ERR=$(cat "$TEST_TMPDIR/cli.err")
}


  LC_ALL="$utf8_locale" _run_hook_as gemini "AGENTGUARD_SESSION_ID=gemini-4242 LC_ALL=$utf8_locale" "$TELEMETRY_HOOK" \
    "{\"session_id\":\"$cjk_id\",\"hook_event_name\":\"BeforeTool\"}"
  name=$(_entries "$AGENTGUARD_TELEMETRY_DIR/sessions/gemini")
  _assert_eq "utf-8 id: record kept" "1" "$(_dir_records "$AGENTGUARD_TELEMETRY_DIR/sessions/gemini/$name" | wc -l | tr -d ' ')"
  _assert_eq "utf-8 id: ASCII name within 128 bytes" "true" \
    "$(
      LC_ALL=C
      [[ "$name" =~ ^[A-Za-z0-9._:-]{1,128}$ ]] && echo true || echo false

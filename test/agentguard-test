#!/usr/bin/env bash
# Run all repo-owned agentguard test suites.

set -euo pipefail

test_dir="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
root="${test_dir%/test}"

# shellcheck source=test/git-fixture-env.sh
. "$test_dir/git-fixture-env.sh"

# Keep runtime entry points explicit so additions require a lint review.
runtime_shell_files=(
  "$root/bin/agent-hook-compact"
  "$root/bin/agent-hook-notification"
  "$root/bin/agent-hook-permission-request"
  "$root/bin/agent-hook-permission-request-claude"
  "$root/bin/agent-hook-post-bash"
  "$root/bin/agent-hook-post-edit"
  "$root/bin/agent-hook-post-mcp"
  "$root/bin/agent-hook-pre-bash"
  "$root/bin/agent-hook-pre-edit"
  "$root/bin/agent-hook-pre-mcp"
  "$root/bin/agent-hook-pre-search"
  "$root/bin/agent-hook-pre-search-muse"
  "$root/bin/agent-hook-prompt-submit"
  "$root/bin/agent-hook-session-end"
  "$root/bin/agent-hook-session-end-claude"
  "$root/bin/agent-hook-session-start"
  "$root/bin/agent-hook-session-start-claude"
  "$root/bin/agent-hook-stop"
  "$root/bin/agent-hook-telemetry"
  "$root/bin/agentguard-churn-bypass"
  "$root/bin/agentguard-classify-command"
  "$root/bin/agentguard-telemetry"
  "$root/bin/claude-session-name"
  "$root/bin/wait-until"
  "$root/lib/agentguard/agentguard.sh"
  "$root/lib/agentguard/detect.sh"
  "$root/lib/agentguard/hook-command-classifier.sh"
  "$root/lib/agentguard/hook-helpers.sh"
  "$root/lib/agentguard/telemetry.sh"
  "$root/lib/agentguard/watch-github.sh"
  "$root/lib/agentguard/watch.sh"
  "$root/share/agentguard/shell.sh"
  "$root/support/install-checkout.sh"
  "$root/support/script-resolver.sh.template"
  "$root/support/secure-launcher.sh.template"
  "$root/support/sync-hook-bootstrap"
)

example_shell_files=(
  "$root/examples/hooks/agent-hook-pre-bash-work"
)

discover_runtime_shell_files() (
  local inventory file first_line
  if [[ -n "${TMPDIR:-}" ]]; then
    inventory=$(mktemp -- "${TMPDIR%/}/runtime-inventory.XXXXXX") || exit
  else
    inventory=$(mktemp) || exit
  fi
  trap 'rm -f -- "$inventory"' EXIT

  _test_checkout_files "$root" bin lib share support >"$inventory" || exit
  while IFS= read -r -d '' file; do
    case "$file" in
      *.sh | *.sh.template)
        printf '%q\n' "$file"
        continue
        ;;
    esac
    first_line=""
    IFS= read -r first_line <"$root/$file" || true
    if [[ "$first_line" == '#!'*bash* ||
      "$first_line" == '#!'*dash* ||
      "$first_line" == '#!'*ksh* ||
      "$first_line" == '#!'*/sh ||
      "$first_line" == '#!'*'/sh '* ||
      "$first_line" == '#!'*' sh' ||
      "$first_line" == '#!'*' sh '* ||
      "$first_line" == '# shellcheck shell=bash' ||
      "$first_line" == '# shellcheck shell=dash' ||
      "$first_line" == '# shellcheck shell=ksh' ||
      "$first_line" == '# shellcheck shell=sh' ]]; then
      printf '%q\n' "$file"
    fi
  done <"$inventory"
)

check_runtime_shell_inventory() {
  local file listed discovered
  listed=$(
    for file in "$@"; do
      printf '%q\n' "${file#"$root"/}"
    done | LC_ALL=C sort
  )
  discovered=$(discover_runtime_shell_files) || {
    printf 'agentguard-test: cannot enumerate tracked runtime shell files\n' >&2
    return 1
  }
  discovered=$(printf '%s\n' "$discovered" | sed '/^$/d' | LC_ALL=C sort)

  if [[ "$listed" != "$discovered" ]]; then
    printf 'agentguard-test: runtime shell inventory is stale\n' >&2
    diff -u \
      <(printf '%s\n' "$listed") \
      <(printf '%s\n' "$discovered") >&2 || true
    return 1
  fi
}

inventory_status=0
inventory_output=$(
  # shellcheck disable=SC2329 # Called by _test_checkout_files.
  git() {
    printf '%s\0' 'lib/agentguard/agentguard.sh'
    return 17
  }
  discover_runtime_shell_files
) || inventory_status=$?
if [[ "$inventory_status" != 17 || -n "$inventory_output" ]]; then
  printf 'agentguard-test: failed discovery exposed partial runtime inventory (status %s, output %q)\n' \
    "$inventory_status" "$inventory_output" >&2
  exit 1
fi

# A literal newline within one tracked path must never satisfy two entries.
inventory_status=0
inventory_output=$(
  # shellcheck disable=SC2329 # Called by _test_checkout_files.
  git() {
    printf '%s\0' $'lib/agentguard/agentguard.sh\nlib/agentguard/detect.sh'
  }
  check_runtime_shell_inventory \
    "$root/lib/agentguard/agentguard.sh" \
    "$root/lib/agentguard/detect.sh" 2>&1
) || inventory_status=$?
if [[ "$inventory_status" != 1 || "$inventory_output" != *'runtime shell inventory is stale'* ]]; then
  printf 'agentguard-test: runtime inventory did not reject a newline path alias (status %s, output %q)\n' \
    "$inventory_status" "$inventory_output" >&2
  exit 1
fi

# Exercise command-scoped checkout trust even when the test uid owns the checkout.
GIT_TEST_ASSUME_DIFFERENT_OWNER=1 check_runtime_shell_inventory "${runtime_shell_files[@]}"
# Shared CI lints once in its dedicated job; local runs still lint by default.
if [[ "${AGENTGUARD_SKIP_SHELLCHECK:-0}" != 1 ]]; then
  shellcheck -x -P SCRIPTDIR \
    "${runtime_shell_files[@]}" \
    "${example_shell_files[@]}" \
    "$root/install.sh" \
    "$test_dir/agentguard-test" \
    "$test_dir/helpers.sh" \
    "$test_dir/run-suites" \
    "$test_dir"/suites/*-test \
    "$test_dir/suites/agent-hook-helpers.sh"
fi

"$root/support/sync-hook-bootstrap" --check

parallel_suites=()
exclusive_suites=()
for suite in "$test_dir"/suites/*-test; do
  case "${suite##*/}" in
    agent-hook-helpers-test | agent-hook-performance-test | runner-test)
      # Gross hook-latency budgets and signal-cleanup deadlines need a quiet
      # host signal. Running them beside CPU-heavy policy suites would make the
      # aggregate faster by weakening the measurements that protect production
      # hook responsiveness and cleanup behavior.
      exclusive_suites+=("$suite")
      ;;
    *) parallel_suites+=("$suite") ;;
  esac
done

# Run timing and signal-deadline suites before the worker pool so their measured
# signal is not biased by the CPU and writeback residue of peak parallel load.
# The performance suite runs last among them: by then the helpers and runner
# suites have already exercised the host, so its latency medians are taken
# under the residual load its confirmation batches are designed to arbitrate,
# not on the idle machine a CI job only resembles at startup.
for suite in ${exclusive_suites[@]+"${exclusive_suites[@]}"}; do
  case "${suite##*/}" in
    agent-hook-performance-test) continue ;;
    *) "$suite" ;;
  esac
done
for suite in ${exclusive_suites[@]+"${exclusive_suites[@]}"}; do
  case "${suite##*/}" in
    agent-hook-performance-test) "$suite" ;;
  esac
done
"$test_dir/run-suites" ${parallel_suites[@]+"${parallel_suites[@]}"}

printf 'agentguard-test: ok\n'
